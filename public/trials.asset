<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CHOG TRIALS — THE MACHINE · BUILD 25.10.25</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  *{ box-sizing:border-box; }
  html,body{ margin:0; height:100%; overflow:hidden;
             background:radial-gradient(1200px 760px at 50% 30%, #0D0918 0%, #06040C 72%);
             font-family:'Space Grotesk',system-ui,sans-serif; color:#F2EAFF;
             user-select:none; -webkit-user-select:none; }
  #c{ display:block; width:100%; height:100%; }

  /* ---------------- HUD ---------------- */
  #hud{ position:fixed; inset:0; pointer-events:none; opacity:0; transition:opacity .3s; }
  #hud.on{ opacity:1; }

  .bars{ position:absolute; top:14px; left:50%; transform:translateX(-50%);
         display:flex; gap:16px; padding:9px 15px;
         background:rgba(6,4,12,.66); border:1px solid rgba(139,92,246,.20);
         border-radius:10px; backdrop-filter:blur(9px); }
  .barwrap{ width:min(340px,40vw); }
  .bname{ font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:.22em;
          text-transform:uppercase; color:rgba(242,234,255,.5); margin-bottom:6px;
          display:flex; justify-content:space-between; }
  .track{ height:11px; border-radius:3px; background:rgba(6,3,12,.88);
          border:1px solid rgba(139,92,246,.32); overflow:hidden; position:relative; }
  .fill{ position:absolute; inset:0 auto 0 0; width:100%; transition:width .1s linear; }
  #pFill{ background:linear-gradient(90deg,#3FBF5A,#8BF09B); }

  #toast{ position:absolute; top:31%; left:50%; transform:translate(-50%,-50%) scale(.72);
          font-size:clamp(24px,4.6vw,50px); font-weight:700; letter-spacing:.01em;
          opacity:0; transition:opacity .16s, transform .22s cubic-bezier(.2,1.5,.4,1);
          text-shadow:0 4px 26px rgba(0,0,0,.75); white-space:nowrap; }
  #toast.on{ opacity:1; transform:translate(-50%,-50%) scale(1); }

  /* Off-screen boss marker. With a manual camera you can lose the machine
     behind you; this points at it without rotating anything. */
  #bossMark{ position:absolute; width:26px; height:26px; margin:-13px 0 0 -13px;
             display:none; opacity:.9; transition:opacity .15s; }
  #bossMark.on{ display:block; }
  #bossMark svg{ width:100%; height:100%; filter:drop-shadow(0 0 6px rgba(255,61,154,.9)); }

  /* dodge meter: the dash is the core defensive verb now, so its readiness
     has to be readable without looking away from the machine */
  #dashPip{ position:absolute; bottom:74px; left:50%; transform:translateX(-50%);
    display:flex; align-items:center; gap:9px; font-family:'JetBrains Mono',monospace;
    font-size:9px; letter-spacing:.2em; color:rgba(242,234,255,.5); transition:opacity .15s; }
  #dashPip .dp{ width:46px; height:3px; border-radius:2px; background:rgba(255,255,255,.13); }
  #dashPip b{ display:block; height:100%; width:100%; border-radius:2px;
    background:#9B7BFF; transition:background .12s; }
  #mountTip{ position:absolute; bottom:118px; left:50%; transform:translateX(-50%);
    font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em;
    color:#FFB35C; font-weight:700; opacity:0; transition:opacity .18s;
    text-shadow:0 0 14px rgba(255,179,92,.85); white-space:nowrap; }
  #lowhp{ position:absolute; inset:0; pointer-events:none; opacity:0; transition:opacity .3s;
    background:radial-gradient(ellipse at 50% 50%, rgba(255,40,80,0) 40%, rgba(255,26,66,.55) 100%); }
  #hint{ position:absolute; bottom:14px; left:50%; transform:translateX(-50%);
         font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:.13em;
         color:rgba(242,234,255,.26); text-align:center; line-height:1.9; white-space:nowrap; }

  /* ---------------- SCREENS ---------------- */
  .screen{ position:fixed; inset:0; display:none; place-items:center; z-index:20;
           background:radial-gradient(760px 520px at 50% 14%, rgba(131,110,249,.20), rgba(6,4,12,.95) 62%); }
  .screen.on{ display:grid; }
  .panel{ text-align:center; max-width:600px; padding:26px; }
  .pauseRow{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; }
  .go.ghost{ background:transparent; color:#FF7AC6; border:1px solid rgba(255,122,198,.42);
             box-shadow:none; }
  .go.ghost:hover{ background:rgba(255,122,198,.10); }

  #fade{ position:fixed; inset:0; background:#05030A; z-index:60;
    pointer-events:none; opacity:0; }

  /* --------------------------- how to play ----------------------------- */
  /* The art column is a live 3D stage, not a picture: it is a <canvas> with
     its own renderer, so the panel never has to fight the fight for the
     one WebGL context. Everything left of the text panel is the scene. */
  #scrHow{ background:transparent; }
  #scrHow.on{ display:block; }
  .howWrap{ width:100%; height:100%; max-height:none; display:grid;
    grid-template-columns:1fr 440px; grid-template-rows:62px 1fr 66px;
    background:transparent; border:0; border-radius:0; box-shadow:none; }
  .howHead{ grid-column:1/3; grid-row:1; display:flex; align-items:center; gap:14px;
    padding:0 24px; border-bottom:1px solid #2A2350; background:#0B0817; }
  .howKick{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.30em;
    text-transform:uppercase; color:#9B7BFF; font-weight:700; }
  .howDots{ display:flex; gap:5px; margin-left:auto; }
  .howDots i{ width:6px; height:6px; border-radius:50%; background:#332A5C;
    transition:background .2s, transform .2s; }
  .howDots i.on{ background:#FF7AC6; transform:scale(1.4); }
  .howX{ background:none; border:0; color:#8A82B4; font-size:19px; cursor:pointer;
    line-height:1; padding:2px 4px; }
  .howX:hover{ color:#F2EAFF; }
  .howBody{ display:contents; }
  .howArt{ grid-column:1; grid-row:2; position:relative; background:#08060F;
    overflow:hidden; }
  .howArt canvas{ position:absolute; inset:0; width:100%; height:100%; display:block; }
  .howArt:after{ content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(120% 90% at 50% 42%, rgba(0,0,0,0) 46%, rgba(6,4,12,.72) 100%); }
  .howCaption{ position:absolute; left:0; right:0; bottom:16px; text-align:center;
    font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.22em;
    text-transform:uppercase; color:rgba(242,234,255,.42); pointer-events:none; }
  .howText{ grid-column:2; grid-row:2; background:#0E0A1B; border-left:1px solid #2A2350;
    padding:26px 28px; overflow-y:auto; }
  .howNum{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.26em;
    color:#615A8C; text-transform:uppercase; margin-bottom:7px; }
  .howText h2{ font-size:23px; letter-spacing:-.01em; margin-bottom:10px; }
  .howText p{ font-size:14px; line-height:1.72; color:#C9C1E6; margin-bottom:14px; }
  .howText p b{ color:#F2EAFF; }
  .howKeys{ display:flex; flex-wrap:wrap; gap:6px; }
  .howKeys span{ font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:.06em;
    background:#1B1636; border:1px solid #2A2350; border-radius:6px; padding:5px 9px; color:#C9C1E6; }
  .howKeys span b{ color:#FF7AC6; }
  .howNav{ grid-column:1/3; grid-row:3; display:flex; align-items:center;
    justify-content:space-between; gap:12px; padding:0 24px;
    border-top:1px solid #2A2350; background:#0B0817; }
  .howNav .go{ padding:11px 22px; font-size:10px; }
  .howNav .go[disabled]{ opacity:.32; pointer-events:none; }
  .howCount{ font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:.16em; color:#615A8C; }
  @media(max-width:860px){
    .howWrap{ grid-template-columns:1fr; grid-template-rows:56px 38% 1fr 62px; }
    .howHead{ grid-column:1; grid-row:1; padding:0 16px; }
    .howArt{ grid-column:1; grid-row:2; border-bottom:1px solid #2A2350; }
    .howText{ grid-column:1; grid-row:3; border-left:0; padding:18px; }
    .howNav{ grid-column:1; grid-row:4; padding:0 16px; }
    .howText h2{ font-size:19px; }
  }

  .kicker{ font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.34em;
           color:#FF7AC6; margin-bottom:12px; }
  .panel h1{ margin:0 0 10px; font-size:clamp(30px,5vw,54px); letter-spacing:-.02em; line-height:1; }
  .panel p{ margin:0 auto 22px; color:rgba(242,234,255,.55); font-size:13px;
            line-height:1.7; max-width:460px; }
  .ctrls{ display:grid; grid-template-columns:1fr 1fr; gap:7px 22px; max-width:400px;
          margin:0 auto 24px; font-family:'JetBrains Mono',monospace; font-size:9.5px;
          letter-spacing:.09em; color:rgba(242,234,255,.45); text-align:left; }
  .ctrls b{ color:rgba(242,234,255,.85); font-weight:700; }
  .go{ cursor:pointer; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em;
       text-transform:uppercase; color:#0B0518; background:#FF7AC6; border:0; border-radius:9px;
       padding:14px 26px; transition:transform .12s, box-shadow .12s;
       box-shadow:0 0 28px rgba(255,122,198,.35); }
  .go:hover{ transform:translateY(-2px); box-shadow:0 0 38px rgba(255,122,198,.55); }

  /* ---- short viewports (phone landscape) -------------------------------
     The start card was taller than a 390px-tall phone screen, so ENTER THE
     BLOCK sat below the fold with no way to scroll to it. Flex + auto margins
     centres it when there is room and scrolls when there is not. */
  @media (max-height:560px){
    .screen.on{ display:flex; flex-direction:column; align-items:center; overflow-y:auto; }
    .screen .panel{ margin:auto 0; }
    #scrStart .panel{ padding:14px 18px 16px; max-width:min(560px,92vw);
                      background:rgba(6,4,12,.74); border-radius:14px;
                      -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px); }
    #scrStart .kicker{ margin-bottom:4px; font-size:9px; }
    #scrStart h1{ font-size:clamp(22px,7vh,34px); margin:2px 0 6px; }
    #scrStart p{ font-size:11.5px; line-height:1.42; margin-bottom:8px; }
    #scrStart .howHint{ display:none; }
    #scrStart .ctrls{ display:none; }
    #scrStart .pauseRow{ margin-bottom:6px; }
    #scrStart .go{ font-size:16px; padding:9px 18px; }
  }
  /* the start card sits over a live 3D scene: give the type its own shadow so
     the machine's lightbox can never fight the headline for legibility */
  #scrStart h1, #scrStart p, #scrStart .kicker{
    text-shadow:0 2px 16px rgba(0,0,0,.9), 0 0 44px rgba(6,4,12,.92); }

  /* ============================ touch layer ============================
     Same control language as Viber Brawl: stick on the left, five buttons on
     the right, hold to commit. Only a coarse primary pointer gets it, so a
     desktop with a touchscreen stays clean. */
  body.touch{ touch-action:none; -webkit-user-select:none; user-select:none; overscroll-behavior:none; }
  /* below the .screen overlays (z 20) so a pause card covers the pad */
  #tpad{ position:fixed; inset:0; z-index:15; display:none; pointer-events:none; }
  body.touch #tpad{ display:block; }
  body.touch #hint{ display:none; }
  #tstick{ position:absolute; left:max(16px,env(safe-area-inset-left));
    bottom:max(16px,env(safe-area-inset-bottom)); width:116px; height:116px; border-radius:50%;
    background:rgba(10,7,18,.40); border:1px solid rgba(155,123,255,.30);
    pointer-events:auto; touch-action:none;
    -webkit-backdrop-filter:blur(7px); backdrop-filter:blur(7px); }
  #tknob{ position:absolute; left:50%; top:50%; width:50px; height:50px; margin:-25px 0 0 -25px;
    border-radius:50%; background:rgba(242,234,255,.20); border:1px solid rgba(242,234,255,.34); }
  .tb{ position:absolute; display:grid; place-items:center; border-radius:50%;
    border:1px solid rgba(155,123,255,.34); background:rgba(12,8,22,.52); color:#F2EAFF;
    font:700 9.5px/1 'JetBrains Mono',monospace; letter-spacing:.08em;
    pointer-events:auto; touch-action:none;
    -webkit-backdrop-filter:blur(7px); backdrop-filter:blur(7px); }
  .tb.on{ background:rgba(255,122,198,.34); border-color:rgba(255,122,198,.85); }
  .tb.dim{ opacity:.34; }
  #tbHit{ right:12px; bottom:12px; width:64px; height:64px; font-size:10.5px; }
  #tbHeavy{ right:82px; bottom:18px; width:56px; height:56px; }
  #tbJump{ right:16px; bottom:84px; width:54px; height:54px; }
  #tbDash{ right:82px; bottom:82px; width:48px; height:48px; }
  #tbMount{ right:142px; bottom:20px; width:48px; height:48px; }
  #tpause{ position:fixed; right:max(12px,env(safe-area-inset-right)); top:max(12px,env(safe-area-inset-top));
    z-index:16; display:none; width:42px; height:42px; border-radius:11px; padding:0;
    border:1px solid rgba(155,123,255,.34); background:rgba(10,7,18,.62); color:#F2EAFF;
    font:700 13px/1 'JetBrains Mono',monospace; place-items:center;
    -webkit-backdrop-filter:blur(7px); backdrop-filter:blur(7px); }
  /* the portrait gate sits above everything, including the fade */
  #rotateLock{ position:fixed; inset:0; z-index:80; display:none; flex-direction:column;
    align-items:center; justify-content:center; gap:16px; background:#07050E; text-align:center; padding:26px; }
  body.rotlock #rotateLock{ display:flex; }
  .rl-phone{ width:62px; height:104px; border:4px solid #9B7BFF; border-radius:13px;
    transform:rotate(-90deg); margin-bottom:6px; }
  .rl-t{ font:700 15px/1.2 'Space Grotesk',system-ui,sans-serif; letter-spacing:.16em; color:#F2EAFF; }
  .rl-s{ font:400 12px/1.55 'Space Grotesk',system-ui,sans-serif; color:rgba(242,234,255,.55); max-width:290px; }

  /* ---- the receipt: the run, printed -------------------------------- */
  #receiptWrap{ position:fixed; inset:0; z-index:60; display:none; place-items:center;
    background:rgba(4,3,8,.74); backdrop-filter:blur(7px); -webkit-backdrop-filter:blur(7px); }
  #receiptWrap.on{ display:grid; }
  .rcCol{ display:flex; flex-direction:column; align-items:center; gap:14px; }
  @keyframes paperOut{
    0%{ transform:translateY(30px) scale(.94) rotate(-1.2deg); opacity:0 }
    62%{ transform:translateY(-5px) scale(1.012) rotate(.3deg); opacity:1 }
    100%{ transform:none; opacity:1 } }
  .rcPaper{ position:relative; width:min(330px,86vw); background:#F4F1E8; color:#1A1A16;
    border-radius:3px 3px 0 0; padding:20px 18px 16px;
    font-family:'JetBrains Mono',monospace;
    box-shadow:0 30px 70px rgba(0,0,0,.66);
    animation:paperOut .55s cubic-bezier(.2,.9,.25,1.1) both; }
  .rcPaper::after{ content:''; position:absolute; left:0; right:0; bottom:-10px; height:10px;
    background:repeating-linear-gradient(-45deg,#F4F1E8 0 7px,transparent 7px 14px); }
  .rcHead{ text-align:center; font-size:12.5px; font-weight:700; letter-spacing:.18em; }
  .rcSub{ text-align:center; font-size:9px; letter-spacing:.22em; color:#6B675C; margin:2px 0 11px; }
  .rcRow{ display:flex; justify-content:space-between; align-items:baseline;
    font-size:10px; letter-spacing:.05em; padding:4px 0; border-top:1px dashed #D3CDBC; }
  .rcRow.first{ border-top:1px dashed #B9B3A3; }
  .rcRow span:last-child{ font-weight:700; }
  .rcStamp{ margin:13px 0 9px; text-align:center; font-size:9px; letter-spacing:.16em; color:#6B675C; }
  .rcStamp.fail{ color:#A32D2D; }
  .rcBtns{ display:flex; gap:8px; }
  .rcBtns button{ border:0; border-radius:10px; padding:11px 14px; font-family:'Space Grotesk',system-ui,sans-serif;
    font-size:11px; font-weight:700; letter-spacing:.1em; cursor:pointer; }
  #rcShare{ background:#DFF902; color:#0C0F08; }
  #rcSave{ background:#1A1A16; color:#F4F1E8; }
  #rcClose{ background:transparent; color:#9B93B8; box-shadow:inset 0 0 0 2px rgba(255,255,255,.18); }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="hud">
  <div id="lowhp"></div>
  <div class="bars">
    <div class="barwrap">
      <div class="bname"><span>CHOG</span><span id="pHpTxt">105</span></div>
      <div class="track"><div class="fill" id="pFill"></div></div>
    </div>
  </div>
  <div id="dashPip"><div class="dp"><b id="dashBar"></b></div><span>DASH</span></div>
  <div id="mountTip">F · MOUNT THE VENT</div>
  <div id="bossMark"><svg viewBox="0 0 24 24"><path d="M12 3 L20 19 L12 15 L4 19 Z" fill="#FF3D9A"/></svg></div>
  <div id="toast"></div>
  <div id="hint">WASD move · SPACE jump · SHIFT dash = dodge (i-frames) · F mount · J / K attacks · ESC pause<br>DRAG to look · M attack-move mode</div>
</div>

<div class="screen on" id="scrStart">
  <div class="panel">
    <div class="kicker">CHOG TRIALS · 01</div>
    <h1>THE MACHINE</h1>
    <p>The cans behind the glass are its health — there is no bar.
       <b>Dash through</b> what it throws; you cannot be hit mid-dash.
       When the vents glow, <b>F</b> to climb it.</p>
    <p class="howHint" style="margin-bottom:16px;color:rgba(242,234,255,.42);font-size:12px">
       New here? <b>How to play</b> walks through every attack it has.</p>
    <div class="ctrls">
      <div><b>WASD</b> move</div><div><b>SPACE</b> jump / double jump</div>
      <div><b>SHIFT</b> dash / dodge</div><div><b>F</b> mount the vent</div><div><b>J / K</b> or <b>click</b> attack</div>
      <div><b>DRAG</b> to look around</div><div><b>ESC</b> pause</div>
    </div>
    <div class="pauseRow" style="margin-bottom:11px">
      <button class="go ghost" id="btnHowStart">How to play</button><button class="go ghost" id="btnBoard">Leaderboard</button>
    </div>
    <button class="go" id="btnStart">Enter the block</button>
  </div>
</div>

<div class="screen" id="scrEnd">
  <div class="panel">
    <div class="kicker" id="endKicker">RESULT</div>
    <h1 id="endTitle">—</h1>
    <p id="endSub">—</p>
    <button class="go" id="btnAgain">Fight again</button><button class="go ghost" id="btnBoardEnd" style="margin-top:9px">See the board</button>
  </div>
</div>



<div id="receiptWrap">
  <div class="rcCol">
    <div class="rcPaper">
      <div class="rcHead">CHOG MART</div>
      <div class="rcSub" id="rcSub">UNIT 07 &middot; AISLE 7</div>
      <div id="rcRows"></div>
      <div class="rcStamp" id="rcStamp">THANK YOU FOR SHOPPING</div>
      <canvas id="rcBar" width="294" height="30" style="display:block;margin:0 auto"></canvas>
    </div>
    <div class="rcBtns">
      <button id="rcShare" type="button">SHARE</button>
      <button id="rcSave" type="button">SAVE</button>
      <button id="rcClose" type="button">CLOSE</button>
    </div>
  </div>
</div>

<div id="fade"></div>

<div class="screen" id="scrHow">
  <div class="howWrap">
    <div class="howHead">
      <div class="howKick">HOW TO PLAY</div>
      <div class="howDots" id="howDots"></div>
      <button class="howX" id="btnHowClose" title="Close">&times;</button>
    </div>
    <div class="howBody">
      <div class="howArt" id="howArt">
        <canvas id="tutCanvas"></canvas>
        <div class="howCaption" id="howCaption"></div>
      </div>
      <div class="howText">
        <div class="howNum" id="howNum"></div>
        <h2 id="howTitle"></h2>
        <p id="howBody"></p>
        <div class="howKeys" id="howKeys"></div>
      </div>
    </div>
    <div class="howNav">
      <button class="go ghost" id="btnHowPrev">Back</button>
      <span class="howCount" id="howCount"></span>
      <button class="go" id="btnHowNext">Next</button>
    </div>
  </div>
</div>


<div class="screen" id="scrPause">
  <div class="panel">
    <div class="kicker">PAUSED</div>
    <h1>HOLD</h1>
    <p>It is still in there. Take your time.</p>
    <div class="pauseRow">
      <button class="go" id="btnResume">Resume</button>
      <button class="go ghost" id="btnHowPause">How to play</button>
      <button class="go ghost" id="btnQuit">Quit to menu</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"
        integrity="sha384-CI3ELBVUz9XQO+97x6nwMDPosPR5XvsxW2ua7N1Xeygeh1IxtgqtCkGfQY9WWdHu" crossorigin="anonymous"></script>

<div id="tpad">
  <div id="tstick"><div id="tknob"></div></div>
  <div class="tb" id="tbHit">HIT</div>
  <div class="tb" id="tbHeavy">HEAVY</div>
  <div class="tb" id="tbJump">JUMP</div>
  <div class="tb" id="tbDash">DASH</div>
  <div class="tb" id="tbMount">MOUNT</div>
</div>
<button id="tpause" type="button" aria-label="Pause">&#10074;&#10074;</button>
<div id="rotateLock" role="dialog" aria-label="Rotate your device">
  <div class="rl-phone"></div>
  <div class="rl-t">ROTATE YOUR PHONE</div>
  <div class="rl-s">CHOG TRIALS is played sideways &mdash; turn your device to fill the alley.</div>
</div>

<script>
'use strict';
/* =========================================================================
   CHOG TRIALS — THE MACHINE
   Phase 1: hover-slide (it glides, tracks you, keeps its distance).
   Phase 2: the door opens and it switches to stalk -> lunge.
   ========================================================================= */

/* ------------------------------ helpers -------------------------------- */
const TAU = Math.PI*2;
const clamp = (v,a,b)=> v<a?a:(v>b?b:v);
const damp  = (a,b,k,dt)=> a+(b-a)*(1-Math.exp(-k*dt));
const angDiff = (a,b)=> ((b-a+Math.PI)%TAU+TAU)%TAU-Math.PI;
const angLerp = (a,b,t)=> a+angDiff(a,b)*t;
const rand = (a,b)=> a+Math.random()*(b-a);
const dist2D = (ax,az,bx,bz)=> Math.hypot(ax-bx, az-bz);

const outlineMat = new THREE.LineBasicMaterial({color:0x14161A});
const edgeCache = new Map();
function edgeGeo(g){
  const p=g.parameters;
  const key=(p.width||0)+'_'+(p.height||0)+'_'+(p.depth||0)+'_'+(p.radius||0);
  if(!edgeCache.has(key)) edgeCache.set(key,new THREE.EdgesGeometry(g));
  return edgeCache.get(key);
}
function mkBox(w,h,d,mat,outline){
  const g=new THREE.BoxGeometry(w,h,d);
  const m=new THREE.Mesh(g,mat);
  m.castShadow=true; m.receiveShadow=true;
  if(outline!==false) m.add(new THREE.LineSegments(edgeGeo(g), outlineMat));
  return m;
}

/* flat-shaded cache for the static arena */
const matCache=new Map(), boxCache=new Map();
function mat(color,em){
  const k=color+'|'+(em||0);
  if(!matCache.has(k)){
    const m=new THREE.MeshLambertMaterial({color});
    if(em){ m.emissive=new THREE.Color(em); m.emissiveIntensity=1; }
    matCache.set(k,m);
  }
  return matCache.get(k);
}
function boxGeo(w,h,d){
  const k=w+'_'+h+'_'+d;
  if(!boxCache.has(k)) boxCache.set(k,new THREE.BoxGeometry(w,h,d));
  return boxCache.get(k);
}
function B(g,w,h,d,x,y,z,color,o){
  o=o||{};
  const mesh=new THREE.Mesh(boxGeo(w,h,d), o.glow?new THREE.MeshBasicMaterial({color}):mat(color,o.em));
  mesh.position.set(x,y,z);
  if(o.rx) mesh.rotation.x=o.rx;
  if(o.ry) mesh.rotation.y=o.ry;
  if(o.rz) mesh.rotation.z=o.rz;
  mesh.castShadow=o.shadow!==false;
  mesh.receiveShadow=true;
  if(o.outline!==false) mesh.add(new THREE.LineSegments(edgeGeo(boxGeo(w,h,d)), outlineMat));
  g.add(mesh);
  return mesh;
}
/* A field of identical boxes in ONE draw call. The brickwork alone was 60
   separate meshes and the chalk ring another 34 - 94 draw calls for geometry
   that never moves. Instancing hands that budget back to the set dressing. */
function instBoxes(g, items, color, opts){
  opts=opts||{};
  const inst=new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),
    new THREE.MeshLambertMaterial({color}), items.length);
  const m=new THREE.Matrix4(), q=new THREE.Quaternion(),
        pos=new THREE.Vector3(), sc=new THREE.Vector3(), up=new THREE.Vector3(0,1,0);
  items.forEach((it,i)=>{
    pos.set(it.x,it.y,it.z);
    sc.set(it.w,it.h,it.d);
    q.setFromAxisAngle(up, it.ry||0);
    m.compose(pos,q,sc);
    inst.setMatrixAt(i,m);
  });
  inst.instanceMatrix.needsUpdate=true;
  inst.castShadow=opts.shadow===true;
  inst.receiveShadow=true;
  g.add(inst);
  return inst;
}

function sign(g,w,h,x,y,z,text,fg,bg){
  const cv=document.createElement('canvas'); cv.width=512; cv.height=128;
  const c=cv.getContext('2d');
  c.fillStyle=bg; c.fillRect(0,0,512,128);
  c.fillStyle=fg; c.font='700 76px Impact, Haettenschweiler, sans-serif';
  c.textAlign='center'; c.textBaseline='middle'; c.fillText(text,256,70);
  const tex=new THREE.CanvasTexture(cv); tex.anisotropy=4;
  const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h), new THREE.MeshBasicMaterial({map:tex}));
  m.position.set(x,y,z); g.add(m); return m;
}
function chalkRing(g,radius,count,color){
  const items=[];
  for(let i=0;i<count;i++){
    const a=i/count*Math.PI*2, w=0.26+(i%4)*0.07;
    items.push({w,h:0.02,d:0.9,x:Math.cos(a)*radius,y:0.06,z:Math.sin(a)*radius,ry:-a});
  }
  instBoxes(g,items,color);
}

const SFX_DATA = {"vendCoil":"","canBurst":"","coinMech":"","glassBreak":"","tiltSlam":"","hitHeavy":"","jump":"","land":"","swing":"","dash":"","canClink":"","canTick":"","coinHit":"","step":"","backHit":"","heatWhine":"","coolHiss":"","stockDrop":"","restockCycle":"","powerDown":"","lungeGo":"","tiltSpinUp":"","castorSqueal":"","glassTinkle":"","phaseBreak":"","victory":"","defeat":""};

/* ------------------------------- audio ---------------------------------
   Sample engine + mix architecture.

   HISTORY, because it matters: the first version of this file synthesised
   every sound live from one oscillator and one noise burst. It sounded like
   a calculator, and no amount of mixing could fix that - the problem was the
   source, not the levels. This version plays real rendered audio.

   Each sound was built offline (audio/sfx_lab.py + audio/sfx_set.py) from a
   three-part model:
       transient  the first 5 ms - where and how hard
       body       the object ringing at inharmonic frequencies
       tail       the room answering
   then encoded to mp3 and embedded below, so the game is still one file with
   nothing to download.

   On top of that sits the mix:

     P0  tells and moments   never stolen, never ducked
     P1  combat              stolen only by P0
     P2  world               ducked, then stolen
     P3  detail              first to go

   Lanes sum into one SFX bus, then master, then a limiter that is a safety
   net rather than a compressor doing constant work.

   The public API is unchanged - all 29 call sites still call SFX.jump(),
   SFX.canBurst() and so on.
   ---------------------------------------------------------------------- */

const LANE_DB  = { P0:0, P1:-6, P2:-10, P3:-16 };
const LANE_CAP = { P0:8, P1:8, P2:10, P3:4 };
const MAX_VOICES = 24;

const SFX = {
  ctx:null, master:null, limiter:null, bus:null,
  enabled:true,
  samples:{}, ready:false, loaded:0,
  live:[], _cur:null, _last:{},
  stats:{ played:0, stolen:0, blocked:0, dropped:0 },

  cap:  { canClink:4, canTick:2, step:2, coinHit:3, coolHiss:2 },
  cool: { canClink:0.06, canTick:0.22, step:0.18, coinHit:0.045 },

  lane:{
    /* P0 - tells and moments: the fight depends on these being audible */
    vendCoil:'P0', coinMech:'P0', tiltSpinUp:'P0', castorSqueal:'P0',
    glassTinkle:'P0', glassBreak:'P0', phaseBreak:'P0', powerDown:'P0',
    victory:'P0', defeat:'P0',
    /* P1 - combat */
    jump:'P1', land:'P1', hitHeavy:'P1', swing:'P1', dash:'P1',
    backHit:'P1', tiltSlam:'P1', lungeGo:'P1', heatWhine:'P1',
    /* P2 - world */
    canBurst:'P1', coinHit:'P1', canClink:'P2', step:'P2', stockDrop:'P2',
    restockCycle:'P2',
    /* P3 - detail */
    canTick:'P3', coolHiss:'P3'
  },

  init(){
    if(this.ctx) return;
    try{ this.ctx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return; }
    const c=this.ctx;

    this.limiter=c.createDynamicsCompressor();
    this.limiter.threshold.value=-1;
    this.limiter.knee.value=0;
    this.limiter.ratio.value=20;
    this.limiter.attack.value=0.003;
    this.limiter.release.value=0.25;
    this.limiter.connect(c.destination);

    this.master=c.createGain();
    this.master.gain.value=0.7;
    this.master.connect(this.limiter);

    this.bus={};
    for(const k in LANE_DB){
      const g=c.createGain();
      g.gain.value=Math.pow(10, LANE_DB[k]/20);
      g.connect(this.master);
      this.bus[k]=g;
    }
    this._load();
  },

  _load(){
    const names=Object.keys(SFX_DATA);
    let left=names.length;
    for(const n of names){
      const bin=atob(SFX_DATA[n]);
      const arr=new Uint8Array(bin.length);
      for(let i=0;i<bin.length;i++) arr[i]=bin.charCodeAt(i);
      this.ctx.decodeAudioData(arr.buffer,
        b=>{ this.samples[n]=b; this.loaded++; if(--left===0) this.ready=true; },
        ()=>{ if(--left===0) this.ready=true; });
    }
  },

  resume(){ if(this.ctx && this.ctx.state==='suspended') this.ctx.resume(); },

  /* ---------------- the gate every sound passes through ---------------- */
  _go(name, fn){
    if(!this.ctx||!this.enabled) return;
    const now=this.ctx.currentTime;

    for(let i=this.live.length-1;i>=0;i--)
      if(this.live[i].end<=now) this.live.splice(i,1);

    const lane=this.lane[name]||'P2';

    const cd=this.cool[name];
    if(cd && this._last[name]!==undefined && now-this._last[name]<cd){
      this.stats.blocked++; return;
    }

    const cap=this.cap[name]||4;
    let same=0, inLane=0;
    for(const v of this.live){
      if(v.name===name) same++;
      if(v.lane===lane) inLane++;
    }
    if(same>=cap){ this.stats.blocked++; return; }

    if(inLane>=LANE_CAP[lane] || this.live.length>=MAX_VOICES){
      if(!this._steal(lane)){ this.stats.blocked++; return; }
    }

    this._last[name]=now;
    const entry={ name, lane, nodes:[], end:now+0.25 };
    this._cur=entry;
    try{ fn(); } finally { this._cur=null; }
    if(!entry.nodes.length){ this.stats.dropped++; return; }  /* not decoded yet */
    for(const n of entry.nodes) if(n.stop>entry.end) entry.end=n.stop;
    this.live.push(entry);
    this.stats.played++;
  },

  _steal(wanted){
    const rank={ P0:3, P1:2, P2:1, P3:0 };
    let victim=null, vi=-1;
    for(let i=0;i<this.live.length;i++){
      const v=this.live[i];
      if(rank[v.lane]>=rank[wanted]) continue;
      if(!victim || rank[v.lane]<rank[victim.lane]){ victim=v; vi=i; }
    }
    if(!victim) return false;
    const now=this.ctx.currentTime;
    for(const n of victim.nodes){
      try{
        n.gain.gain.cancelScheduledValues(now);
        n.gain.gain.setTargetAtTime(0.0001, now, 0.008);
        n.node.stop(now+0.05);
      }catch(e){}
    }
    this.live.splice(vi,1);
    this.stats.stolen++;
    return true;
  },

  /* Play one sample. Pitch and level jitter are what stop a repeated sound
     from turning into a machine gun - same file, never the same event. */
  _play(name, opt){
    const buf=this.samples[name];
    if(!buf) return null;
    const o=opt||{};
    const src=this.ctx.createBufferSource();
    src.buffer=buf;
    src.playbackRate.value = o.rate!==undefined
      ? o.rate : 1 + (Math.random()*2-1)*0.06;
    const g=this.ctx.createGain();
    g.gain.value = o.gain!==undefined ? o.gain : 1;
    src.connect(g);
    g.connect(this.bus[(this._cur && this._cur.lane)||'P2']);
    src.start();
    const stop=this.ctx.currentTime + buf.duration/src.playbackRate.value;
    if(this._cur) this._cur.nodes.push({ node:src, gain:g, stop });
    return stop;
  },

  /* ---------------------------- player ---------------------------- */
  jump(){ this._go('jump', ()=>this._play('jump')); },
  land(impact){
    const k=Math.max(0,Math.min(1,impact||0));
    this._go('land', ()=>this._play('land',{ gain:0.55+k*0.55, rate:1.06-k*0.13 }));
  },
  hitLight(){ this._go('hitHeavy', ()=>this._play('hitHeavy',{ gain:0.7, rate:1.08 })); },
  hitHeavy(){ this._go('hitHeavy', ()=>this._play('hitHeavy')); },
  swing(){ this._go('swing', ()=>this._play('swing')); },
  dash(){ this._go('dash', ()=>this._play('dash')); },

  /* -------------------------- boss voices -------------------------- */
  canWarn(){ this._go('vendCoil', ()=>this._play('vendCoil',{ gain:0.6, rate:1.1 })); },
  coinWarn(){ this._go('coinMech', ()=>this._play('coinMech',{ gain:0.6, rate:1.1 })); },
  canClink(){ this._go('canClink', ()=>this._play('canClink')); },
  canTick(){ this._go('canTick', ()=>this._play('canTick')); },
  canBurst(){ this._go('canBurst', ()=>this._play('canBurst')); },
  coinHit(){ this._go('coinHit', ()=>this._play('coinHit')); },
  tiltWarn(){ this._go('tiltSpinUp', ()=>this._play('tiltSpinUp',{ gain:0.7 })); },
  tiltSlam(){ this._go('tiltSlam', ()=>this._play('tiltSlam')); },
  lungeWarn(){ this._go('castorSqueal', ()=>this._play('castorSqueal',{ gain:0.8 })); },
  lungeGo(){ this._go('lungeGo', ()=>this._play('lungeGo')); },
  step(){ this._go('step', ()=>this._play('step')); },

  /* --- the machine's own vocabulary -----------------------------------
     Each attack announces itself with a sound a real vending machine makes.
     That is the tell language: no hazard decals, no screen clutter. All of
     them are P0, so nothing can steal or duck them. ------------------- */

  vendCoil(){ this._go('vendCoil', ()=>this._play('vendCoil')); },
  coinMech(){ this._go('coinMech', ()=>this._play('coinMech')); },
  tiltSpinUp(){ this._go('tiltSpinUp', ()=>this._play('tiltSpinUp')); },
  castorSqueal(){ this._go('castorSqueal', ()=>this._play('castorSqueal')); },
  glassTinkle(){ this._go('glassTinkle', ()=>this._play('glassTinkle')); },
  restockCycle(){ this._go('restockCycle', ()=>this._play('restockCycle')); },
  stockDrop(){ this._go('stockDrop', ()=>this._play('stockDrop')); },
  backHit(){ this._go('backHit', ()=>this._play('backHit')); },
  heatWhine(){ this._go('heatWhine', ()=>this._play('heatWhine')); },
  coolHiss(){ this._go('coolHiss', ()=>this._play('coolHiss')); },
  powerDown(){ this._go('powerDown', ()=>this._play('powerDown')); },
  glassBreak(){ this._go('glassBreak', ()=>this._play('glassBreak')); },
  phaseBreak(){ this._go('phaseBreak', ()=>this._play('phaseBreak')); },
  victory(){ this._go('victory', ()=>this._play('victory')); },
  defeat(){ this._go('defeat', ()=>this._play('defeat')); },

  /* ------------------------- test hooks ------------------------- */
  __mix(){
    return {
      ready:this.ready, loaded:this.loaded, total:Object.keys(SFX_DATA).length,
      lanes:Object.keys(LANE_DB).map(k=>({ lane:k, db:LANE_DB[k], gain:+this.bus[k].gain.value.toFixed(3) })),
      master:+this.master.gain.value.toFixed(3),
      limiter:this.limiter.threshold.value,
      live:this.live.length,
      stats:{...this.stats}
    };
  }
};

/* --------------------------- renderer / scene -------------------------- */
const canvas=document.getElementById('c');
const renderer=new THREE.WebGLRenderer({canvas, antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
/* NOTE: deliberately left on the default linear output. Switching to sRGB +
   ACES is the physically correct pipeline, but every colour in this arena was
   authored against linear output, so turning it on re-grades the whole block
   to pale lavender. The machine gets its realism from PBR materials and its
   own lights instead — see buildMachine(). */

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x0A0718);
scene.fog=new THREE.Fog(0x0A0718, 58, 155);

/* ------------------------- reflection environment ----------------------
   A metalness=1 material with nothing to reflect renders BLACK. That is the
   single reason the old machine had no chrome and the cans looked like flat
   plastic. This paints a tiny equirect of the street — violet sky, sodium
   horizon, the GM neon, a pink wash — and runs it through PMREM so every
   standard material gets blurred, physically plausible reflections for free.
   ---------------------------------------------------------------------- */
function buildEnvMap(){
  const cv=document.createElement('canvas'); cv.width=512; cv.height=256;
  const c=cv.getContext('2d');

  const sky=c.createLinearGradient(0,0,0,150);
  sky.addColorStop(0.00,'#0B0718');
  sky.addColorStop(0.55,'#241A3E');
  sky.addColorStop(0.88,'#4A3050');
  sky.addColorStop(1.00,'#7A4048');
  c.fillStyle=sky; c.fillRect(0,0,512,150);

  const gnd=c.createLinearGradient(0,150,0,256);
  gnd.addColorStop(0,'#332638');
  gnd.addColorStop(0.35,'#17111F');
  gnd.addColorStop(1,'#07050A');
  c.fillStyle=gnd; c.fillRect(0,150,512,106);

  function blob(x,y,r,col,a){
    const gr=c.createRadialGradient(x,y,0,x,y,r);
    gr.addColorStop(0,col); gr.addColorStop(1,'rgba(0,0,0,0)');
    c.globalAlpha=a; c.fillStyle=gr;
    c.beginPath(); c.arc(x,y,r,0,7); c.fill(); c.globalAlpha=1;
  }
  blob(120, 96,58,'#8FEBFF',0.95);   /* the GM neon            */
  blob(330, 74,74,'#FF9AD4',0.80);   /* pink wash from the shop */
  blob(452,104,44,'#FFDFAE',0.85);   /* the street lamp         */
  blob(232, 58,26,'#FFFFFF',0.55);   /* a bare bulb             */

  const tex=new THREE.CanvasTexture(cv);
  tex.mapping=THREE.EquirectangularReflectionMapping;
  tex.encoding=THREE.sRGBEncoding;
  const pmrem=new THREE.PMREMGenerator(renderer);
  pmrem.compileEquirectangularShader();
  const rt=pmrem.fromEquirectangular(tex);
  tex.dispose(); pmrem.dispose();
  return rt.texture;
}
scene.environment = buildEnvMap();
const camera=new THREE.PerspectiveCamera(55,1,0.1,420);

/* -------------------------------- arena -------------------------------- */
const arena=new THREE.Group();
scene.add(arena);

/* playable bounds. The shop wall sits at z=-15, so the old +-21 clamp let the
   player walk straight through it — and a boss confined to the arena could
   never follow. Both fighters share the real floor. */
const BOUNDS = { xMin:-20.5, xMax:20.5, zMin:-12.2, zMax:20.8 };
const BOSS_BOUNDS = { xMin:-19.5, xMax:19.5, zMin:-12.0, zMax:19.5 };

/* solid props, as circles. The boss must roam the whole arena, so it needs to
   slide around these rather than be penned into a small circle. */
const OBSTACLES = [
  { x:-18.5, z:-6,   r:4.0 },  /* dumpster */
  { x:-19,   z:10.2, r:2.6 },  /* crates   */
  { x: 16.5, z:19.5, r:2.4 },  /* planter  */
  { x:-12,   z:19.5, r:1.0 },  /* hydrant  */
  { x: 21,   z:-2,   r:0.8 },  /* lamp     */
  /* the set dressing below is solid too - without these the boss glides
     straight through the cart, which looks far worse than not having one */
  { x:-16.2, z:16.2, r:1.3 },  /* shopping cart */
  { x:-17.4, z: 4.2, r:1.5 },  /* pallet stack  */
  { x: 13.6, z:-8.4, r:0.5 },  /* traffic cone  */
  { x:  7.6, z:16.4, r:0.5 }   /* wet floor sign*/
];

function buildArena(){
  B(arena,46,0.6,46,0,-0.3,0,0x15131F);
  B(arena,46,0.05,2.4,0,0.02,6,0x1E1B2E,{outline:false,shadow:false});
  B(arena,46,0.5,0.8,0,0.05,-13,0x2A2438);
  chalkRing(arena,7,34,0xCFC8DC);
  B(arena,0.6,0.02,0.6,0,0.06,0,0xE8E2F2,{outline:false,shadow:false});

  /* back wall + brick */
  B(arena,46,10,1.4,0,5,-15,0x2E2140);
  const bricks=[];
  for(let r=0;r<6;r++){
    bricks.push({w:45.6,h:0.10,d:0.1,x:0,y:1.1+r*1.55,z:-14.2});
    for(let c2=0;c2<9;c2++)
      bricks.push({w:0.1,h:1.4,d:0.1,x:-20+c2*5+(r%2?2.5:0),y:1.8+r*1.55,z:-14.2});
  }
  instBoxes(arena,bricks,0x3A2B52);
  /* storefront */
  B(arena,15,7,0.8,-7,3.5,-14.3,0x0D0A18);
  const slats=[];
  for(let i=0;i<11;i++) slats.push({w:14.4,h:0.30,d:0.14,x:-7,y:0.9+i*0.58,z:-13.85});
  instBoxes(arena,slats,0x1C1632);
  B(arena,15.4,0.5,0.3,-7,3.6,-13.8,0x2A2246,{outline:false,shadow:false});
  B(arena,16,0.4,3.2,-7,7.35,-13.2,0x3A1B4E);
  B(arena,16,2.1,0.5,-7,8.9,-14.4,0x120C1E);
  sign(arena,14.6,1.7,-7,8.9,-14.1,'CHOG MART','#F3E7D3','#120C1E');

  /* mural */
  const cv=document.createElement('canvas'); cv.width=512; cv.height=512;
  const m2=cv.getContext('2d');
  m2.fillStyle='#F3E7D3'; m2.strokeStyle='#120A1E'; m2.lineWidth=16;
  m2.beginPath(); m2.roundRect(96,150,320,240,58); m2.fill(); m2.stroke();
  const gr=m2.createLinearGradient(110,200,400,300);
  gr.addColorStop(0,'#5BE7FF'); gr.addColorStop(.6,'#2F7BFF'); gr.addColorStop(1,'#6B3BFF');
  m2.fillStyle=gr; m2.beginPath(); m2.roundRect(120,220,272,86,26); m2.fill(); m2.stroke();
  m2.fillStyle='#EF6E93';
  m2.beginPath(); m2.ellipse(160,352,30,18,0,0,7); m2.fill();
  m2.beginPath(); m2.ellipse(352,352,30,18,0,0,7); m2.fill();
  m2.strokeStyle='#120A1E'; m2.lineWidth=12;
  m2.beginPath(); m2.moveTo(232,362); m2.quadraticCurveTo(256,382,280,362); m2.stroke();
  const mm=new THREE.Mesh(new THREE.PlaneGeometry(9.4,9.4),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv),transparent:true}));
  mm.position.set(8.2,5.2,-14.15); arena.add(mm);

  /* neon */
  B(arena,5.4,2.8,0.4,17.4,6.6,-14.4,0x0B0814);
  sign(arena,4.8,2.2,17.4,6.6,-14.15,'GM','#DFFBFF','#0B0814');
  lightAt(0x4FE3FF,1.6,22,16,6.6,-12);

  /* props */
  B(arena,6.4,2.8,3.2,-18.5,1.4,-6,0x1E5A46);
  B(arena,6.8,0.5,3.4,-18.5,3.05,-6,0x2E8A68);
  B(arena,2.6,2.6,2.6,-19,1.3,9,0x2A1B3E);
  B(arena,2.1,2.1,2.1,-19,3.65,9,0x37234F);
  B(arena,2.3,2.3,2.3,-19,1.15,11.5,0x2A1B3E);
  B(arena,0.7,1.3,0.7,-12,0.65,19.5,0xC8324A);
  B(arena,1.0,0.22,0.34,-12,1.15,19.5,0xC8324A);
  B(arena,3.6,1.2,2.2,16.5,0.6,19.5,0x3E3A4A);
  B(arena,3.2,0.14,1.8,16.5,1.24,19.5,0x2A1F33,{outline:false,shadow:false});
  B(arena,1.1,0.9,1.0,15.9,1.7,19.5,0x2E7A5E);
  B(arena,0.9,0.7,0.9,17.2,1.6,19.4,0x3A8A6A);
  B(arena,0.24,11,0.24,21,5.5,-2,0x1B1228);
  B(arena,1.8,0.3,1.8,21,11.2,-2,0x2A1E3E);
  B(arena,1.2,0.14,1.2,21,10.98,-2,0xFFE9C9,{glow:true,outline:false});
  lightAt(0xFFE9C9,2.2,30,21,10.4,-2);

  /* puddles */
  const pud=new THREE.MeshBasicMaterial({color:0x3E5A9E,transparent:true,opacity:.10});
  [[-4,8,3.2],[12,4,2.4],[-9,2,2.0]].forEach(([x,z,r])=>{
    const m=new THREE.Mesh(new THREE.CircleGeometry(r,20),pud);
    m.rotation.x=-Math.PI/2; m.position.set(x,0.05,z); arena.add(m);
  });

  /* ------------------------- back-alley detail --------------------------
     Set dressing only: nothing here is inside the fight space, nothing
     blocks movement, and every piece is outline:false so it costs one draw
     call instead of two. The 102 calls freed by instancing the brickwork,
     shutter and chalk ring pay for all of it.
     ------------------------------------------------------------------- */

  /* --- wall: condenser unit, pipe run, junction box, camera, paper --- */
  B(arena,2.7,1.75,0.95,-14.6,6.5,-13.80,0x2C2640,{outline:false});
  for(let i=0;i<5;i++) B(arena,2.3,0.10,0.08,-14.6,5.92+i*0.28,-13.30,0x181329,{outline:false});
  {
    const fan=new THREE.Mesh(new THREE.CircleGeometry(0.50,16),
      new THREE.MeshBasicMaterial({color:0x120E1E}));
    fan.position.set(-15.75,6.5,-13.28); arena.add(fan);
    const hub=new THREE.Mesh(new THREE.CircleGeometry(0.15,10),
      new THREE.MeshBasicMaterial({color:0x3E3560}));
    hub.position.set(-15.75,6.5,-13.26); arena.add(hub);
  }

  B(arena,0.36,9.4,0.36,-3.4,5.1,-13.72,0x241C38,{outline:false});
  B(arena,6.4,0.36,0.36,-0.3,7.3,-13.72,0x241C38,{outline:false});
  B(arena,0.54,0.28,0.54,-3.4,2.2,-13.72,0x2E2444,{outline:false});
  B(arena,0.54,0.28,0.54,-3.4,5.8,-13.72,0x2E2444,{outline:false});
  B(arena,0.90,1.10,0.50,2.5,6.1,-13.76,0x2A2344,{outline:false});
  B(arena,0.22,4.0,0.22,2.5,3.6,-13.74,0x241C38,{outline:false});

  /* security camera, angled down at the ring */
  B(arena,0.44,0.44,0.44,12.6,8.0,-13.85,0x241E36,{outline:false});
  B(arena,0.66,0.32,0.94,12.6,7.62,-13.16,0x1C1730,{outline:false,rx:0.34});
  B(arena,0.24,0.24,0.10,12.6,7.44,-12.72,0x08060F,{outline:false});

  /* posters, drawn straight onto a canvas so they cost one call each */
  const poster=(w,h,x,y,z,draw)=>{
    const cv=document.createElement('canvas'); cv.width=128; cv.height=160;
    draw(cv.getContext('2d'));
    const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),
      new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv)}));
    m.position.set(x,y,z); arena.add(m); return m;
  };
  poster(1.05,1.35,-17.8,4.3,-13.94,(c)=>{
    c.fillStyle='#E4DEEE'; c.fillRect(0,0,128,160);
    c.fillStyle='#B0263C'; c.fillRect(0,0,128,26);
    c.fillStyle='#F7EEDF'; c.font='700 17px Impact'; c.textAlign='center';
    c.fillText('MISSING',64,19);
    c.fillStyle='#2A2438'; c.fillRect(26,36,76,74);
    c.fillStyle='#5A4E8A'; c.beginPath(); c.arc(64,62,17,0,7); c.fill();
    c.fillRect(46,82,36,24);
    c.fillStyle='#3A3450'; c.fillRect(18,120,92,4); c.fillRect(18,131,66,4);
  });
  poster(1.45,0.98,4.7,4.7,-13.94,(c)=>{
    c.fillStyle='#100A1C'; c.fillRect(0,0,128,160);
    c.fillStyle='#5BE7FF'; c.font='700 24px Impact'; c.textAlign='center';
    c.fillText('2 FOR 1',64,44);
    c.fillStyle='#FF7AC6'; c.font='700 13px monospace';
    c.fillText('ALL NIGHT',64,70);
    c.fillStyle='#F3E7D3'; c.font='700 30px Impact';
    c.fillText('CHOG',64,116);
  });

  /* a tag on the lower wall */
  {
    const cv=document.createElement('canvas'); cv.width=256; cv.height=128;
    const c=cv.getContext('2d'); c.lineCap='round';
    c.strokeStyle='#9B59FF'; c.lineWidth=8;
    c.beginPath(); c.moveTo(22,90); c.quadraticCurveTo(52,26,86,86);
    c.quadraticCurveTo(112,34,142,88); c.stroke();
    c.strokeStyle='#FF7AC6'; c.lineWidth=7;
    c.beginPath(); c.moveTo(166,40); c.lineTo(206,94);
    c.moveTo(206,40); c.lineTo(166,94); c.stroke();
    const m=new THREE.Mesh(new THREE.PlaneGeometry(4.0,2.0),
      new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv),transparent:true}));
    m.position.set(-11.6,2.5,-13.94); arena.add(m);
  }

  /* --- floor: drain, manhole, oil, cracks, litter --- */
  B(arena,1.9,0.10,1.4,3.2,0.055,10.5,0x0E0B18,{outline:false,shadow:false});
  for(let i=0;i<5;i++) B(arena,1.8,0.05,0.12,3.2,0.10,9.96+i*0.28,0x2A2438,{outline:false,shadow:false});

  {
    const man=new THREE.Mesh(new THREE.CircleGeometry(0.85,20),
      new THREE.MeshLambertMaterial({color:0x2A2340}));
    man.rotation.x=-Math.PI/2; man.position.set(-6.5,0.055,4.5); arena.add(man);
    const rim=new THREE.Mesh(new THREE.RingGeometry(0.85,0.99,20),
      new THREE.MeshLambertMaterial({color:0x3A3156}));
    rim.rotation.x=-Math.PI/2; rim.position.set(-6.5,0.056,4.5); arena.add(rim);
  }

  /* these were at 0.42 opacity and read as holes punched in the floor - the
     exact thing the player is trained to read as "danger". They are stains. */
  const oil=new THREE.MeshBasicMaterial({color:0x1A1329,transparent:true,opacity:0.16});
  [[-9,12,1.7],[7,-4,1.3],[-2,-8,1.1],[13,14,1.5]].forEach(([x,z,r])=>{
    const m=new THREE.Mesh(new THREE.CircleGeometry(r,16),oil);
    m.rotation.x=-Math.PI/2; m.position.set(x,0.052,z); arena.add(m);
  });

  const crackMat=new THREE.MeshBasicMaterial({color:0x0C0A16});
  [[-4,4,3.2,0.5],[-13,9,2.4,-0.9],[10,7,3.0,1.4],[2,15,2.2,0.2]].forEach(([x,z,len,rot])=>{
    const m=new THREE.Mesh(new THREE.PlaneGeometry(len,0.09),crackMat);
    m.rotation.x=-Math.PI/2; m.rotation.z=rot;
    m.position.set(x,0.053,z); arena.add(m);
  });

  {
    const canMat=new THREE.MeshLambertMaterial({color:0xB8C4D8});
    [[-7.4,7.2,0.5],[-7.0,7.7,-1.1],[11.5,3.2,2.0],[12.1,3.8,0.4],[-2.6,11.4,1.6]]
      .forEach(([x,z,rot])=>{
        const m=new THREE.Mesh(new THREE.CylinderGeometry(0.14,0.14,0.34,10),canMat);
        m.rotation.z=Math.PI/2; m.rotation.y=rot;
        m.position.set(x,0.15,z); arena.add(m);
      });
  }

  {
    const paper=new THREE.MeshBasicMaterial({color:0xD6D0E4,side:THREE.DoubleSide});
    [[-1.2,6.5,0.9],[-1.7,6.2,-0.4],[8.4,12.0,1.7],[9.0,12.4,0.3],[-11.0,-2.0,1.1]]
      .forEach(([x,z,rot])=>{
        const m=new THREE.Mesh(new THREE.PlaneGeometry(0.50,0.34),paper);
        m.rotation.x=-Math.PI/2; m.rotation.z=rot;
        m.position.set(x,0.056,z); arena.add(m);
      });
  }

  /* --- props: cart, cone, wet-floor sign, pallet, bollards --- */
  {
    const cart=new THREE.Group(); cart.position.set(-16.2,0,16.2); cart.rotation.y=0.5;
    arena.add(cart);
    const w=0x8E96AE, d=0x6E7690;
    B(cart,1.40,0.06,0.90,0,0.98,0,w,{outline:false});
    B(cart,1.40,0.06,0.90,0,0.64,0,w,{outline:false});
    B(cart,0.06,0.06,0.90,-0.70,0.81,0,w,{outline:false});
    B(cart,0.06,0.06,0.90, 0.70,0.81,0,w,{outline:false});
    B(cart,1.40,0.06,0.06,0,0.81,-0.45,w,{outline:false});
    B(cart,1.40,0.06,0.06,0,0.81, 0.45,w,{outline:false});
    B(cart,0.06,0.92,0.06,-0.70,0.33, 0.45,d,{outline:false});
    B(cart,0.06,0.92,0.06,-0.70,0.33,-0.45,d,{outline:false});
    B(cart,0.06,0.92,0.06, 0.70,0.33, 0.45,d,{outline:false});
    B(cart,0.06,0.92,0.06, 0.70,0.33,-0.45,d,{outline:false});
  }
  {
    const cone=new THREE.Mesh(new THREE.ConeGeometry(0.42,0.95,10),
      new THREE.MeshLambertMaterial({color:0xE8622E}));
    cone.position.set(13.6,0.48,-8.4); cone.castShadow=true; arena.add(cone);
    B(arena,0.92,0.10,0.92,13.6,0.05,-8.4,0xC24F22,{outline:false});
  }
  {
    const sign2=new THREE.Group(); sign2.position.set(7.6,0,16.4); sign2.rotation.y=-0.35;
    arena.add(sign2);
    B(sign2,0.70,1.00,0.06,0,0.52, 0.13,0xE0A81C,{outline:false,rx: 0.20});
    B(sign2,0.70,1.00,0.06,0,0.52,-0.13,0xE0A81C,{outline:false,rx:-0.20});
  }
  {
    B(arena,2.2,0.10,1.4,-17.4,0.10,4.2,0x5E4A2C,{outline:false});
    for(let i=0;i<5;i++) B(arena,2.2,0.08,0.18,-17.4,0.20,3.62+i*0.30,0x6B5330,{outline:false});
    B(arena,1.1,0.9,1.0,-17.4,0.72,4.2,0x2E2246,{outline:false});
  }
  for(let i=0;i<3;i++){
    B(arena,0.26,1.00,0.26,-14+i*3.2,0.50,19.6,0x2A2438,{outline:false});
    B(arena,0.34,0.10,0.34,-14+i*3.2,1.02,19.6,0x9B59FF,{outline:false,glow:true,shadow:false});
  }

  /* --- a run of string lights from the lamp to the wall --- */
  {
    const a=new THREE.Vector3(20.6,10.7,-2.2), b2=new THREE.Vector3(12.6,8.5,-13.4);
    const pts=[];
    for(let i=1;i<7;i++){
      const t=i/7, q=a.clone().lerp(b2,t);
      q.y-=Math.sin(t*Math.PI)*1.6;
      pts.push(q);
      B(arena,0.10,0.10,0.10,q.x,q.y,q.z,0xFFE9C9,{outline:false,glow:true,shadow:false});
    }
    for(let i=0;i<pts.length-1;i++){
      const mid=pts[i].clone().add(pts[i+1]).multiplyScalar(0.5);
      const len=pts[i].distanceTo(pts[i+1]);
      const seg=new THREE.Mesh(boxGeo(0.03,0.03,len), mat(0x1A1528));
      seg.position.copy(mid); seg.lookAt(pts[i+1]); arena.add(seg);
    }
  }

  /* a low kerb marks the edge of the block. Without it the floor reads as an
     endless plain and you cannot tell where the fight stops. */
  B(arena,0.5,0.36,34.0, 21.2,0.18,4.2,0x241C38,{outline:false});
  B(arena,0.5,0.36,34.0,-21.2,0.18,4.2,0x241C38,{outline:false});
  B(arena,43.0,0.36,0.5,0.0,0.18,21.4,0x241C38,{outline:false});
  /* and a couple of glowing studs so the edge is visible at night */
  for(let i=-3;i<=3;i++){
    B(arena,0.30,0.10,0.30,i*6.0,0.40,21.4,0x6B3BFF,{outline:false,glow:true,shadow:false});
  }

  /* a breath of depth haze so the far wall sits back */
  scene.fog=new THREE.Fog(0x140F26, 42, 104);

  /* lighting */
  arena.add(new THREE.AmbientLight(0x5A4E8A,0.58));
  arena.add(new THREE.HemisphereLight(0x7A66B8,0x160E24,1.10));
  const sun=new THREE.DirectionalLight(0xBFA8FF,0.95);
  sun.position.set(16,34,20); sun.castShadow=true;
  sun.shadow.mapSize.set(2048,2048);
  const d=30;
  sun.shadow.camera.left=-d; sun.shadow.camera.right=d;
  sun.shadow.camera.top=d; sun.shadow.camera.bottom=-d;
  sun.shadow.camera.far=120; sun.shadow.bias=-0.0009;
  sun.shadow.camera.updateProjectionMatrix();
  arena.add(sun);
  lightAt(0xFF7AC6,0.9,26,-10,6,-10);
}
function lightAt(color,intensity,dist,x,y,z){
  const l=new THREE.PointLight(color,intensity,dist,2);
  l.position.set(x,y,z); arena.add(l); return l;
}
buildArena();

/* -------------------------------- the sky --------------------------------
   The alley used to sit in flat black, which reads as "nothing has been built
   out there yet". A gradient dome, a city behind the wall and a scatter of
   stars cost three draw calls and give the block somewhere to be.
   ---------------------------------------------------------------------- */
function buildSky(){
  /* --- gradient dome --- */
  const cv=document.createElement('canvas'); cv.width=8; cv.height=256;
  const c=cv.getContext('2d');
  const gr=c.createLinearGradient(0,0,0,256);
  gr.addColorStop(0.00,'#05030C');
  gr.addColorStop(0.42,'#100A20');
  gr.addColorStop(0.72,'#20143A');
  gr.addColorStop(0.89,'#33204F');
  gr.addColorStop(1.00,'#452862');
  c.fillStyle=gr; c.fillRect(0,0,8,256);
  const dome=new THREE.Mesh(new THREE.SphereGeometry(150,24,16),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv), side:THREE.BackSide,
      fog:false, depthWrite:false}));
  scene.add(dome);

  /* --- stars, only in the upper half --- */
  const pos=[];
  for(let i=0;i<220;i++){
    const a=Math.random()*Math.PI*2;
    const y=0.18+Math.random()*0.78;
    const r=Math.sqrt(Math.max(0,1-y*y));
    pos.push(Math.cos(a)*r*132, y*132, Math.sin(a)*r*132);
  }
  const sg=new THREE.BufferGeometry();
  sg.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));
  scene.add(new THREE.Points(sg,new THREE.PointsMaterial({
    color:0xDCD6FF, size:2.1, sizeAttenuation:false,
    transparent:true, opacity:0.9, fog:false, depthWrite:false})));

  /* --- the city behind the wall --- */
  const cv2=document.createElement('canvas'); cv2.width=1024; cv2.height=512;
  const c2=cv2.getContext('2d');
  let x=0;
  while(x<1024){
    const w=22+Math.random()*46;
    const h=80+Math.random()*190;
    c2.fillStyle = Math.random()<0.5 ? '#080511' : '#0A0716';
    c2.fillRect(x, 512-h, w, h);
    if(Math.random()<0.4) c2.fillRect(x+w*0.36, 512-h-14, 3, 14);   /* antenna */
    for(let wy=512-h+12; wy<500; wy+=13){
      for(let wx=x+5; wx<x+w-8; wx+=10){
        if(Math.random()<0.38){
          c2.fillStyle = Math.random()<0.70 ? '#FFC98A' : '#8FE3FF';
          c2.globalAlpha = 0.14+Math.random()*0.30;
          c2.fillRect(wx,wy,4,6);
          c2.globalAlpha = 1;
        }
      }
    }
    x += w + 2 + Math.random()*10;
  }
  const city=new THREE.Mesh(new THREE.PlaneGeometry(230,40),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv2),
      transparent:true, fog:true, depthWrite:false}));
  city.position.set(0,20,-40);
  scene.add(city);
}
buildSky();

/* ---------------------------- the Chog ---------------------------------
   Ported verbatim from the brawl's buildViber(), customSculpt:'spiky'.
   Same engine (r128), so the sculpt is identical to the shipped character.
   ---------------------------------------------------------------------- */
const CHOG_DEF={
  colors:{ head:0x6B42B8, headShade:0x58339E, body:0x673FB4, arm:0x673FB4,
           foot:0x6239AD, belt:0x522E96, dark:0x15121D, visor:0xF2C2A2,
           eye:0xFFFFFF, accent:0x9B59FF, boot:0x5A34A2, blush:0xDF7382, nose:0xD67A7C },
  speed:13.2, jump:17.8, health:105
};

function buildChog(){
  const C=CHOG_DEF.colors;
  const mats=[];
  function M(color,opts){
    const m=new THREE.MeshLambertMaterial(Object.assign({color},opts||{}));
    m.userData.baseEmissive=m.emissive?m.emissive.getHex():0x000000;
    mats.push(m); return m;
  }
  const root=new THREE.Group();
  const bodyPivot=new THREE.Group();
  root.add(bodyPivot);

  const headMat=M(C.head), shadeMat=M(C.headShade), bodyMat=M(C.body), armMat=M(C.arm),
        footMat=M(C.foot), bootMat=M(C.boot), beltMat=M(C.belt), darkMat=M(C.dark),
        skinMat=M(C.visor,{emissive:C.visor,emissiveIntensity:0.14}),
        blushMat=M(C.blush,{emissive:C.blush,emissiveIntensity:0.22}),
        noseMat=M(C.nose,{emissive:C.nose,emissiveIntensity:0.22}),
        whiteMat=M(0xFFFFFF,{emissive:0xFFFFFF,emissiveIntensity:0.65});

  function addB(grp,w,h,d,m,x,y,z,outline){
    const b=mkBox(w,h,d,m,outline!==false);
    b.position.set(x||0,y||0,z||0);
    grp.add(b); return b;
  }

  const legL=new THREE.Group(), legR=new THREE.Group();
  legL.position.set(-0.28,0.66,0); legR.position.set(0.28,0.66,0);
  bodyPivot.add(legL,legR);
  for(const lg of [legL,legR]){
    addB(lg,0.42,0.50,0.46,footMat,0,-0.25,-0.02,true);
    addB(lg,0.43,0.16,0.56,bootMat,0,-0.58,0.03,true);
  }
  addB(bodyPivot,1.16,0.82,0.86,bodyMat,0,1.15,0.02,true);
  addB(bodyPivot,1.06,0.10,0.78,beltMat,0,0.69,0.02,true);
  addB(bodyPivot,1.00,0.74,0.12,shadeMat,0,1.15,-0.46,true);
  addB(bodyPivot,1.08,0.12,0.80,beltMat,0,1.61,0.02,true);

  const armL=new THREE.Group(), armR=new THREE.Group();
  armL.position.set(-0.80,1.48,0.02); armR.position.set(0.80,1.48,0.02);
  bodyPivot.add(armL,armR);
  function mkVoxelArm(grp,sx){
    addB(grp,0.34,0.09,0.40,shadeMat,0,0.045,0,true);
    addB(grp,0.40,0.64,0.46,armMat,0,-0.32,0,true);
    addB(grp,0.36,0.07,0.42,beltMat,0,-0.675,0,true);
    addB(grp,0.36,0.09,0.42,skinMat,0,-0.755,0,true);
    addB(grp,0.12,0.16,0.42,skinMat,sx*0.12,-0.88,0,true);
    addB(grp,0.26,0.08,0.42,skinMat,sx*0.05,-0.98,0,true);
  }
  mkVoxelArm(armL,-1); mkVoxelArm(armR,1);

  const head=new THREE.Group(); head.position.y=2.38; bodyPivot.add(head);
  addB(head,1.76,1.44,1.44,headMat,0,0,-0.06,true);
  addB(head,1.62,0.09,1.48,shadeMat,0,-0.765,-0.04,true);
  addB(head,1.62,0.10,1.42,headMat,0,0.77,-0.05,true);
  addB(head,1.36,1.06,0.08,skinMat,0,-0.04,0.67,true);
  addB(head,1.76,0.25,0.18,headMat,0,0.595,0.75,true);
  addB(head,1.76,0.17,0.18,headMat,0,-0.635,0.75,true);
  for(const sx of [-1,1]) addB(head,0.20,1.06,0.18,headMat,sx*0.78,-0.04,0.75,true);
  addB(head,0.62,0.10,0.16,headMat,0,0.43,0.74,true);
  addB(head,0.38,0.10,0.16,headMat,0,0.34,0.74,true);
  addB(head,0.18,0.10,0.16,headMat,0,0.25,0.74,true);
  for(const sx of [-1,1]){
    const ex=sx*0.36, ey=-0.01;
    addB(head,0.40,0.24,0.06,darkMat,ex,ey,0.715,false);
    addB(head,0.30,0.36,0.06,darkMat,ex,ey,0.715,false);
    addB(head,0.20,0.42,0.06,darkMat,ex,ey,0.715,false);
    addB(head,0.13,0.13,0.04,whiteMat,ex+0.05,ey+0.06,0.745,false);
    addB(head,0.055,0.13,0.04,whiteMat,ex-0.145,ey+0.02,0.745,false);
    addB(head,0.06,0.06,0.04,whiteMat,ex-0.05,ey-0.10,0.745,false);
    addB(head,0.055,0.055,0.04,whiteMat,ex+0.13,ey-0.09,0.745,false);
    addB(head,0.22,0.13,0.05,blushMat,sx*0.55,-0.22,0.715,false);
  }
  addB(head,0.16,0.19,0.26,noseMat,0,-0.15,0.85,true);
  addB(head,0.14,0.06,0.05,darkMat,0,-0.34,0.72,false);
  for(const sx of [-1,1]) addB(head,0.06,0.08,0.05,darkMat,sx*0.09,-0.28,0.72,false);

  const cTiers=[[0.58,0.14,0.56,0.89,0.06],[0.50,0.14,0.48,1.03,0.02],[0.42,0.14,0.40,1.17,-0.02],[0.34,0.14,0.32,1.31,-0.06],[0.26,0.14,0.24,1.45,-0.10]];
  for(const [w,h,d,py,pz] of cTiers) addB(head,w,h,d,headMat,0,py,pz,true);
  const sTiers=[[0.38,0.13,0.44,0.885,0.04],[0.35,0.13,0.38,1.015,0.00],[0.31,0.13,0.32,1.145,-0.04],[0.27,0.13,0.26,1.275,-0.08]];
  for(const sx of [-1,1]) for(const [w,h,d,py,pz] of sTiers) addB(head,w,h,d,headMat,sx*0.56,py,pz,true);
  for(const sx of [-1,1]){
    addB(head,0.14,0.56,0.56,headMat,sx*0.95,0.36,-0.04,true);
    addB(head,0.12,0.44,0.44,headMat,sx*1.08,0.42,-0.04,true);
    addB(head,0.10,0.30,0.32,headMat,sx*1.19,0.48,-0.04,true);
    addB(head,0.12,0.42,0.48,headMat,sx*0.94,-0.16,-0.04,true);
    addB(head,0.10,0.30,0.36,headMat,sx*1.05,-0.12,-0.04,true);
    addB(head,0.08,0.18,0.24,headMat,sx*1.14,-0.08,-0.04,true);
  }
  addB(head,0.92,0.24,0.28,headMat,0,0.78,-0.62,true);
  addB(head,0.64,0.24,0.26,headMat,0,0.96,-0.52,true);
  addB(head,0.42,0.20,0.22,headMat,0,1.12,-0.42,true);
  addB(head,1.26,0.72,0.16,headMat,0,0.20,-0.86,true);
  addB(head,0.98,0.96,0.16,headMat,0,0.16,-0.86,true);
  addB(head,0.72,1.14,0.16,headMat,0,0.08,-0.86,true);
  addB(head,0.44,1.28,0.16,headMat,0,0.00,-0.86,true);
  addB(head,0.94,0.58,0.16,shadeMat,0,0.24,-1.02,true);
  addB(head,0.68,0.84,0.16,headMat,0,0.18,-1.02,true);
  addB(head,0.44,1.04,0.16,headMat,0,0.10,-1.02,true);
  addB(head,0.34,0.74,0.14,headMat,0,0.34,-1.16,true);
  addB(head,0.24,0.46,0.10,shadeMat,0,0.36,-1.25,true);

  root.scale.setScalar(0.8);
  return {root,bodyPivot,head,mats,legL,legR,armL,armR};
}

/* ---------------------------- the machine ------------------------------
   Rebuilt for realism. A real vending machine is not a red box: it is painted
   steel with chrome trim, a backlit header, a lit interior behind glass, a
   payment column and a delivery flap. Three changes carry the look:

     1. PBR materials (roughness + metalness) instead of flat Lambert, so the
        paint has a sheen and the trim is genuinely chrome.
     2. An environment map (scene.environment, built above). A metalness=1
        material with nothing to reflect renders black — that is exactly why
        the old machine had no highlight anywhere.
     3. Its own lights: a tube inside the cabinet lighting the stock from
        within, a header glow spilling onto the asphalt, and a cool rim to
        separate the silhouette from the near-black wall behind it.
   ---------------------------------------------------------------------- */

/* the header: frosted plastic with a hot tube behind it */
function lightboxTex(text){
  const cv=document.createElement('canvas'); cv.width=512; cv.height=160;
  const c=cv.getContext('2d');
  const g=c.createLinearGradient(0,0,0,160);
  g.addColorStop(0,'#FFE9F5'); g.addColorStop(0.5,'#FFF7FC'); g.addColorStop(1,'#FFD2E6');
  c.fillStyle=g; c.fillRect(0,0,512,160);
  const core=c.createRadialGradient(256,84,6,256,84,250);
  core.addColorStop(0,'rgba(255,255,255,0.95)');
  core.addColorStop(1,'rgba(255,255,255,0)');
  c.fillStyle=core; c.fillRect(0,0,512,160);
  c.fillStyle='#C11F3E';
  c.font='700 104px Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif';
  c.textAlign='center'; c.textBaseline='middle';
  c.fillText(text,256,88);
  const t=new THREE.CanvasTexture(cv); t.anisotropy=4; return t;
}

/* the little green price display on the payment column */
function ledTex(text){
  const cv=document.createElement('canvas'); cv.width=128; cv.height=48;
  const c=cv.getContext('2d');
  c.fillStyle='#06120A'; c.fillRect(0,0,128,48);
  c.fillStyle='#5CFF9E';
  c.font='700 34px "Courier New", monospace';
  c.textAlign='right'; c.textBaseline='middle';
  c.fillText(text,118,26);
  const t=new THREE.CanvasTexture(cv); t.anisotropy=4; return t;
}

/* The crack sheet that appears a beat before the pane lets go: a radial
   fracture from one impact point, plus the concentric rings that a real
   tempered pane throws. Drawn once, revealed by opacity. */
function crackTex(){
  const cv=document.createElement('canvas'); cv.width=256; cv.height=420;
  const c=cv.getContext('2d');
  c.clearRect(0,0,256,420);
  const cx=150, cy=196;
  c.strokeStyle='rgba(214,232,255,0.80)';
  c.lineWidth=1.25; c.lineCap='round';
  const N=21;
  for(let i=0;i<N;i++){
    const a=(i/N)*Math.PI*2 + rand(-0.12,0.12);
    let x=cx, y=cy, r=0;
    c.beginPath(); c.moveTo(x,y);
    const steps=4+((Math.random()*3)|0);
    for(let k=0;k<steps;k++){
      const seg=rand(10,34);
      r+=seg;
      const jitter=rand(-0.22,0.22);
      x=cx+Math.cos(a+jitter)*r;
      y=cy+Math.sin(a+jitter)*r;
      c.lineTo(x,y);
    }
    c.stroke();
  }
  /* concentric fracture rings */
  for(let ring=1;ring<=3;ring++){
    c.beginPath();
    const rr=ring*32+rand(-8,8);
    for(let i=0;i<=N;i++){
      const a=(i/N)*Math.PI*2;
      const j=rand(-7,7);
      const x=cx+Math.cos(a)*(rr+j), y=cy+Math.sin(a)*(rr+j);
      if(i===0) c.moveTo(x,y); else c.lineTo(x,y);
    }
    c.closePath();
    c.globalAlpha=0.40-ring*0.10; c.stroke(); c.globalAlpha=1;
  }
  /* the impact star */
  c.fillStyle='rgba(240,250,255,0.9)';
  c.beginPath(); c.arc(cx,cy,5,0,7); c.fill();
  c.strokeStyle='rgba(255,255,255,0.9)'; c.lineWidth=1.4;
  for(let i=0;i<9;i++){
    const a=rand(0,7);
    c.beginPath(); c.moveTo(cx,cy);
    c.lineTo(cx+Math.cos(a)*rand(16,52), cy+Math.sin(a)*rand(16,52));
    c.stroke();
  }
  const t=new THREE.CanvasTexture(cv); t.anisotropy=4; return t;
}

/* Glass only reads as glass if something is reflected in it. Without SSR the
   honest cheap trick is a painted glare: two soft diagonal bands plus a hard
   streak at the edge, additively blended over the pane. */
function glareTex(){
  const cv=document.createElement('canvas'); cv.width=256; cv.height=384;
  const c=cv.getContext('2d');
  c.clearRect(0,0,256,384);
  function band(x0,w,alpha){
    const g=c.createLinearGradient(x0,0,x0+w,384);
    g.addColorStop(0,'rgba(255,255,255,0)');
    g.addColorStop(0.35,'rgba(255,255,255,'+alpha+')');
    g.addColorStop(0.5,'rgba(255,255,255,'+(alpha*0.55)+')');
    g.addColorStop(1,'rgba(255,255,255,0)');
    c.fillStyle=g;
    c.beginPath();
    c.moveTo(x0,0); c.lineTo(x0+w,0); c.lineTo(x0+w-90,384); c.lineTo(x0-90,384);
    c.closePath(); c.fill();
  }
  band(20,54,0.30);
  band(96,20,0.16);
  /* a faint reflection of the shop sign, smeared down the pane */
  const g2=c.createRadialGradient(210,60,4,210,60,90);
  g2.addColorStop(0,'rgba(255,214,236,0.22)');
  g2.addColorStop(1,'rgba(255,214,236,0)');
  c.fillStyle=g2; c.fillRect(0,0,256,384);
  const t=new THREE.CanvasTexture(cv); t.anisotropy=4; return t;
}

/* soft radial falloff, used for the pool of light on the asphalt */
function radialTex(hex){
  const cv=document.createElement('canvas'); cv.width=cv.height=128;
  const c=cv.getContext('2d');
  const col=new THREE.Color(hex);
  const r=(col.r*255)|0, g2=(col.g*255)|0, b=(col.b*255)|0;
  const g=c.createRadialGradient(64,64,0,64,64,64);
  g.addColorStop(0,   'rgba('+r+','+g2+','+b+',0.90)');
  g.addColorStop(0.42,'rgba('+r+','+g2+','+b+',0.34)');
  g.addColorStop(1,   'rgba('+r+','+g2+','+b+',0)');
  c.fillStyle=g; c.fillRect(0,0,128,128);
  return new THREE.CanvasTexture(cv);
}

function buildMachine(){
  const g=new THREE.Group();
  /* Everything hangs off `rock`, whose origin sits on the REAR BOTTOM EDGE of
     the cabinet. Rotating it therefore tips the machine over that edge instead
     of spinning it about its middle, which is what a heavy box actually does. */
  const rock=new THREE.Group();
  rock.position.set(0,0,-0.75);
  g.add(rock);
  const shell=new THREE.Group();
  shell.position.z=0.75;
  rock.add(shell);
  const mats=[];

  /* PBR. roughness is what separates painted steel (0.4) from chrome (0.2)
     from rubber (0.9); metalness is what makes a surface take its colour from
     the reflection rather than from the light. */
  function P(color,rough,metal,opts){
    const m=new THREE.MeshStandardMaterial(Object.assign({
      color, roughness:rough, metalness:metal, envMapIntensity:1.0
    },opts||{}));
    m.userData.base=m.emissive.getHex();
    mats.push(m); return m;
  }
  const paint   =P(0x8A2434,0.34,0.26);
  const paintDk =P(0x5E1626,0.44,0.28);
  const paintLt =P(0xA32C40,0.30,0.24);
  const chrome  =P(0xC6CBD4,0.20,1.00,{envMapIntensity:1.5});
  const steelDk =P(0x2C2E36,0.44,0.85);
  const rubber  =P(0x121317,0.92,0.02);
  const inner   =P(0xC9CED8,0.62,0.06);
  const canCols =[0xE8344E,0x2FA8E0,0xE8A020,0x3FB04A,0x8A4AE0];
  const canMats =canCols.map(c=>P(c,0.40,0.30,{
    emissive:new THREE.Color(c).multiplyScalar(0.14)
  }));

  /* outline defaults OFF. The heavy black edge that suits the voxel fighters
     makes a real cabinet look like a cartoon; panel gaps do the job instead. */
  function bx(grp,w,h,d,m,x,y,z,outline){
    const b=mkBox(w,h,d,m,outline===true);
    b.position.set(x||0,y||0,z||0);
    grp.add(b); return b;
  }

  /* ---------------- feet ---------------- */
  const footL=new THREE.Group(), footR=new THREE.Group();
  footL.position.set(-0.72,0,0.06); footR.position.set(0.72,0,0.06);
  shell.add(footL,footR);
  for(const f of [footL,footR]){
    bx(f,0.60,0.26,0.84,steelDk,0,0.31,0);
    bx(f,0.68,0.09,0.92,rubber,0,0.135,0);
    bx(f,0.72,0.04,0.96,chrome,0,0.205,0);
  }

  /* ---------------- cabinet ---------------- */
  const W=2.4, D=1.5;
  bx(shell,2.10,0.42,1.20,steelDk,0,0.51,0);            /* plinth      */

  /* The cabinet is built as PANELS, not a solid block. A solid box seals the
     window: the stock sits inside it and you can never see a can, no matter
     how clear the glass is. Five panels plus front fillers leave a real
     opening, so the shelf is genuinely inside a hollow machine. */
  bx(shell,W,4.40,0.10,paint,0,2.92,-0.70);             /* back        */
  bx(shell,0.12,4.40,D,paint,-1.14,2.92,0);             /* left wall   */
  bx(shell,0.12,4.40,D,paint, 1.14,2.92,0);             /* right wall  */
  bx(shell,W-0.24,0.12,D,paint,0,5.06,0);               /* roof        */
  bx(shell,W-0.24,0.12,D,paint,0,0.78,0);               /* floor       */
  /* front fillers around the window opening */
  bx(shell,W-0.24,0.37,0.08,paint,0,4.815,0.71);        /* above       */
  bx(shell,W-0.24,1.13,0.08,paint,0,1.405,0.71);        /* below       */
  bx(shell,0.58,2.66,0.08,paint,0.79,3.30,0.71);        /* right of it */

  bx(shell,0.02,4.06,1.34,paintDk,-W/2-0.006,2.92,0);   /* side seam   */
  bx(shell,0.02,4.06,1.34,paintDk, W/2+0.006,2.92,0);
  bx(shell,W-0.06,0.04,D+0.02,paintDk,0,0.735,0);
  bx(shell,W-0.06,0.04,D+0.02,paintDk,0,5.105,0);
  /* ---------------- the back ----------------
     This side is now a damage multiplier, so it cannot be a blank slab: a
     service panel, a grille, a power inlet and a serial sticker give the eye
     something to read and tell you at a glance that you are behind it. */
  bx(shell,1.16,1.52,0.05,paintDk,0,3.30,-0.735);
  bx(shell,1.02,0.30,0.06,P(0x1A1C22,0.80,0.10),0,3.86,-0.745);
  for(const sx of [-1,1]) for(const sy of [1,2]){
    bx(shell,0.055,0.055,0.04,chrome,sx*0.50,3.30+sy*0.58,-0.755);
  }
  /* ventilation grille */
  for(let i=0;i<7;i++) bx(shell,0.86,0.045,0.03,steelDk,0,1.28+i*0.10,-0.752);
  /* power inlet and its cable, running off to the ground */
  bx(shell,0.30,0.34,0.14,steelDk,0.72,1.10,-0.79);
  bx(shell,0.16,0.16,0.06,P(0x0B0C10,0.85,0.05),0.72,1.10,-0.86);
  bx(shell,0.11,0.95,0.11,P(0x14151A,0.90,0.03),0.72,0.60,-0.86,false);
  /* serial sticker */
  bx(shell,0.34,0.20,0.01,P(0xE8E2D0,0.75,0.05),-0.55,1.16,-0.756);
  bx(shell,0.30,0.035,0.005,P(0x1A1C22,0.80,0.05),-0.55,1.20,-0.762);

  /* corner wear: real cabinets are scuffed at the bottom, not pristine */
  for(let i=0;i<9;i++)
    bx(shell,rand(0.06,0.20),0.012,0.012,chrome,rand(-1.05,1.05),rand(0.76,0.94),0.756);

  /* side vents, on their own material so they can glow when it overheats */
  const ventMat=P(0x2C2E36,0.44,0.85);
  for(let i=0;i<8;i++) bx(shell,0.02,0.09,0.86,ventMat,-W/2-0.02,2.02+i*0.34,-0.06);

  /* ---------------- header lightbox ---------------- */
  bx(shell,2.46,1.02,1.34,paintDk,0,5.68,0.02);
  bx(shell,2.34,0.92,0.05,chrome,0,5.68,0.695);
  const lb=new THREE.Mesh(new THREE.PlaneGeometry(2.20,0.78),
    new THREE.MeshBasicMaterial({map:lightboxTex('SNAX'),toneMapped:false}));
  lb.position.set(0,5.68,0.725);
  shell.add(lb);

  /* ---------------- delivery flap ----------------
     A real flap is a recess with a rubber curtain inside it. It now sits on a
     pivot at its top edge, because it bangs open as the tell for a can volley
     and a flat box cannot swing. */
  bx(shell,1.64,0.62,0.16,rubber,0,1.36,0.70);
  const flap=new THREE.Group();
  flap.position.set(0,1.64,0.775);
  shell.add(flap);
  bx(flap,1.50,0.46,0.03,steelDk,0,-0.24,0);
  bx(flap,1.50,0.44,0.06,P(0x1A1C22,0.75,0.10),0,-0.28,-0.02);
  bx(shell,1.66,0.06,0.14,chrome,0,1.09,0.775);

  /* ---------------- lit interior behind the glass ---------------- */
  const cavityMat=P(0x9AA0AE,0.70,0.10);
  const backPanel=bx(shell,1.72,3.26,0.06,cavityMat,-0.28,3.28,0.02);
  /* the light in a real cabinet falls off down the back wall */
  const fallCv=document.createElement('canvas'); fallCv.width=8; fallCv.height=128;
  const fc=fallCv.getContext('2d');
  const fg=fc.createLinearGradient(0,0,0,128);
  fg.addColorStop(0,'rgba(255,255,255,0.55)');
  fg.addColorStop(0.45,'rgba(255,255,255,0.18)');
  fg.addColorStop(1,'rgba(0,0,0,0.35)');
  fc.fillStyle=fg; fc.fillRect(0,0,8,128);
  const fallTex=new THREE.CanvasTexture(fallCv);
  const fall=new THREE.Mesh(new THREE.PlaneGeometry(1.70,3.24),
    new THREE.MeshBasicMaterial({map:fallTex,transparent:true,opacity:0.55,
      depthWrite:false,toneMapped:false}));
  fall.position.set(-0.28,3.28,0.055);
  shell.add(fall);
  for(let i=0;i<5;i++){
    const sy=1.95+i*0.72;
    bx(shell,1.86,0.040,0.30,chrome,-0.28,sy,0.60);
    bx(shell,1.86,0.075,0.02,steelDk,-0.28,sy+0.020,0.755);  /* price rail */
    for(let k=0;k<4;k++)
      bx(shell,0.15,0.055,0.01,P(0xF0EAD8,0.70,0.05),-0.88+k*0.38,sy+0.024,0.768);
  }
  /* the tube the stock is lit by */
  const tubeMat=new THREE.MeshBasicMaterial({color:0xF2F7FF,toneMapped:false});
  const tube=new THREE.Mesh(new THREE.BoxGeometry(1.52,0.045,0.045),tubeMat);
  tube.position.set(-0.28,4.44,0.50); shell.add(tube);
  const tube2=new THREE.Mesh(new THREE.BoxGeometry(1.52,0.04,0.04),tubeMat);
  tube2.position.set(-0.28,2.04,0.50); shell.add(tube2);

  /* ---------------- the stock IS the health bar ----------------
     Sixteen cans, built top row first so they sell from the top down, which is
     what a real machine does. syncStock() hides them as the boss loses HP, so
     the only health readout in the fight is the shelf behind the glass. */
  const stock=new THREE.Group(); shell.add(stock);
  const stockCans=[];
  for(let r=3;r>=0;r--) for(let c=0;c<4;c++){
    const mi=(r*4+c)%canMats.length;
    const grp=new THREE.Group();
    const body=new THREE.Mesh(new THREE.CylinderGeometry(0.104,0.104,0.34,10),canMats[mi]);
    body.castShadow=true; grp.add(body);
    const lid=new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.11,0.022,10),chrome);
    lid.position.y=0.175; grp.add(lid);
    const base=new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.11,0.022,10),chrome);
    base.position.y=-0.175; grp.add(base);
    grp.position.set(-0.88+c*0.38, 2.145+r*0.72, 0.62);
    stock.add(grp);
    stockCans.push({g:grp, alive:true, dying:0, rise:0,
      homeX:-0.88+c*0.38, homeY:2.145+r*0.72, homeZ:0.62});
  }

  /* ---------------- the door ---------------- */
  const door=new THREE.Group();
  door.position.set(-1.2,3.30,0.80);
  /* Built as a FRAME. The old door was a solid slab with a glass plate laid on
     top of it, so the stock behind was sealed in — you could never see a can. */
  bx(door,0.10,3.00,0.10,paintLt,0.05,0,0,true);      /* left stile   */
  bx(door,0.50,3.00,0.10,paintLt,1.95,0,0,true);      /* right stile  */
  bx(door,1.60,0.17,0.10,paintLt,0.90, 1.415,0,true); /* top rail     */
  bx(door,1.60,0.17,0.10,paintLt,0.90,-1.415,0,true); /* bottom rail  */
  const doorGlass=new THREE.MeshStandardMaterial({
    color:0x8FA6C0, roughness:0.03, metalness:0.10,
    transparent:true, opacity:0.20, envMapIntensity:3.2, depthWrite:false
  });
  /* named, because the whole phase break is now this pane failing */
  const glass=mkBox(1.60,2.66,0.02,doorGlass,false);
  glass.position.set(0.90,0,0.045);
  door.add(glass);
  const glare=new THREE.Mesh(new THREE.PlaneGeometry(1.58,2.64),
    new THREE.MeshBasicMaterial({map:glareTex(),transparent:true,opacity:0.85,
      blending:THREE.AdditiveBlending,depthWrite:false,toneMapped:false}));
  glare.position.set(0.90,0,0.060);
  door.add(glare);
  const crack=new THREE.Mesh(new THREE.PlaneGeometry(1.60,2.66),
    new THREE.MeshBasicMaterial({map:crackTex(),transparent:true,opacity:0,
      depthWrite:false,toneMapped:false}));
  crack.position.set(0.90,0,0.062);
  crack.visible=false;
  door.add(crack);
  bx(door,1.64,0.05,0.06,chrome,0.90, 1.335,0.055);
  bx(door,1.64,0.05,0.06,chrome,0.90,-1.335,0.055);
  bx(door,0.05,2.70,0.06,chrome,0.10,0,0.055);
  bx(door,0.05,2.70,0.06,chrome,1.70,0,0.055);

  /* payment column: the thing that makes it read as a vending machine */
  bx(door,0.34,2.62,0.05,steelDk,1.88,0.06,0.06);
  bx(door,0.14,0.34,0.02,chrome,1.88,0.94,0.105);
  bx(door,0.06,0.24,0.02,rubber,1.88,0.94,0.115);
  const ledMat=new THREE.MeshBasicMaterial({map:ledTex('1.50'),toneMapped:false});
  const led=new THREE.Mesh(new THREE.PlaneGeometry(0.24,0.09),ledMat);
  led.position.set(1.88,1.24,0.093); door.add(led);
  for(let r2=0;r2<4;r2++) for(let c2=0;c2<3;c2++){
    bx(door,0.06,0.05,0.02,chrome,1.78+c2*0.10,0.58-r2*0.13,0.095);
  }
  bx(door,0.17,0.09,0.03,rubber,1.88,-0.42,0.095);
  bx(door,0.05,0.66,0.05,chrome,2.04,-0.62,0.10);
  bx(door,0.05,0.05,0.04,chrome,2.04,-0.28,0.10);

  /* a few slivers stay stuck to the frame after the break — a pane never goes
     perfectly clean, and the residue is what sells "this just broke" */
  const residue=new THREE.Group();
  residue.visible=false;
  const resMat=new THREE.MeshStandardMaterial({
    color:0xDFF1FF, roughness:0.04, metalness:0.10, transparent:true,
    opacity:0.55, envMapIntensity:3.0, side:THREE.DoubleSide, depthWrite:false
  });
  [[0.30,1.28,0.12,0.16,-0.2],[0.92,1.29,0.16,0.12,0.15],[1.48,1.27,0.10,0.20,0.3],
   [0.14,0.62,0.12,0.26,0.1],[0.15,-0.52,0.10,0.22,-0.15],[1.66,-1.20,0.14,0.18,0.2]]
   .forEach(([x,y,w,h,r])=>{
    const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),resMat);
    m.position.set(x,y,0.048); m.rotation.z=r; residue.add(m);
  });
  door.add(residue);
  shell.add(door);

  /* what is behind the door */
  const inside=new THREE.Group();
  /* ---------------- what is behind the glass ----------------
     Not a creature: the machine's own working parts. It is more honest, it
     fits the space the stock vacates, and it gives the fight a body to hit
     once the pane is gone. The lower two shelves are already empty at the
     phase break, so this is exactly the space that opens up. */
  inside.position.set(0,0,0);
  inside.visible=false;
  const steelM=P(0x6A7080,0.38,0.80);
  const copperM=P(0xB06A3A,0.32,0.95);
  const rubberM=P(0x15161B,0.88,0.05);
  const wireM=[P(0xC23A4A,0.55,0.10),P(0x2F6AB0,0.55,0.10),P(0xD8C24A,0.55,0.10)];

  /* compressor: the heavy thing that makes the noise */
  const comp=new THREE.Mesh(new THREE.CylinderGeometry(0.50,0.50,0.92,18),steelM);
  comp.position.set(-0.42,1.76,0.10); comp.castShadow=true; inside.add(comp);
  const cap=new THREE.Mesh(new THREE.CylinderGeometry(0.50,0.50,0.09,18),steelM);
  cap.position.set(-0.42,2.24,0.10); inside.add(cap);
  /* copper coil, the part every fridge has */
  for(let i=0;i<3;i++){
    const coil=new THREE.Mesh(new THREE.TorusGeometry(0.26-i*0.02,0.035,7,18),copperM);
    coil.rotation.x=Math.PI/2;
    coil.position.set(0.52,1.60+i*0.13,0.05);
    inside.add(coil);
  }
  /* condenser fan, still turning */
  const fan=new THREE.Group();
  fan.position.set(-0.05,2.42,0.02);
  const hub=new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.07,0.06,10),steelM);
  hub.rotation.x=Math.PI/2; fan.add(hub);
  for(let i=0;i<5;i++){
    const bl=new THREE.Mesh(new THREE.BoxGeometry(0.30,0.02,0.14),rubberM);
    bl.position.set(Math.cos(i/5*TAU)*0.20, Math.sin(i/5*TAU)*0.20, 0);
    bl.rotation.z=i/5*TAU; fan.add(bl);
  }
  inside.add(fan);
  /* wiring loom, hanging where the stock used to be */
  for(let i=0;i<11;i++){
    const len=rand(0.24,0.66);
    const w=new THREE.Mesh(new THREE.BoxGeometry(0.032,len,0.032),wireM[i%3]);
    w.position.set(rand(-0.92,0.92), 2.60-len/2-rand(0,0.34), rand(0.02,0.22));
    w.rotation.z=rand(-0.5,0.5);
    w.rotation.x=rand(-0.3,0.3);
    inside.add(w);
  }
  /* a bundle that actually hangs like a loom */
  for(let i=0;i<4;i++){
    const w=new THREE.Mesh(new THREE.BoxGeometry(0.05,rand(0.5,0.9),0.05),wireM[(i+1)%3]);
    w.position.set(-0.72+i*0.10, 2.30, 0.16);
    w.rotation.z=rand(-0.25,0.25);
    inside.add(w);
  }
  /* a control board with one live LED */
  bx(inside,0.62,0.40,0.05,P(0x1C3326,0.60,0.20),0.58,2.30,0.04);
  const led2=new THREE.Mesh(new THREE.BoxGeometry(0.05,0.05,0.02),
    new THREE.MeshBasicMaterial({color:0x62FF9A,toneMapped:false}));
  led2.position.set(0.44,2.36,0.07); inside.add(led2);
  shell.add(inside);

  /* ---------------- its own lighting ---------------- */
  /* warm tube inside the cabinet — this is what lights the stock and throws
     a soft glow onto the ground through the glass */
  const interiorLight=new THREE.PointLight(0xEDF3FF,1.30,5.2,2);
  interiorLight.position.set(-0.28,3.95,0.50);
  g.add(interiorLight);

  /* the header's spill, pink, forward and low so it lands on the asphalt */
  const headerLight=new THREE.PointLight(0xFF86C4,0.95,10,2);
  headerLight.position.set(0,5.5,2.1);
  g.add(headerLight);

  /* a cool rim from behind so the cabinet is not a silhouette on a dark wall */
  const rimLight=new THREE.PointLight(0x6FA8FF,0.70,12,2);
  rimLight.position.set(0,4.6,-1.9);
  g.add(rimLight);

  /* the pool of light it casts on the ground. Cheap, but this single plane is
     what makes the machine look like it belongs in the scene at night. */
  /* A dark contact shadow under the cabinet. The machine hovers, and without
     this it reads as a sticker floating over the road. */
  const shadowCv=document.createElement('canvas'); shadowCv.width=shadowCv.height=128;
  const sc2=shadowCv.getContext('2d');
  const sg=sc2.createRadialGradient(64,64,0,64,64,64);
  sg.addColorStop(0,'rgba(0,0,0,0.85)');
  sg.addColorStop(0.55,'rgba(0,0,0,0.45)');
  sg.addColorStop(1,'rgba(0,0,0,0)');
  sc2.fillStyle=sg; sc2.fillRect(0,0,128,128);
  const contact=new THREE.Mesh(new THREE.CircleGeometry(1.55,26),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(shadowCv),
      transparent:true,opacity:0.55,depthWrite:false,toneMapped:false}));
  contact.rotation.x=-Math.PI/2;
  contact.position.set(0,0.03,0);
  contact.scale.set(1.25,1.0,1);
  g.add(contact);

  const pool=new THREE.Mesh(new THREE.PlaneGeometry(7.2,5.2),
    new THREE.MeshBasicMaterial({map:radialTex(0xFF6FA8),transparent:true,
      opacity:0.46,blending:THREE.AdditiveBlending,depthWrite:false,toneMapped:false}));
  pool.rotation.x=-Math.PI/2;
  pool.position.set(0,0.04,2.0);
  g.add(pool);

  /* A real machine is 0.94m wide by 1.83m tall — a ratio of 1:1.95. Built at
     the gameplay height it came out 1:2.6, which is why it read as a fridge
     rather than a vending machine. Widened 18% to land near the real ratio. */
  /* The only ground decal in the fight. TILT is radial and instant, so the
     player genuinely cannot infer its danger zone any other way. Parented to
     the scene, not to `g`, because g's non-uniform scale would squash it. */
  const tiltDisc=new THREE.Mesh(new THREE.CircleGeometry(6.4,44),
    new THREE.MeshBasicMaterial({color:0xFF3A2A,transparent:true,opacity:0,
      depthWrite:false,side:THREE.DoubleSide,toneMapped:false}));
  tiltDisc.rotation.x=-Math.PI/2;
  tiltDisc.position.y=0.045;
  tiltDisc.visible=false;
  scene.add(tiltDisc);
  /* a hard rim, because a soft fill alone does not tell you where the edge is */
  const tiltRim=new THREE.Mesh(new THREE.RingGeometry(6.16,6.4,52),
    new THREE.MeshBasicMaterial({color:0xFF6A4A,transparent:true,opacity:0,
      depthWrite:false,side:THREE.DoubleSide,toneMapped:false}));
  tiltRim.rotation.x=-Math.PI/2;
  tiltRim.position.y=0.05;
  tiltRim.visible=false;
  scene.add(tiltRim);

  g.scale.set(1.15*1.18, 1.15, 1.15);
  scene.add(g);
  return {group:g, shell, footL, footR, door, glass, glare, crack, inside, fan,
          stock, stockCans, mats, cavityMat, falloff:fall, interiorLight,
          headerLight, rimLight, pool, contact, residue, radius:1.85,
          flap, ventMat, ledMat, rock, tiltDisc, tiltRim, lightbox:lb,
          crackT:0, glassBroken:false, heat:0};
}

/* ------------------------------- state -------------------------------- */
const G={ mode:'menu', t:0, shake:0, hitstop:0, camYaw:0, over:false,
          assistHold:0, assistOn:false, fovPunch:0 };
let GOD=false;

const P={
  pos:new THREE.Vector3(0,0,11),
  vx:0, vy:0, vz:0, facing:Math.PI,
  hp:CHOG_DEF.health, max:CHOG_DEF.health,
  onGround:true, coyote:0, jumpsLeft:2,
  dashCd:0, dashT:0, dashVecX:0, dashVecZ:0, moveLock:0,
  invuln:0, hurtInvuln:0, hitstun:0, dead:false,
  mountT:0, mountCd:0, mountPhase:'', mountFrom:null,
  attackType:null, attackT:0, attackPhase:'', hitSet:new Set(),
  animT:0, flash:0, landSquash:0, landSquashAmt:0
};

const ATTACKS={
  quick:{ startup:0.07, active:0.10, recovery:0.17, dmg:8,  kb:10.5, range:2.5, arc:1.15, hitstop:0.05, shake:0.28, sound:'hitLight' },
  heavy:{ startup:0.21, active:0.14, recovery:0.36, dmg:16, kb:20,   range:3.1, arc:0.95, hitstop:0.11, shake:0.62, sound:'hitHeavy' }
};

const chog=buildChog();
scene.add(chog.root);
const playerLight=new THREE.PointLight(0xC9A8FF,1.05,9,2);
scene.add(playerLight);

let boss=null;
const cans=[], coins=[], fx=[];
const _canQ=new THREE.Quaternion();

const CAN={ G:30, FUSE:1.55, BLINK:0.70, R:2.5, LAND_Y:0.95 };
const COIN={ SPEED:24, Y:1.15, R:0.26, DMG:13 };

/* How much of your speed survives while swinging. This is the dial the user
   asked to test: ROOTED is the old behaviour, DRIFT is the default, FREE lets
   you move at near-full speed mid-swing. Cycle in game with M. */
const ATTACK_MOVE={ mode:1, modes:[
  { name:'ROOTED', light:0.00, heavy:0.00 },
  { name:'DRIFT',  light:0.70, heavy:0.50 },
  { name:'FREE',   light:1.00, heavy:0.85 }
]};

/* Stations the machine relocates between. Pursuing the player alone made it
   park at a constant 4-unit standoff, which reads as orbiting you rather than
   using the arena. Every few seconds it now cuts to a station across the
   block, still firing, then resumes the chase. */
const STATIONS=[
  [-13,-9],[-8,-9],[0,-9],[8,-9],[15,-9],
  [-15,4],[-8,4],[0,4],[8,4],[15,4],
  [-15,16],[-8,16],[0,16],[12,16]
];
const ROAM_SPEED=11.0;

function startRoam(b){
  let best=null, bestScore=-1e9;
  for(const st of STATIONS){
    const db=Math.hypot(st[0]-b.pos.x, st[1]-b.pos.z);
    if(db < 8.5) continue;                      /* too close to be a move */
    if(b.lastStation && st[0]===b.lastStation[0] && st[1]===b.lastStation[1]) continue;
    const dp=Math.hypot(st[0]-P.pos.x, st[1]-P.pos.z);
    /* far from where it stands, but it will not abandon the fight entirely */
    const score = db - Math.max(0, dp-15)*1.8;
    if(score>bestScore){ bestScore=score; best=st; }
  }
  if(best){ b.roamDest=[best[0],best[1]]; b.lastStation=best; }
  else b.roamT=0.9;
}

/* -------------------------------- input -------------------------------- */
const Input={ mx:0, mz:0, jumpHeld:false, jumpPressed:false, q:false, h:false, dash:false };
const keys={};
let queuedAttack=null;

function unlockAudio(){ SFX.init(); SFX.resume(); }

window.addEventListener('keydown',e=>{
  unlockAudio();
  if(CINE.kind==='intro'){ skipCine(); return; }
  /* while the tutorial is open it owns the arrow keys and Escape */
  const howOpen=document.getElementById('scrHow').classList.contains('on');
  if(howOpen){
    if(e.code==='ArrowRight'||e.code==='Enter'){ e.preventDefault(); howStep(1); return; }
    if(e.code==='ArrowLeft'){ e.preventDefault(); howStep(-1); return; }
    if(e.code==='Escape'){ e.preventDefault(); closeHow(); return; }
    if(e.code==='KeyH'){ e.preventDefault(); closeHow(); return; }
    return;
  }
  if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)) e.preventDefault();
  if(keys[e.code]) return;
  keys[e.code]=true;
  if(e.code==='Space'){ Input.jumpHeld=true; Input.jumpPressed=true; }
  if(e.code==='ShiftLeft'||e.code==='ShiftRight') Input.dash=true;
  if(e.code==='Escape') setPaused(!paused);
  /* H opens the tutorial from anywhere: it pauses the fight first, so you
     can read the card for the attack that just killed you. */
  if(e.code==='KeyH' && G.mode!=='menu'){ openHow(G.mode==='fight'?'pause':'menu'); }
  if(e.code==='KeyJ'){ Input.q=true; queuedAttack='quick'; }
  if(e.code==='KeyK'){ Input.h=true; queuedAttack='heavy'; }
  if(e.code==='KeyF') tryMount();
  if(e.code==='KeyM'){
    ATTACK_MOVE.mode=(ATTACK_MOVE.mode+1)%ATTACK_MOVE.modes.length;
    toast('ATTACK MOVE · '+ATTACK_MOVE.modes[ATTACK_MOVE.mode].name, 1300);
  }
});
window.addEventListener('keyup',e=>{
  keys[e.code]=false;
  if(e.code==='Space') Input.jumpHeld=false;
  if(e.code==='ShiftLeft'||e.code==='ShiftRight') Input.dash=false;
  if(e.code==='KeyJ') Input.q=false;
  if(e.code==='KeyK') Input.h=false;
});
canvas.addEventListener('contextmenu',e=>e.preventDefault());

/* DRAG TO LOOK. The previous build used pointer lock, which browsers refuse
   inside an iframe without allow="pointer-lock" — so in the preview panel the
   mouse did nothing whatsoever. Dragging needs no permission and works
   everywhere. A press that moves less than 6px counts as a click and fires
   the attack instead of turning the camera. */
const drag={down:false, x:0, moved:0, btn:0};
canvas.addEventListener('mousedown',e=>{
  if(CINE.kind==='intro'){ skipCine(); return; }
  unlockAudio();
  if(G.mode!=='fight') return;
  drag.down=true; drag.x=e.clientX; drag.moved=0; drag.btn=e.button;
});
window.addEventListener('mousemove',e=>{
  if(!drag.down || G.mode!=='fight') return;
  const dx=e.clientX-drag.x;
  drag.x=e.clientX;
  drag.moved+=Math.abs(dx);
  if(drag.moved>6){
    G.camYaw -= dx*0.0045;
    G.assistHold=1.6;
  }
});
window.addEventListener('mouseup',()=>{
  if(!drag.down) return;
  drag.down=false;
  if(drag.moved<=6 && G.mode==='fight'){
    queuedAttack = (drag.btn===2)?'heavy':'quick';
  }
});


function readMoveInput(){
  let x=0,z=0;
  if(keys['KeyA']||keys['ArrowLeft'])  x-=1;
  if(keys['KeyD']||keys['ArrowRight']) x+=1;
  if(keys['KeyW']||keys['ArrowUp'])    z+=1;
  if(keys['KeyS']||keys['ArrowDown'])  z-=1;
  /* the touch stick is analogue: add it to the digital keys, then clamp */
  x+=TOUCH.sx; z+=TOUCH.sz;
  Input.mx=clamp(x,-1,1); Input.mz=clamp(z,-1,1);
}

/* ------------------------------- player -------------------------------- */
/* The tilt disc and rim live in the SCENE, not in boss.group, because the
   group's non-uniform scale would squash them. That means removing the group
   does not remove them - every fight used to leak another pair. */
function disposeBoss(){
  if(!boss) return;
  scene.remove(boss.group);
  [boss.tiltDisc, boss.tiltRim].forEach(m=>{
    if(!m) return;
    scene.remove(m);
    if(m.geometry) m.geometry.dispose();
    if(m.material) m.material.dispose();
  });
  boss=null;
}

function startFight(){
  disposeBoss();
  cans.forEach(c=>removeCan(c)); cans.length=0;
  coins.forEach(c=>removeCoin(c)); coins.length=0;
  fx.forEach(f=>{ scene.remove(f.m); if(f.m.geometry) f.m.geometry.dispose(); }); fx.length=0;

  boss=buildMachine();
  boss.pos=new THREE.Vector3(0,0,-4);
  boss.velX=0; boss.velZ=0; boss.heading=0;
  /* 365 -> 420: the mount is worth ~2.6 s of the boss not attacking
     (ride invulnerability + 1.5 s stagger), so the cabinet needed more
     stock to stay a threat once the ability became reachable. */
  boss.max=420; boss.hp=420; boss.phase=1;
  boss.restockQueue=[0.65,0.30]; boss.restockDone=0; boss.heat=0;
  boss.phaseState='idle'; boss.stateT=0; boss.idleT=1.1;
  boss.action=null; boss.lastAction=null;
  boss.windup=0; boss.activeT=0; boss.recoverT=0;
  boss._sy=undefined; boss._sz=undefined;
  boss.wave1=false; boss.wave2=false; boss.lungeHit=false;
  boss.hitFlash=0; boss.dead=false;
  boss.speed=0; boss.stride=0;
  boss.roamT=2.2; boss.roamDest=null; boss.lastStation=null;
  boss.group.position.set(boss.pos.x,0,boss.pos.z);

  P.pos.set(0,0,11); P.vx=0; P.vy=0; P.vz=0;
  P.hp=P.max; P.dead=false; P.facing=Math.PI;
  P.onGround=true; P.jumpsLeft=2; P.coyote=0;
  P.dashCd=0; P.dashT=0; P.moveLock=0; P.mountT=0; P.mountCd=0; P.mountPhase='';
  P.invuln=0; P.hitstun=0;
  P.attackType=null; P.attackT=0; P.attackPhase='';
  P.flash=0; P.landSquash=0;

  G.over=false; G.t=0; G.shake=0; G.hitstop=0;
  paused=false; PAUSED=false;
  document.getElementById('scrPause').classList.remove('on');
  /* open the fight already looking down the line at the machine */
  G.camYaw=Math.atan2(P.pos.x-boss.pos.x, P.pos.z-boss.pos.z);

  document.getElementById('scrStart').classList.remove('on');
  document.getElementById('scrEnd').classList.remove('on');
  /* the intro owns the camera and the machine's lights, then hands over */
  startCine('intro');
}

function updateHUD(){
  document.getElementById('pFill').style.width=Math.max(0,P.hp/P.max*100)+'%';
  document.getElementById('pHpTxt').textContent=Math.max(0,Math.round(P.hp));
}

let toastTimer=0;
function toast(text,ms){
  const el=document.getElementById('toast');
  el.textContent=text; el.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('on'), ms||1100);
}

function hurtPlayer(dmg,srcX,srcZ,kb){
  if(GOD) return;
  if(P.dead || G.mode!=='fight') return;
  /* i-frames were being SET here but never CHECKED, so a can burst landing on
     the same frame as a tilt stacked into 30 damage in one hit. Every source
     now respects the window. */
  if(P.invuln>0) return;
  P.hp-=dmg;
  P.invuln=0.55;
  P.hurtInvuln=0.55;
  P.flash=0.12;
  P.hitstun=Math.max(P.hitstun,0.30);
  /* Getting hit cancels the swing. This is the line that stops the fight
     being a damage race: before it, standing in melee and mashing heavy beat
     the boss every time, because trading always won. Now a swing you did not
     earn is a swing you lose. */
  P.attackT=0; P.attackType=null; P.attackPhase=''; P.hitSet.clear();
  G.shake=Math.max(G.shake,0.5);
  if(srcX!==undefined){
    const dx=P.pos.x-srcX, dz=P.pos.z-srcZ;
    const d=Math.hypot(dx,dz)||1;
    P.vx+=(dx/d)*(kb||9);
    P.vz+=(dz/d)*(kb||9);
    P.vy=Math.max(P.vy,3.4);
    P.onGround=false;
  }
  if(P.hp<=0){ P.hp=0; P.dead=true; endFight(false); }
  updateHUD();
}

function hurtBoss(dmg, opts){
  if(!boss || boss.dead) return;
  const b=boss;

  /* ---- where did it land? ----
     The machine is a cabinet with one face. Hits arriving from behind its
     forward axis land on bare panel, and it cannot answer them. Phase 2 turns
     at 3.4 rad/s instead of 9, which is what makes flanking possible at all. */
  let behind=false;
  if(opts && opts.fromX!==undefined){
    const tx=opts.fromX-b.pos.x, tz=opts.fromZ-b.pos.z;
    const td=Math.hypot(tx,tz)||1;
    const fx=Math.sin(b.heading), fz=Math.cos(b.heading);
    behind=((tx/td)*fx+(tz/td)*fz) < -0.25;
  }
  const hot=(b.heat||0)>0;
  const staggered=(b.phaseState==='stagger');

  /* Multipliers are chosen, not multiplied: getting both is the best case, not
     a nuke. x2.2 is the ceiling. A jammed machine takes a flat x2. */
  let mult=1;
  if(behind) mult=1.6;
  if(hot) mult=behind?2.2:1.75;
  if(staggered) mult=Math.max(mult,2.0);

  b.hp-=dmg*mult;
  b.hitFlash=0.10;
  G.shake=Math.max(G.shake,0.22);

  /* Hitting it mid-restock jams the delivery arm — but not in the first 30%.
     Without that grace the player's ordinary combo cancels every restock
     before it is visible, and the whole beat disappears. */
  if(b.phaseState==='restock' && b.stateT > RESTOCK_TIME*0.30) failRestock(b);

  if(mult>1){
    /* opts is optional: a staggered hit can arrive with no origin at all */
    const hx=(opts&&opts.fromX!==undefined)?opts.fromX:b.pos.x;
    const hz=(opts&&opts.fromZ!==undefined)?opts.fromZ:b.pos.z;
    const ang=Math.atan2(b.pos.x-hx, b.pos.z-hz);
    sparks(b.pos.x-Math.sin(ang)*1.6, 2.4+rand(-0.5,0.5),
           b.pos.z-Math.cos(ang)*1.6,
           behind?0xFFD24A:0xFF7A3D, behind&&hot?10:6);
    if(behind) SFX.backHit();
  }
  syncStock();

  if(boss.hp<=0){
    boss.hp=0; boss.dead=true; endFight(true); updateHUD(); return;
  }
  if(boss.phase===1 && boss.hp<=boss.max*0.5){
    boss.phase=2;
    onPhaseBreak();
  }
  /* three cans left is nothing left to sell */
  if(boss.phase===2 && boss.hp<=boss.max*3/16){
    goSoldOut(boss);
  }
  updateHUD();
}

/* ============================ restock ============================
   Twice a fight the machine tries to refill itself. Break the cycle and it
   jams; leave it and two cans go back on the shelf. The first one happens
   behind intact glass, the second in the open cabinet — a free progression
   beat that costs nothing to build.
   ================================================================= */
const RESTOCK_TIME=2.5;

function maybeRestock(b){
  if(!b.restockQueue || !b.restockQueue.length) return false;
  if(b.hp > b.max*b.restockQueue[0]) return false;
  b.restockQueue.shift();
  b.phaseState='restock'; b.stateT=0; b.action='restock';
  b.restockDone=0;
  b.velX=0; b.velZ=0;
  b.wave1=false; b.wave2=false; b.lungeHit=false;
  SFX.restockCycle();
  toast('RESTOCK', 900);
  return true;
}

function failRestock(b){
  b.phaseState='stagger'; b.stateT=0; b.action='stagger';
  b.velX=0; b.velZ=0;
  G.shake=Math.max(G.shake,0.5);
  G.hitstop=Math.max(G.hitstop,0.05);
  SFX.coolHiss();
  toast('JAMMED', 900);
}

function healBossCans(b,n){
  b.hp=Math.min(b.max, b.hp + n*b.max/b.stockCans.length);
  syncStock();
  SFX.stockDrop();
}

/* ============================ sold out ============================
   Three cans left is nothing left to sell. The lights go out and it stops
   behaving like a shop and starts behaving like a machine that wants you gone.
   ================================================================= */
function goSoldOut(b){
  b.phase=3;
  /* nothing left to sell, so nothing left to restock — and if it was mid
     refill when the last can went, that stops too */
  b.restockQueue=[];
  if(b.phaseState==='restock'||b.phaseState==='stagger'){
    b.phaseState='idle'; b.stateT=0; b.idleT=0.25; b.action=null;
  }
  SFX.powerDown();
  if(b.lightbox) b.lightbox.visible=false;
  if(b.headerLight) b.headerLight.intensity=0;
  if(b.pool) b.pool.material.opacity=0;
  if(b.interiorLight) b.interiorLight.intensity=0.25;
  b.heat=0;
  toast('SOLD OUT', 1800);
  G.shake=Math.max(G.shake,0.9);
  G.hitstop=Math.max(G.hitstop,0.08);
}

function onPhaseBreak(){
  boss.inside.visible=true;
  boss.crack.visible=true;
  boss.crackT=0.26;
  /* the cavity goes dark the instant it is open, so what is inside reads */
  boss.cavityMat.color.setHex(0x1A1520);
  if(boss.falloff) boss.falloff.visible=false;
  if(boss.residue) boss.residue.visible=true;
  if(boss.glare) boss.glare.visible=false;
  boss.phaseState='idle'; boss.stateT=0; boss.idleT=0.9;
  boss.action=null;
  boss.velX=0; boss.velZ=0;
  boss.roamDest=null; boss.roamT=1.6;
  G.shake=1.1; G.hitstop=0.10;
  toast('THE GLASS GOES', 1500);
}

/* a short burst of hot debris at a contact point — the cheapest way to make a
   hit read as landing on metal rather than on a health bar */
function sparks(x,y,z,color,n){
  for(let i=0;i<(n||6);i++){
    const m=new THREE.Mesh(new THREE.BoxGeometry(0.07,0.07,0.07),
      new THREE.MeshBasicMaterial({color,toneMapped:false}));
    m.position.set(x,y,z);
    scene.add(m);
    const a=rand(0,TAU), sp=rand(3,8);
    fx.push({m,life:0.32,max:0.32,type:'shard',
      vx:Math.cos(a)*sp,vy:rand(2.5,7.5),vz:Math.sin(a)*sp,
      rx:rand(-14,14),rz:rand(-14,14)});
  }
}

/* the pane lets go: real shards, thrown outward from the impact, in world
   space so they do not inherit the boss's heading */
function shatterGlass(b){
  if(!b || b.glassBroken) return;
  b.glassBroken=true;
  b.glass.visible=false;
  b.crack.visible=false;

  const p=new THREE.Vector3(), q=new THREE.Quaternion(), sc=new THREE.Vector3();
  b.glass.updateWorldMatrix(true,false);
  b.glass.matrixWorld.decompose(p,q,sc);

  const shardMat=new THREE.MeshStandardMaterial({
    color:0xDFF1FF, roughness:0.03, metalness:0.10,
    emissive:0x24405C, transparent:true, opacity:0.70,
    envMapIntensity:3.4, side:THREE.DoubleSide, depthWrite:false
  });
  for(let i=0;i<28;i++){
    const w=rand(0.09,0.26), h=rand(0.10,0.30);
    const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h), shardMat.clone());
    const lx=rand(-0.80,0.80), ly=rand(-1.30,1.30);
    m.position.copy(p).add(new THREE.Vector3(lx,ly,0).applyQuaternion(q));
    m.quaternion.copy(q);
    scene.add(m);
    const dir=new THREE.Vector3(lx,ly,0.55).normalize().applyQuaternion(q);
    const sp=rand(3.0,8.0);
    fx.push({m,life:rand(1.0,1.7),max:1.7,type:'glass',
      vx:dir.x*sp, vy:dir.y*sp+rand(1.0,4.0), vz:dir.z*sp,
      rx:rand(-9,9), rz:rand(-9,9)});
  }

  G.shake=Math.max(G.shake,1.2);
  G.hitstop=Math.max(G.hitstop,0.06);
  SFX.glassBreak();
}

/* ---------------- stock: the health bar you can see ----------------
   16 cans over 280 HP. Each one that disappears is 17.5 HP of boss, so the
   shelf empties at exactly the rate the machine is losing. */
function syncStock(){
  const b=boss;
  if(!b || !b.stockCans) return;
  const total=b.stockCans.length;
  const alive=clamp(Math.ceil((b.hp/b.max)*total),0,total);
  let changed=false;
  for(let i=0;i<total;i++){
    const c=b.stockCans[i];
    if(i<alive){
      /* a restock puts cans back. One-way sync could never do this. */
      if(!c.alive){
        c.alive=true; c.dying=0; c.rise=0.32;
        c.g.visible=true;
        c.g.rotation.z=0;
        c.g.scale.setScalar(0.01);
        changed=true;
      }
    } else if(c.alive){
      c.alive=false; c.dying=0.30; c.rise=0; changed=true;
    }
  }
  if(changed) SFX.stockDrop();
}

function updateStock(dt){
  const b=boss;
  if(!b || !b.stockCans) return;
  for(const c of b.stockCans){
    /* a can dropped back onto the shelf after a restock */
    if(c.rise>0){
      c.rise-=dt;
      const k=1-clamp(c.rise/0.32,0,1);
      c.g.position.y=c.homeY+(1-k)*0.45;
      c.g.scale.setScalar(0.35+0.65*k);
      if(c.rise<=0){
        c.g.position.y=c.homeY;
        c.g.scale.setScalar(1);
      }
      continue;
    }
    if(c.alive || c.dying<=0) continue;
    c.dying-=dt;
    c.g.position.y-=dt*3.0;
    c.g.rotation.z+=dt*6.0;
    const k=clamp(c.dying/0.30,0,1);
    c.g.scale.setScalar(k);
    if(c.dying<=0) c.g.visible=false;
  }
}

function endFight(win){
  if(CINE.kind) return;
  paused=false; PAUSED=false;
  document.getElementById('scrPause').classList.remove('on');
  document.getElementById('hud').classList.remove('on');
  if(win) SFX.victory(); else SFX.defeat();
  startCine(win?'win':'lose');
}

/* ------------------------------ the receipt ------------------------------
   The run, printed. The same numbers are drawn twice: into the DOM receipt
   the player reads, and onto a 1080x1350 canvas they can post.
   ---------------------------------------------------------------------- */
function receiptData(win){
  const time = Math.max(0.1, G.t);
  const max  = P.max || 185;
  /* health is measured in cans on the shelf: six of them, each worth max/6 */
  const CANS = 6;
  const per  = max / CANS;
  const hp   = Math.max(0, Math.min(max, P.hp));
  const lost = Math.min(CANS, Math.max(0, Math.ceil((max - hp) / per - 1e-6)));
  const phase = Math.min(3, boss ? (boss.phase|0)+1 : 1);
  const no = String(1000 + ((Math.round(time*10)*37 + lost*91 + phase*17) % 9000));
  return { win:!!win, time:time, lost:lost, cans:CANS, max:max, phase:phase, no:no };
}
function receiptRows(d){
  const rows = [
    ['RESULT', d.win ? 'CLEARED' : 'FAILED'],
    ['TIME', d.time.toFixed(1) + 's'],
    ['CANS LOST', d.lost + ' of ' + d.cans],
    ['PHASE', d.phase + ' of 3'],
    ['RECEIPT', '#' + d.no]
  ];
  return rows.map(function(r,i){
    return '<div class="rcRow'+(i===0?' first':'')+'"><span>'+r[0]+'</span><span>'+r[1]+'</span></div>';
  }).join('');
}
function rcBarcode(cv, seed){
  const g=cv.getContext('2d'), w=cv.width, h=cv.height;
  g.clearRect(0,0,w,h);
  g.fillStyle='#1A1A16';
  let x=3, rnd=seed||1234;
  const next=function(){ rnd=(rnd*1103515245+12345)&0x7fffffff; return rnd/0x7fffffff; };
  while(x<w-3){
    const bw=1+Math.floor(next()*4);
    if(next()>0.34) g.fillRect(x,0,bw,h);
    x += bw + 1 + Math.floor(next()*2);
  }
}
function receiptCanvas(d){
  const W=1080, H=1350, cv=document.createElement('canvas');
  cv.width=W; cv.height=H;
  const g=cv.getContext('2d');
  const bg=g.createRadialGradient(W/2,H*0.3,80,W/2,H*0.3,W*0.9);
  bg.addColorStop(0,'#151024'); bg.addColorStop(1,'#08060E');
  g.fillStyle=bg; g.fillRect(0,0,W,H);
  const px=120, py=130, pw=W-px*2, ph=H-py-160;
  g.fillStyle='#F4F1E8'; g.fillRect(px,py,pw,ph);
  g.fillStyle='#6B675C';
  for(let i=0;i<10;i++){ g.fillRect(px+i*14, py+ph, 14-i*0.6, 10); }
  g.textAlign='center'; g.fillStyle='#1A1A16';
  g.font='700 34px "JetBrains Mono", monospace';
  g.fillText('CHOG MART', W/2, py+70);
  g.fillStyle='#6B675C'; g.font='400 20px "JetBrains Mono", monospace';
  g.fillText('UNIT 07 · AISLE 7', W/2, py+104);
  const rows=[
    ['RESULT', d.win?'CLEARED':'FAILED'],
    ['TIME', d.time.toFixed(1)+'s'],
    ['CANS LOST', d.lost+' of '+d.cans],
    ['PHASE', d.phase+' of 3'],
    ['RECEIPT', '#'+d.no]
  ];
  let y=py+170;
  rows.forEach(function(r,i){
    g.strokeStyle='#C9C3B2'; g.setLineDash([7,6]); g.beginPath();
    g.moveTo(px+34,y-30); g.lineTo(px+pw-34,y-30); g.stroke(); g.setLineDash([]);
    g.textAlign='left'; g.fillStyle='#4A473E'; g.font='400 22px "JetBrains Mono", monospace';
    g.fillText(r[0], px+38, y);
    g.textAlign='right'; g.fillStyle='#1A1A16'; g.font='700 26px "JetBrains Mono", monospace';
    g.fillText(r[1], px+pw-38, y);
    y+=58;
  });
  g.strokeStyle='#C9C3B2'; g.setLineDash([7,6]); g.beginPath();
  g.moveTo(px+34,y-30); g.lineTo(px+pw-34,y-30); g.stroke(); g.setLineDash([]);
  g.textAlign='center';
  g.fillStyle = d.win ? '#6B675C' : '#A32D2D';
  g.font='700 20px "JetBrains Mono", monospace';
  g.fillText(d.win ? 'THANK YOU FOR SHOPPING' : 'INSUFFICIENT FUNDS', W/2, y+46);
  const bar=document.createElement('canvas'); bar.width=560; bar.height=70;
  rcBarcode(bar, parseInt(d.no,10));
  g.drawImage(bar, W/2-280, y+80);
  g.fillStyle='#3A3730'; g.font='400 16px "JetBrains Mono", monospace';
  g.fillText('CHOG TRIALS · VIBER BRAWL', W/2, py+ph-26);
  return cv;
}
function receiptText(d){
  return d.win
    ? 'Cleared CHOG MART · UNIT 07 in ' + d.time.toFixed(1) + 's. ' + d.lost + ' cans lost.'
    : 'The machine kept my stock. ' + d.time.toFixed(1) + 's, phase ' + d.phase + '.';
}
function receiptBlob(d){
  return new Promise(function(res){ receiptCanvas(d).toBlob(res, 'image/png'); });
}
async function shareReceipt(){
  const d = window.__lastReceipt; if(!d) return;
  const blob = await receiptBlob(d);
  const file = new File([blob], 'chog-mart-receipt.png', { type:'image/png' });
  const text = receiptText(d);
  if(navigator.canShare && navigator.canShare({ files:[file] })){
    try{ await navigator.share({ files:[file], text:text }); return; }catch(e){ /* user cancelled */ }
  }
  saveReceiptBlob(blob);
  try{ await navigator.clipboard.writeText(text); toast('SAVED · CAPTION COPIED', 2000); }
  catch(e){ toast('SAVED', 1600); }
}
function saveReceiptBlob(blob){
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='chog-mart-receipt.png';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
}
async function saveReceipt(){
  const d = window.__lastReceipt; if(!d) return;
  saveReceiptBlob(await receiptBlob(d));
  toast('RECEIPT SAVED', 1600);
}
function showReceipt(win){
  const d = receiptData(win);
  window.__lastReceipt = d;
  document.getElementById('rcRows').innerHTML = receiptRows(d);
  const stamp = document.getElementById('rcStamp');
  stamp.textContent = win ? 'THANK YOU FOR SHOPPING' : 'INSUFFICIENT FUNDS';
  stamp.classList.toggle('fail', !win);
  document.getElementById('rcSub').textContent = win ? 'UNIT 07 · AISLE 7' : 'UNIT 07 · AISLE 7 · TRANSACTION VOID';
  rcBarcode(document.getElementById('rcBar'), parseInt(d.no,10));
  document.getElementById('receiptWrap').classList.add('on');
  document.getElementById('scrEnd').classList.remove('on');
  document.getElementById('hud').classList.remove('on');
}


document.getElementById('rcShare').addEventListener('click', shareReceipt);
document.getElementById('rcSave').addEventListener('click', saveReceipt);
document.getElementById('rcClose').addEventListener('click', function(){
  document.getElementById('receiptWrap').classList.remove('on');
  document.getElementById('scrEnd').classList.add('on');
});
document.getElementById('btnAgain').addEventListener('click', function(){
  document.getElementById('receiptWrap').classList.remove('on');
});

/* the card itself, once the outro has finished playing */
function showResults(win){
  G.over=true; G.mode='end';
  CAM_OVERRIDE=null;
  document.getElementById('hud').classList.remove('on');
  document.getElementById('endKicker').textContent = win?'RESULT · CLEARED':'RESULT · FAILED';
  document.getElementById('endTitle').textContent = win?'BOSS DOWN':'YOU LOST';
  document.getElementById('endSub').textContent = win
    ? 'The cabinet is empty. Nothing was left inside it.'
    : 'It still had stock. Watch the coins — those are the ones you jump.';
  /* the receipt is the result screen now; the old card stays behind CLOSE */
  showReceipt(win);
}

/* --------------------------- player update ----------------------------- */
const GRAV=-44;

/* --------------------------- the mount ------------------------------
   MOUNT (F) - when the compressor overheats the side vents glow for 2.5 s.
          Climb the vent face and drive a fist into it. The biggest single hit
          in the game, and it staggers the machine into the x2 damage window.
          One mount per overheat, and only from the vent side.
   -------------------------------------------------------------------- */
/* cd is 10s because the tilt now overheats the machine at close range -
   without it the mount would fire every couple of seconds and out-damage
   the whole moveset. At 10s it lands once or twice a fight. */
const MOUNT={ leap:0.34, slam:0.46, off:0.30, dmg:55, cd:10 };
const BASE_FOV=camera.fov;

/* The vents are eight slats on the machine's LOCAL -X face, spanning
   y 2.32-5.19 (measured off the mesh, not guessed). Mounting only works from
   that side - which is also the side that glows when it overheats, so the
   machine itself tells you where to stand. */
const VENT_R = 2.28;     /* stand-off so his back sits against the vent face */
const VENT_Y = 2.75;     /* feet height while clinging                       */
const VENT_DOT = 0.50;   /* must be within ~60 deg of the vent face          */

function ventNormal(){
  const h = boss ? boss.heading : 0;
  return { x:-Math.cos(h), z:Math.sin(h) };
}

function mountReady(){
  const b=boss;
  if(!b || b.dead || P.dead || P.mountT>0) return false;
  if(P.mountCd>0) return false;
  if(!(b.heat>0)) return false;
  const dx=P.pos.x-b.pos.x, dz=P.pos.z-b.pos.z;
  const dl=Math.hypot(dx,dz)||1;
  if(dl>5.2) return false;
  const n=ventNormal();
  return (dx/dl*n.x + dz/dl*n.z) > VENT_DOT;
}

function tryMount(){
  const b=boss;
  if(!b || b.dead || P.dead || P.mountT>0) return;
  if(P.mountCd>0){ toast('MOUNT RECHARGING \u00b7 '+Math.ceil(P.mountCd)+'s', 900); return; }
  if(!(b.heat>0)){ toast('NO HEAT \u00b7 WAIT FOR THE SLAM', 1000); return; }
  if(dist2D(P.pos.x,P.pos.z,b.pos.x,b.pos.z) > 5.2){ toast('TOO FAR', 700); return; }
  if(!mountReady()){ toast('GET TO THE VENTS', 900); return; }
  const n=ventNormal();
  P.mountTo={ x:b.pos.x+n.x*VENT_R, z:b.pos.z+n.z*VENT_R, y:VENT_Y, nx:n.x, nz:n.z };
  P.mountT=MOUNT.leap+MOUNT.slam+MOUNT.off;
  P.mountPhase='leap'; P.mountHit=false;
  P.mountFrom={ x:P.pos.x, y:P.pos.y, z:P.pos.z };
  P.vx=0; P.vz=0; P.vy=0; P.onGround=false;
  P.attackT=0; P.attackType=null;
  b.heat=0;                    /* one mount per overheat */
  P.mountCd=MOUNT.cd;
  SFX.dash();
}

function updateMount(dt){
  const b=boss, T=P.mountTo, f=P.mountFrom;
  P.mountT=Math.max(0,P.mountT-dt);
  P.invuln=Math.max(P.invuln,0.12);       /* untouchable for the whole ride */
  const el=(MOUNT.leap+MOUNT.slam+MOUNT.off)-P.mountT;

  if(el<MOUNT.leap){
    /* rise on the line he is already standing on, so the path never cuts
       through the cabinet */
    const k=el/MOUNT.leap, e=k*k*(3-2*k);
    P.pos.x=f.x+(T.x-f.x)*e;
    P.pos.z=f.z+(T.z-f.z)*e;
    P.pos.y=f.y+(T.y-f.y)*k + Math.sin(k*Math.PI)*0.9;
    P.mountPhase='leap';
    P.facing=Math.atan2(T.x-P.pos.x, T.z-P.pos.z);
  } else if(el<MOUNT.leap+MOUNT.slam){
    P.pos.x=T.x; P.pos.z=T.z; P.pos.y=T.y;
    P.mountPhase='slam';
    if(b) P.facing=Math.atan2(b.pos.x-P.pos.x, b.pos.z-P.pos.z);
    /* the punch lands a beat after he grabs on, so there is a wind-up */
    if(!P.mountHit && el>=MOUNT.leap+MOUNT.slam*0.32){
      P.mountHit=true;
      if(b && !b.dead){
        hurtBoss(MOUNT.dmg, { fromX:P.pos.x, fromZ:P.pos.z });
        b.heat=0;
        b.phaseState='stagger'; b.stateT=0; b.action='stagger';
        G.hitstop=Math.max(G.hitstop,0.13);
        G.shake=Math.max(G.shake,1.15);
        G.fovPunch=0.9;
        SFX.hitHeavy();
        sparks(T.x, T.y+1.3, T.z, 0xFFB35C, 16);
        sparks(T.x, T.y+1.3, T.z, 0x9B7BFF, 10);
      }
    }
  } else {
    /* push off and drop */
    const k=(el-MOUNT.leap-MOUNT.slam)/MOUNT.off;
    P.pos.x=T.x+T.nx*1.9*k; P.pos.z=T.z+T.nz*1.9*k;
    P.pos.y=T.y*(1-k) + Math.sin(k*Math.PI)*0.5;
    P.mountPhase='off';
  }
  if(P.mountT<=0){ P.mountPhase=''; P.pos.y=0; P.onGround=true; P.vx=0; P.vz=0; }
}

const hudDash=document.getElementById('dashBar');
const hudPip=document.getElementById('dashPip');
const hudLow=document.getElementById('lowhp');
const hudMount=document.getElementById('mountTip');

function updatePlayer(dt){
  P.dashCd=Math.max(0,P.dashCd-dt);
  P.invuln=Math.max(0,P.invuln-dt);
  P.hurtInvuln=Math.max(0,P.hurtInvuln-dt);
  P.hitstun=Math.max(0,P.hitstun-dt);
  P.mountCd=Math.max(0,P.mountCd-dt);

  if(hudDash){
    const k=clamp(1-P.dashCd/1.05,0,1);
    hudDash.style.width=(k*100).toFixed(1)+'%';
    hudDash.style.background = k>=1 ? '#9B7BFF' : 'rgba(155,123,255,.32)';
    hudPip.style.opacity = k>=1 ? '1' : '.5';
  }
  if(hudLow){
    const hpr=P.hp/P.max;
    hudLow.style.opacity = hpr<0.35 ? String(((0.35-hpr)/0.35).toFixed(2)) : '0';
  }
  if(hudMount){
    hudMount.style.opacity = mountReady() ? '1' : '0';
  }
  P.moveLock=Math.max(0,P.moveLock-dt);
  P.flash=Math.max(0,P.flash-dt);
  P.landSquash=Math.max(0,P.landSquash-dt);
  if(queuedAttack && P.attackT>0.45) queuedAttack=null;

  if(P.dead) return;
  if(P.mountT>0){ updateMount(dt); return; }

  readMoveInput();
  const canAct = P.hitstun<=0 && P.attackT<=0;
  /* Movement is NOT gated on attackT. It used to be, via `canAct`, which
     zeroed the input the instant you swung and let friction stop you dead for
     0.34s on a light and 0.71s on a heavy. You now keep a fraction of your
     speed while attacking; how much is ATTACK_MOVE above. */
  const canMove = P.hitstun<=0;

  /* camera-relative movement, exactly as the brawl converts WASD */
  const cy=G.camYaw;
  const fwdx=-Math.sin(cy), fwdz=-Math.cos(cy);
  const rx=Math.cos(cy), rz=-Math.sin(cy);
  let wx=fwdx*Input.mz+rx*Input.mx;
  let wz=fwdz*Input.mz+rz*Input.mx;
  const l=Math.hypot(wx,wz);
  const moving = l>0.001 && canMove;
  if(moving){ wx/=l; wz/=l; }

  let speedMul=1;
  if(P.attackT>0){
    const m=ATTACK_MOVE.modes[ATTACK_MOVE.mode];
    speedMul *= (P.attackType==='heavy') ? m.heavy : m.light;
  }
  const maxSpd=CHOG_DEF.speed*speedMul;

  const tx = moving ? wx*maxSpd : 0;
  const tz = moving ? wz*maxSpd : 0;
  const k = P.onGround ? (P.moveLock>0?5:16) : (P.moveLock>0?0.7:2.4);
  const dp = Math.exp(-k*dt);
  P.vx = P.vx*dp + tx*(1-dp);
  P.vz = P.vz*dp + tz*(1-dp);

  /* turn only when not mid-swing: the attack snapped to the machine on
     startup, and steering the body away would make it whiff */
  if(moving && canAct && P.moveLock<=0 && P.dashT<=0){
    P.facing=angLerp(P.facing, Math.atan2(wx,wz), 1-Math.exp(-18*dt));
  }

  /* dash ----------------------------------------------------------------
     It used to be a sprint: fast, but with no invulnerability, so dashing
     straight through a coin still hit you. Walking was the only defensive
     verb in the game. It is now a dodge - 0.15 s intangible - and it can be
     used during the recovery of your own swing, so committing to a heavy is
     no longer a death sentence you cannot escape.
     -------------------------------------------------------------------- */
  const inRecover = P.attackT>0 && (()=>{
    const a=ATTACKS[P.attackType]; if(!a) return false;
    const el=(a.startup+a.active+a.recovery)-P.attackT;
    return el >= a.startup+a.active;
  })();
  if(Input.dash && P.dashCd<=0 && (canAct || inRecover) && P.moveLock<=0){
    if(inRecover){ P.attackT=0; P.attackType=null; P.attackPhase=''; P.hitSet.clear(); }
    let dx=wx, dz=wz;
    if(Math.hypot(dx,dz)<0.1){ dx=Math.sin(P.facing); dz=Math.cos(P.facing); }
    const dl=Math.hypot(dx,dz)||1;
    P.dashVecX=dx/dl; P.dashVecZ=dz/dl;
    P.vx=P.dashVecX*24; P.vz=P.dashVecZ*24;
    if(!P.onGround) P.vy=Math.max(P.vy,1.5);
    P.dashT=0.22; P.dashCd=1.05; P.moveLock=0.16;
    P.invuln=Math.max(P.invuln,0.15);   /* the dodge window */
    P.facing=Math.atan2(P.dashVecX,P.dashVecZ);
    SFX.dash();
    for(let i=0;i<6;i++){
      const chip=new THREE.Mesh(new THREE.BoxGeometry(0.3,0.3,0.3),
        new THREE.MeshBasicMaterial({color:CHOG_DEF.colors.accent}));
      chip.position.set(P.pos.x-P.dashVecX*(i*0.5), P.pos.y+0.8, P.pos.z-P.dashVecZ*(i*0.5));
      scene.add(chip);
      fx.push({m:chip,life:0.32,max:0.32,type:'chip',vy:1.4});
    }
  }
  if(P.dashT>0) P.dashT=Math.max(0,P.dashT-dt);

  /* jump */
  if(Input.jumpPressed && canAct && P.moveLock<=0){
    if(P.onGround || P.coyote>0){
      P.vy=CHOG_DEF.jump; P.onGround=false; P.coyote=0; P.jumpsLeft=1;
      SFX.jump();
    } else if(P.jumpsLeft>0){
      P.vy=CHOG_DEF.jump*0.92; P.jumpsLeft--; P.vx*=0.75; P.vz*=0.75;
      SFX.jump();
    }
  }
  Input.jumpPressed=false;

  /* attack */
  const want = queuedAttack || (Input.q?'quick':null) || (Input.h?'heavy':null);
  if(want && canAct && P.moveLock<=0 && P.attackT<=0){
    queuedAttack=null;
    P.attackType=want;
    const atk=ATTACKS[want];
    P.attackT=atk.startup+atk.active+atk.recovery;
    P.attackPhase='';
    P.hitSet.clear();
    /* snap to the boss if it is close, so close-range swings do not whiff
       backwards when you have walked past it */
    if(boss && !boss.dead){
      const bd=dist2D(P.pos.x,P.pos.z,boss.pos.x,boss.pos.z);
      if(bd<7) P.facing=Math.atan2(boss.pos.x-P.pos.x, boss.pos.z-P.pos.z);
    }
  }
  if(P.attackT>0){
    P.attackT=Math.max(0,P.attackT-dt);
    const atk=ATTACKS[P.attackType];
    const total=atk.startup+atk.active+atk.recovery;
    const el=total-P.attackT;
    if(el>=atk.startup && el<atk.startup+atk.active){
      if(P.attackPhase!=='active'){ P.attackPhase='active'; SFX.swing(); }
      tryPlayerHit(atk);
    }
    if(P.attackT<=0){ P.attackType=null; P.attackPhase=''; P.hitSet.clear(); }
  }

  /* integrate */
  const prevY=P.pos.y;
  P.vy+=GRAV*dt;
  if(P.vy<-60) P.vy=-60;
  P.pos.x+=P.vx*dt; P.pos.z+=P.vz*dt; P.pos.y+=P.vy*dt;

  if(P.pos.y<=0){
    if(!P.onGround && P.vy<-6){
      const impact=clamp(-P.vy/34,0,1);
      SFX.land(impact);
      P.landSquash=0.16+impact*0.24;
      P.landSquashAmt=0.09+impact*0.20;
      if(impact>0.5) G.shake=Math.max(G.shake,(impact-0.5)*0.5);
    }
    P.pos.y=0; P.vy=0; P.onGround=true; P.jumpsLeft=2; P.coyote=0.12;
  } else {
    if(P.onGround) P.coyote=0.12;
    P.onGround=false;
    P.coyote=Math.max(0,P.coyote-dt);
  }

  /* body + prop collision */
  pushOutOfBoss();
  pushOutOfProps(P.pos, 0.75);

  P.pos.x=clamp(P.pos.x, BOUNDS.xMin, BOUNDS.xMax);
  P.pos.z=clamp(P.pos.z, BOUNDS.zMin, BOUNDS.zMax);
}

function pushOutOfBoss(){
  if(!boss || boss.dead) return;
  const dx=P.pos.x-boss.pos.x, dz=P.pos.z-boss.pos.z;
  const d=Math.hypot(dx,dz)||1;
  const minD=boss.radius+0.72;
  if(d<minD){
    const nx=dx/d, nz=dz/d;
    const push=minD-d;
    /* radial + tangential: you slide around the cabinet rather than being
       carried in front of it for the length of the block */
    P.pos.x += nx*push + (-nz)*push*0.85;
    P.pos.z += nz*push + ( nx)*push*0.85;
  }
}

function pushOutOfProps(p, radius){
  for(const o of OBSTACLES){
    const dx=p.x-o.x, dz=p.z-o.z;
    const d=Math.hypot(dx,dz)||1;
    const minD=o.r+radius;
    if(d<minD){
      p.x=o.x+(dx/d)*minD;
      p.z=o.z+(dz/d)*minD;
    }
  }
}

function tryPlayerHit(atk){
  if(!boss || boss.dead) return;
  if(P.hitSet.has(boss)) return;
  const dx=boss.pos.x-P.pos.x, dz=boss.pos.z-P.pos.z;
  const d=Math.hypot(dx,dz)||1;
  if(d > atk.range + boss.radius) return;
  const dot=(dx*Math.sin(P.facing)+dz*Math.cos(P.facing))/d;
  if(dot < Math.cos(atk.arc)) return;
  P.hitSet.add(boss);
  hurtBoss(atk.dmg, {fromX:P.pos.x, fromZ:P.pos.z});
  G.hitstop=Math.max(G.hitstop, atk.hitstop);
  G.shake=Math.max(G.shake, atk.shake);
  SFX[atk.sound]();
}

/* ----------------------------- boss update ----------------------------- */
const ACT={
  /* Wind-ups are deliberately longer than the player's heavy attack (0.71 s).
     A 0.62 s tilt meant that committing to a heavy made the tilt literally
     unavoidable - you were locked for longer than the warning lasted. */
  dispense:{ wind:0.55, active:0.06, rec:0.30 },
  coins:   { wind:0.48, active:0.30, rec:0.28 },
  tilt:    { wind:0.88, active:0.14, rec:0.62 },
  shards:  { wind:0.55, active:0.06, rec:0.30 },
  lunge:   { wind:0.75, active:0.50, rec:0.80 },
  /* phase 3 only. The one attack you answer with JUMP instead of a dodge,
     so the last third of the fight asks for a different input. */
};

function updateBoss(dt){
  if(!boss || boss.dead) return;
  const b=boss;
  b.hitFlash=Math.max(0,b.hitFlash-dt);
  if(b.heat>0){
    b.heat=Math.max(0,b.heat-dt);
    if(b.heat===0) SFX.coolHiss();
  }
  b.stateT+=dt;

  /* relocation clock runs regardless of what it is doing, so a machine that
     attacks constantly still crosses the block */
  if(!b.roamDest){
    b.roamT-=dt;
    if(b.roamT<=0) startRoam(b);
  }

  /* the pane: crack for a beat, then go. The door itself never opens — the
     frame stays, which is what makes it read as a broken machine rather than
     a cupboard someone left ajar. */
  if(b.crackT>0){
    b.crackT-=dt;
    b.crack.material.opacity=clamp(1-b.crackT/0.26,0,1)*0.85;
    if(b.crackT<=0) shatterGlass(b);
  }
  updateStock(dt);

  /* facing: phase 1 tracks constantly, phase 2 turns slower so you can flank */
  const dx=P.pos.x-b.pos.x, dz=P.pos.z-b.pos.z;
  const d=Math.hypot(dx,dz)||1;
  const turnRate = b.phase===1 ? 9 : 3.4;
  b.heading=angLerp(b.heading, Math.atan2(dx,dz), 1-Math.exp(-turnRate*dt));
  if(b.heading>Math.PI) b.heading-=TAU; else if(b.heading<-Math.PI) b.heading+=TAU;

  switch(b.phaseState){
    case 'idle': {
      /* restock gets first refusal: it is the beat the fight is built around */
      if(maybeRestock(b)) break;
      if(b.phase===1) hoverMove(b,dt,1);
      else stalkMove(b,dt,d);
      b.idleT-=dt;
      if(b.idleT<=0) beginAction(b,d);
      break;
    }
    case 'restock': {
      plantMove(b,dt);
      const t=clamp(b.stateT/RESTOCK_TIME,0,1);
      if(b.restockDone<1 && t>0.36){ b.restockDone=1; healBossCans(b,1); }
      if(b.restockDone<2 && t>0.74){ b.restockDone=2; healBossCans(b,1); }
      if(b.stateT>=RESTOCK_TIME){
        b.phaseState='idle'; b.stateT=0;
        b.idleT=nextCooldown(); b.action=null;
      }
      break;
    }
    case 'stagger': {
      plantMove(b,dt);
      if(b.stateT>=1.5){
        b.phaseState='idle'; b.stateT=0;
        b.idleT=nextCooldown(); b.action=null;
      }
      break;
    }
    case 'windup': {
      if(b.phase===1) hoverMove(b,dt,0.88);
      else plantMove(b,dt);
      if(b.stateT>=b.windup){
        b.phaseState='active'; b.stateT=0;
        if(b.action==='lunge') startLunge(b,dx,dz,d);
        else fireAction(b,dx,dz,d);
      }
      break;
    }
    case 'active': {
      if(b.action==='lunge') lungeMove(b,dt);
      else if(b.phase===1) hoverMove(b,dt,0.80);
      else plantMove(b,dt);

      /* coin volley: second wave, so panic-jumping lands you into it */
      if(b.action==='coins'){
        if(!b.wave1){ b.wave1=true; fireCoins(b,dx,dz); }
        if(b.stateT>0.26 && !b.wave2){ b.wave2=true; fireCoins(b,dx,dz); }
      }
      if(b.action==='lunge' && b.lungeHit) b.stateT=Math.max(b.stateT,b.activeT);
      if(b.stateT>=b.activeT){
        b.phaseState='recover'; b.stateT=0;
        if(b.action==='lunge') G.shake=Math.max(G.shake,0.35);
      }
      break;
    }
    case 'recover': {
      if(b.phase===1) hoverMove(b,dt,0.88);
      else plantMove(b,dt);
      if(b.stateT>=b.recoverT){
        b.phaseState='idle'; b.stateT=0;
        b.idleT=nextCooldown();
        b.action=null;
      }
      break;
    }
  }

  /* stay on the floor, off the props, inside the block */
  pushOutOfProps(b.pos, b.radius);
  b.pos.x=clamp(b.pos.x, BOSS_BOUNDS.xMin, BOSS_BOUNDS.xMax);
  b.pos.z=clamp(b.pos.z, BOSS_BOUNDS.zMin, BOSS_BOUNDS.zMax);
}

function nextCooldown(){
  /* A flat cooldown makes the machine metronomic: always the same beat, so
     the fight has a tempo instead of a rhythm. The pause now depends on what
     it just did - long after a lunge (your reward), short after a cheap
     dispense (pressure) - and drifts +/-15% so you cannot count it. */
  const base = boss.phase>=3 ? 0.38 : Math.max(0.45, 1.05 - boss.phase*0.22);
  const last = boss.lastAction;
  let mul = 1;
  if(last==='lunge') mul = 1.35;
  else if(last==='tilt') mul = 1.20;
  else if(last==='dispense') mul = 0.72;
  return base * mul * (0.85 + Math.random()*0.30);
}

function beginAction(b,d){
  const pool=[];
  if(b.phase>=3){
    /* sold out: no stock to throw, so it only has its own weight */
    pool.push('lunge','lunge','lunge','lunge');
    if(d<7) pool.push('tilt');
  } else if(b.phase===1){
    pool.push('dispense');
    if(d>7.5) pool.push('coins','coins');
    if(d<7.5) pool.push('tilt','tilt');
  } else {
    /* lunge is the identity of phase 2, so it dominates the pool */
    if(d>4.5) pool.push('lunge','lunge','lunge','lunge');
    pool.push('dispense');
    if(d>7.5) pool.push('coins');
    if(d<7) pool.push('tilt');
    if(d>9) pool.push('shards');
  }
  let pick=pool[Math.floor(Math.random()*pool.length)];
  let guard=0;
  while(pick===b.lastAction && guard++<10){
    pick=pool[Math.floor(Math.random()*pool.length)];
  }
  b.lastAction=pick;
  b.action=pick;
  const a=ACT[pick];
  b.windup=a.wind; b.activeT=a.active; b.recoverT=a.rec;
  b.phaseState='windup'; b.stateT=0;
  b.wave1=false; b.wave2=false; b.lungeHit=false;

  /* the audio tell fires at the START of the wind-up, before anything is
     visible — that is the whole point of it */
  /* Sound is the primary tell. Each cue is a different thing a real vending
     machine does, so the player learns the machine, not a UI convention. */
  if(pick==='dispense') SFX.vendCoil();
  else if(pick==='coins') SFX.coinMech();
  else if(pick==='tilt') SFX.tiltSpinUp();
  else if(pick==='shards') SFX.glassTinkle();
  else if(pick==='lunge') SFX.castorSqueal();
}

function fireAction(b,dx,dz,d){
  if(b.action==='dispense') fireCans(b);
  else if(b.action==='tilt') doTilt(b,d);
  else if(b.action==='shards') fireShards(b,dx,dz);
}

/* ------------------------- locomotion: phase 1 ------------------------- */
function hoverMove(b,dt,scale){
  let tx,tz,want;

  if(b.roamDest){
    const dx=b.roamDest[0]-b.pos.x, dz=b.roamDest[1]-b.pos.z;
    const d=Math.hypot(dx,dz)||1;
    if(d<2.0){ b.roamDest=null; b.roamT=rand(2.6,4.0); return; }
    tx=dx/d; tz=dz/d;
    /* a relocation is not interrupted by throwing — it keeps moving */
    want=ROAM_SPEED*Math.max(scale,0.94);
  } else {
    const dx=P.pos.x-b.pos.x, dz=P.pos.z-b.pos.z;
    const d=Math.hypot(dx,dz)||1;
    tx=dx/d; tz=dz/d;
    want = d<3.6 ? -2.6 : (d<5.0 ? 0 : 8.5);
    want*=scale;
  }

  b.velX=damp(b.velX,tx*want,3.5,dt);
  b.velZ=damp(b.velZ,tz*want,3.5,dt);
  b.pos.x+=b.velX*dt;
  b.pos.z+=b.velZ*dt;
  b.speed=Math.hypot(b.velX,b.velZ);
}

/* ------------------------- locomotion: phase 2 ------------------------- */
function stalkMove(b,dt,d){
  if(b.roamDest){
    const rx=b.roamDest[0]-b.pos.x, rz=b.roamDest[1]-b.pos.z;
    const rd=Math.hypot(rx,rz)||1;
    if(rd<2.2){ b.roamDest=null; b.roamT=rand(2.6,4.0); return; }
    b.heading=angLerp(b.heading,Math.atan2(rx,rz),1-Math.exp(-4.5*dt));
    b.speed=damp(b.speed,ROAM_SPEED*0.92,4,dt);
    b.pos.x+=Math.sin(b.heading)*b.speed*dt;
    b.pos.z+=Math.cos(b.heading)*b.speed*dt;
    b.velX=Math.sin(b.heading)*b.speed;
    b.velZ=Math.cos(b.heading)*b.speed;
    return;
  }
  const dx=P.pos.x-b.pos.x, dz=P.pos.z-b.pos.z;
  const want=Math.atan2(dx,dz);
  b.heading=angLerp(b.heading,want,1-Math.exp(-3.2*dt));
  const creep = d>10 ? 4.2 : 2.8;
  const approach = d>6.0 ? 1 : (d<3.2 ? -0.6 : 0.5);
  b.speed=damp(b.speed, creep*approach, 4, dt);
  b.pos.x+=Math.sin(b.heading)*b.speed*dt;
  b.pos.z+=Math.cos(b.heading)*b.speed*dt;
  b.velX=Math.sin(b.heading)*b.speed;
  b.velZ=Math.cos(b.heading)*b.speed;
}

function plantMove(b,dt){
  b.speed=damp(b.speed,0,10,dt);
  b.pos.x+=Math.sin(b.heading)*b.speed*dt;
  b.pos.z+=Math.cos(b.heading)*b.speed*dt;
  b.velX=0; b.velZ=0;
}

function startLunge(b,dx,dz,d){
  b.lungeDX=dx/d; b.lungeDZ=dz/d;
  b.speed=22;
  b.lungeHit=false;
  SFX.lungeGo();
}

function lungeMove(b,dt){
  b.speed=damp(b.speed,22,12,dt);
  b.pos.x+=b.lungeDX*b.speed*dt;
  b.pos.z+=b.lungeDZ*b.speed*dt;
  b.heading=Math.atan2(b.lungeDX,b.lungeDZ);

  /* the charge is the damage. It cannot steer, so stepping aside is the answer */
  if(!b.lungeHit){
    const d=dist2D(P.pos.x,P.pos.z,b.pos.x,b.pos.z);
    if(d < b.radius+1.0){
      b.lungeHit=true;
      hurtPlayer(24, b.pos.x, b.pos.z, 28);
      G.hitstop=Math.max(G.hitstop,0.09);
      G.shake=Math.max(G.shake,0.8);
      SFX.hitHeavy();
    }
  }
}

/* ------------------------------ attacks -------------------------------- */
function canOrigin(){
  const b=boss;
  return new THREE.Vector3(
    b.pos.x+Math.sin(b.heading)*1.55,
    2.2,
    b.pos.z+Math.cos(b.heading)*1.55
  );
}

function fireCans(b){
  const o=canOrigin();
  for(let i=-1;i<=1;i++){
    /* aim where you are going, then solve the arc so it LANDS there */
    const lead=0.35;
    let tx=P.pos.x+P.vx*lead+rand(-1.6,1.6);
    let tz=P.pos.z+P.vz*lead+rand(-1.6,1.6);
    tx=clamp(tx,BOUNDS.xMin+1,BOUNDS.xMax-1);
    tz=clamp(tz,BOUNDS.zMin+1,BOUNDS.zMax-1);
    spawnCan(o.x,o.y,o.z, tx+Math.sin(b.heading+i*0.18)*0.9, tz+Math.cos(b.heading+i*0.18)*0.9);
  }
}

function fireCoins(b,dx,dz){
  /* firing this much current heats the compressor — the window that makes
     "bait the volley, then close in" a real strategy */
  b.heat=2.5; SFX.heatWhine();
  const d=Math.hypot(dx,dz)||1;
  const base=Math.atan2(dx,dz);
  const oy=COIN.Y;
  const ox=b.pos.x+Math.sin(base)*1.4;
  const oz=b.pos.z+Math.cos(base)*1.4;
  for(let i=0;i<7;i++){
    const a=base+(i-3)*0.055;
    spawnCoin(ox,oy,oz,Math.sin(a)*COIN.SPEED,Math.cos(a)*COIN.SPEED);
  }
}

function fireShards(b,dx,dz){
  b.heat=2.5; SFX.heatWhine();
  const base=Math.atan2(dx,dz);
  for(let i=-2;i<=2;i++){
    const a=base+i*0.16;
    const m=new THREE.Mesh(new THREE.BoxGeometry(0.18,0.18,0.7),
      new THREE.MeshBasicMaterial({color:0x9FE8FF}));
    m.position.set(b.pos.x+Math.sin(base)*1.6, 2.4, b.pos.z+Math.cos(base)*1.6);
    m.rotation.y=a;
    scene.add(m);
    coins.push({mesh:m,pos:m.position.clone(),vx:Math.sin(a)*21,vz:Math.cos(a)*21,
      r:0.42,dmg:10,life:1.5,kind:'shard',spin:0});
  }
}

function doTilt(b,d){
  if(d<6.4){
    hurtPlayer(24, b.pos.x, b.pos.z, 34);
  }
  /* Slamming the whole cabinet onto its face dumps the compressor.
     This is the fix for the mount being unreachable: overheat used to come
     ONLY from coins and shards, and the machine only fires those when you are
     far away - so the vents never lit up at the range you actually fight at.
     Measured before: 90 s of close-range play produced 0.0 s of overheat. */
  b.heat=Math.max(b.heat,1.8);
  G.shake=1.0;
  G.hitstop=Math.max(G.hitstop,0.08);
  SFX.tiltSlam();
  const ring=new THREE.Mesh(new THREE.RingGeometry(0.9,1.1,40),
    new THREE.MeshBasicMaterial({color:0xFF7A3D,transparent:true,opacity:0.85,side:THREE.DoubleSide,depthWrite:false}));
  ring.rotation.x=-Math.PI/2;
  ring.position.set(b.pos.x,0.09,b.pos.z);
  scene.add(ring);
  fx.push({m:ring,life:0.42,max:0.42,type:'expand',r0:1.0,r1:6.4});
}

/* ------------------------------- cans ----------------------------------
   A real 330ml can: 66mm across, 122mm tall, necked shoulder, rolled rim,
   a printed label wrapped round the middle. The old one was a plain cylinder
   with two discs on the ends, which is why it read as a capsule.
   ---------------------------------------------------------------------- */
let CAN_GEO=null, CAN_LABEL_GEO=null;
function canGeometries(){
  if(CAN_GEO) return;
  const H=0.46;
  /* profile from the base up: foot, straight wall, shoulder, neck, rim, lid */
  /* A real can is roughly 70% straight wall, then a short shoulder, a neck and
     a rolled rim. The first pass gave the shoulder a third of the height and it
     rendered as an egg. */
  const pts=[
    [0.000,-0.230],[0.076,-0.230],[0.106,-0.226],[0.126,-0.216],
    [0.134,-0.200],[0.135,-0.168],[0.135, 0.108],
    [0.132, 0.140],[0.118, 0.170],[0.098, 0.192],
    [0.090, 0.203],[0.090, 0.213],[0.101, 0.220],
    [0.097, 0.226],[0.070, 0.229],[0.000, 0.229]
  ].map(q=>new THREE.Vector2(q[0],q[1]));
  CAN_GEO=new THREE.LatheGeometry(pts,24);
  CAN_LABEL_GEO=new THREE.CylinderGeometry(0.1368,0.1368,0.268,24,1,true);
}

const canLabelCache=new Map();
function canLabelTex(hex,flavour){
  const key=hex+'|'+flavour;
  if(canLabelCache.has(key)) return canLabelCache.get(key);
  const cv=document.createElement('canvas'); cv.width=512; cv.height=256;
  const c=cv.getContext('2d');
  c.fillStyle='#'+new THREE.Color(hex).getHexString();
  c.fillRect(0,0,512,256);
  /* the exposed aluminium bands a printed can always has at both ends */
  c.fillStyle='#C9CDD6'; c.fillRect(0,0,512,9); c.fillRect(0,247,512,9);
  /* a cylinder is lit on one side, so print a matching sweep into the label */
  const g=c.createLinearGradient(0,0,512,0);
  g.addColorStop(0.00,'rgba(255,255,255,0.30)');
  g.addColorStop(0.32,'rgba(255,255,255,0.04)');
  g.addColorStop(0.72,'rgba(0,0,0,0.16)');
  g.addColorStop(1.00,'rgba(255,255,255,0.10)');
  c.fillStyle=g; c.fillRect(0,0,512,256);
  c.textAlign='center'; c.textBaseline='middle';
  c.fillStyle='#FFFFFF';
  c.font='700 58px Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif';
  c.fillText('SNAX',128,104); c.fillText('SNAX',384,104);
  c.fillStyle='rgba(255,255,255,0.88)';
  c.font='700 21px Arial, sans-serif';
  c.fillText(flavour,128,148); c.fillText(flavour,384,148);
  /* barcode, because every can has one and it catches the eye at small size */
  c.fillStyle='#F3E7D3'; c.fillRect(214,196,84,38);
  c.fillStyle='#0B0712';
  for(let i=0;i<22;i++) c.fillRect(218+i*3.4,200,(i%3?1:2),30);
  const t=new THREE.CanvasTexture(cv); t.anisotropy=4;
  canLabelCache.set(key,t); return t;
}

function makeCanMesh(labelColor, flavour){
  canGeometries();
  const g=new THREE.Group();
  /* metalness=0.95 with a dim environment renders near-black, which is what
     turned the first pass into dark domes. 0.72 keeps the sheen while letting
     the base colour read, and a trace of emissive stops it crushing. */
  const alu=new THREE.MeshStandardMaterial({
    color:0xD5D9E1, metalness:0.72, roughness:0.30, envMapIntensity:2.4,
    emissive:0x12151A
  });
  const body=new THREE.Mesh(CAN_GEO, alu);
  body.castShadow=true; g.add(body);

  const labelMat=new THREE.MeshStandardMaterial({
    map:canLabelTex(labelColor,flavour), metalness:0.14, roughness:0.44,
    envMapIntensity:0.9, emissive:new THREE.Color(labelColor).multiplyScalar(0.10)
  });
  const labelMesh=new THREE.Mesh(CAN_LABEL_GEO,labelMat);
  labelMesh.position.y=-0.032;
  g.add(labelMesh);

  /* the pull tab and the recessed lid — the two details that say "can" */
  const tab=new THREE.Mesh(new THREE.TorusGeometry(0.030,0.008,6,12), alu);
  tab.rotation.x=Math.PI/2; tab.position.set(0,0.236,0); g.add(tab);
  const lid=new THREE.Mesh(new THREE.CylinderGeometry(0.058,0.058,0.006,14), alu);
  lid.position.y=0.2345; g.add(lid);

  return {group:g, mats:[alu,labelMat]};
}

function spawnCan(fx0,fy0,fz0,tx,tz){
  const dx=tx-fx0, dz=tz-fz0;
  const d=Math.hypot(dx,dz)||1;
  /* solve for the launch velocity that arrives at (tx, LAND_Y, tz) in T */
  const T=clamp(d/15,0.46,0.86);
  const g=CAN.G;
  const vx=dx/T;
  const vz=dz/T;
  const vy=((CAN.LAND_Y-fy0)/T) + 0.5*g*T;

  const ci=(Math.random()*canCols.length)|0;
  const col=canCols[ci];
  const built=makeCanMesh(col,canFlavours[ci]);
  built.group.scale.setScalar(1.25);
  /* tumble end over end about the axis perpendicular to travel, which is what
     a thrown can actually does */
  const hspd=Math.hypot(vx,vz)||1;
  const spinAxis=new THREE.Vector3(vz/hspd,0,-vx/hspd).normalize();
  const pos=new THREE.Vector3(fx0,fy0,fz0);
  built.group.position.copy(pos);
  scene.add(built.group);

  const blob=new THREE.Mesh(new THREE.CircleGeometry(0.30,12),
    new THREE.MeshBasicMaterial({color:0x000000,transparent:true,opacity:0.35,depthWrite:false}));
  blob.rotation.x=-Math.PI/2;
  blob.position.set(pos.x,0.055,pos.z);
  scene.add(blob);

  const ring=new THREE.Mesh(new THREE.RingGeometry(0.86,1.0,36),
    new THREE.MeshBasicMaterial({color:0xFFD24A,transparent:true,opacity:0.75,
      side:THREE.DoubleSide,depthWrite:false}));
  ring.rotation.x=-Math.PI/2;
  ring.position.set(pos.x,0.075,pos.z);
  ring.visible=false;
  scene.add(ring);

  cans.push({
    mesh:built.group, mats:built.mats, blob, ring,
    pos, vel:new THREE.Vector3(vx,vy,vz),
    spinAxis, spinRate:rand(9,15), settled:false, flatQ:new THREE.Quaternion(),
    baseScale:1.25,
    fuse:CAN.FUSE, landed:false, tickT:0, dead:false
  });
}
const canCols=[0xE8344E,0x2FA8E0,0xE8A020,0x3FB04A,0x8A4AE0];
const canFlavours=['CHERRY','ICE','CITRUS','LIME','GRAPE'];

function updateCans(dt){
  for(let i=cans.length-1;i>=0;i--){
    const c=cans[i];
    if(c.dead){ cans.splice(i,1); continue; }

    c.fuse-=dt;

    /* flight */
    c.vel.y-=CAN.G*dt;
    c.pos.addScaledVector(c.vel,dt);
    c.mesh.position.copy(c.pos);
    if(c.settled){
      c.mesh.quaternion.slerp(c.flatQ, 1-Math.exp(-9*dt));
      c.pos.y=damp(c.pos.y,0.180,7,dt);
    } else {
      _canQ.setFromAxisAngle(c.spinAxis, c.spinRate*dt);
      c.mesh.quaternion.premultiply(_canQ);
    }

    /* ground shadow, which is what actually sells the arc */
    c.blob.position.set(c.pos.x,0.055,c.pos.z);
    const hgt=clamp(c.pos.y,0,14);
    c.blob.scale.setScalar(clamp(1.25-hgt*0.055,0.42,1.25));
    c.blob.material.opacity=clamp(0.42-hgt*0.022,0.06,0.42);

    /* direct hit bursts it early */
    const pd=dist2D(c.pos.x,c.pos.z,P.pos.x,P.pos.z);
    if(!P.dead && pd<0.85 && c.pos.y>P.pos.y-0.2 && c.pos.y<P.pos.y+3.3){
      hurtPlayer(10, c.pos.x, c.pos.z, 8);
      burstCan(c); continue;
    }

    /* bounce, then settle onto its side — a can that has stopped rolling is
       lying down, not standing to attention */
    if(!c.settled && c.pos.y<=0.36){
      c.pos.y=0.36;
      if(!c.landed){
        c.landed=true;
        if(c.vel.y<-4) SFX.canClink();
      }
      c.vel.y*=-0.42;
      c.vel.x*=0.70; c.vel.z*=0.70;
      if(Math.abs(c.vel.y)<1.6){
        c.vel.y=0;
        c.settled=true;
        const ax=Math.hypot(c.vel.x,c.vel.z);
        const dir=ax>0.5
          ? new THREE.Vector3(c.vel.x/ax,0,c.vel.z/ax)
          : new THREE.Vector3(c.spinAxis.z,0,-c.spinAxis.x);
        c.flatQ.setFromUnitVectors(new THREE.Vector3(0,1,0),dir);
      }
    }

    /* blink phase, then detonate */
    if(c.fuse<=CAN.BLINK){
      const k=1-clamp(c.fuse/CAN.BLINK,0,1);
      c.ring.visible=true;
      c.ring.position.set(c.pos.x,0.075,c.pos.z);
      c.ring.scale.setScalar(0.5+k*2.0);
      c.ring.material.color.setHSL(0.13-k*0.13,1,0.55);
      c.ring.material.opacity=0.45+Math.abs(Math.sin(c.fuse*26))*0.45;

      const pulse=Math.abs(Math.sin(c.fuse*30));
      for(const m of c.mats) m.emissive.setRGB(pulse*0.95,pulse*0.34,0);
      /* scale is the mesh's 1.7 world scale times the pulse. Setting it to
         1+pulse was silently shrinking the can to 60% as it armed. */
      c.mesh.scale.setScalar(c.baseScale*(1+pulse*0.055));

      c.tickT-=dt;
      if(c.tickT<=0){ c.tickT=0.22; SFX.canTick(); }
    }

    if(c.fuse<=0) burstCan(c);
  }
}

function burstCan(c){
  if(c.dead) return;
  c.dead=true;

  const d=dist2D(c.pos.x,c.pos.z,P.pos.x,P.pos.z);
  if(d<CAN.R && !P.dead){
    const fall=1-d/CAN.R;
    hurtPlayer(8+fall*9, c.pos.x, c.pos.z, 10+fall*8);
  }

  /* shards, ring, flash */
  for(let i=0;i<12;i++){
    const a=Math.random()*TAU;
    const sp=rand(4,9);
    const m=new THREE.Mesh(new THREE.BoxGeometry(0.16,0.05,0.10),
      new THREE.MeshPhongMaterial({color:Math.random()<0.5?0xC8C8D2:0xF3E7D3,shininess:80}));
    m.position.copy(c.pos);
    scene.add(m);
    fx.push({m,life:0.7,max:0.7,type:'shard',
      vx:Math.cos(a)*sp, vy:rand(4,9), vz:Math.sin(a)*sp,
      rx:rand(-9,9), rz:rand(-9,9)});
  }
  const ring=new THREE.Mesh(new THREE.RingGeometry(0.8,1.0,36),
    new THREE.MeshBasicMaterial({color:0xFFC46A,transparent:true,opacity:0.9,
      side:THREE.DoubleSide,depthWrite:false}));
  ring.rotation.x=-Math.PI/2;
  ring.position.set(c.pos.x,0.10,c.pos.z);
  scene.add(ring);
  fx.push({m:ring,life:0.34,max:0.34,type:'expand',r0:1.0,r1:CAN.R*1.15});

  const flash=new THREE.Mesh(new THREE.SphereGeometry(0.7,10,8),
    new THREE.MeshBasicMaterial({color:0xFFE0A8,transparent:true,opacity:0.85,
      blending:THREE.AdditiveBlending,depthWrite:false}));
  flash.position.copy(c.pos);
  scene.add(flash);
  fx.push({m:flash,life:0.18,max:0.18,type:'flash'});

  G.shake=Math.max(G.shake,0.55);
  G.hitstop=Math.max(G.hitstop,0.05);
  SFX.canBurst();
  removeCan(c);
}

function removeCan(c){
  scene.remove(c.mesh); scene.remove(c.blob); scene.remove(c.ring);
  /* CAN_GEO and CAN_LABEL_GEO are shared by every can in flight. Disposing
     them here would blank every can spawned after the first burst. */
  for(const m of c.mats) m.dispose();
  c.blob.geometry.dispose(); c.ring.geometry.dispose();
}

/* ------------------------------- coins --------------------------------- */
function makeCoinMesh(){
  const outer=new THREE.Group();
  const inner=new THREE.Group();
  inner.rotation.x=Math.PI/2;
  inner.rotation.z=0.10;
  const gold=new THREE.MeshPhongMaterial({color:0xE8B33A,shininess:110,
    specular:0xFFF2C0,emissive:0x2A1E00});
  const disc=new THREE.Mesh(new THREE.CylinderGeometry(0.24,0.24,0.05,16),gold);
  disc.castShadow=true;
  inner.add(disc);
  const relief=new THREE.Mesh(new THREE.CylinderGeometry(0.17,0.17,0.064,16),
    new THREE.MeshPhongMaterial({color:0xC89428,shininess:90,specular:0xFFE9A8}));
  inner.add(relief);
  outer.add(inner);
  return {outer,gold};
}

function spawnCoin(x,y,z,vx,vz){
  const built=makeCoinMesh();
  built.outer.position.set(x,y,z);
  /* face the direction of travel, then spin about the vertical so it flashes
     face / edge / face — the classic coin glint */
  built.outer.rotation.y=Math.atan2(vx,vz);
  scene.add(built.outer);
  coins.push({
    mesh:built.outer, gold:built.gold,
    pos:new THREE.Vector3(x,y,z),
    vx, vz, r:COIN.R, dmg:COIN.DMG, life:1.7, kind:'coin',
    spinBase:Math.atan2(vx,vz), spin:0, dead:false
  });
}

function updateCoins(dt){
  for(let i=coins.length-1;i>=0;i--){
    const c=coins[i];
    if(c.dead){ coins.splice(i,1); continue; }

    c.life-=dt;
    c.pos.x+=c.vx*dt;
    c.pos.z+=c.vz*dt;   /* straight: no gravity, no bounce */
    c.mesh.position.copy(c.pos);

    if(c.kind==='coin'){
      c.spin+=14*dt;
      c.mesh.rotation.y=c.spinBase+c.spin;
    } else {
      c.mesh.rotation.z+=6*dt;
    }

    /* hit test. The coin is a disc at chest height, so the answer is to get
       your feet ABOVE it — a physical overlap test, not a distance band. */
    if(!P.dead){
      const coinBot=c.pos.y-0.28, coinTop=c.pos.y+0.28;
      const pBot=P.pos.y, pTop=P.pos.y+3.3;
      const overlapY = coinBot<pTop && coinTop>pBot;
      const pd=dist2D(c.pos.x,c.pos.z,P.pos.x,P.pos.z);
      if(overlapY && pd < c.r+0.70){
        if(P.invuln<=0){
          hurtPlayer(c.dmg, c.pos.x, c.pos.z, 7);
          if(c.kind==='coin') SFX.coinHit();
        }
        c.dead=true;
        scene.remove(c.mesh);
        coins.splice(i,1);
        continue;
      }
    }

    const out = c.pos.x<BOUNDS.xMin-3 || c.pos.x>BOUNDS.xMax+3 ||
                c.pos.z<BOUNDS.zMin-3 || c.pos.z>BOUNDS.zMax+3;
    if(c.life<=0 || out){
      scene.remove(c.mesh);
      coins.splice(i,1);
    }
  }
}

function removeCoin(c){ scene.remove(c.mesh); }

/* --------------------------------- fx ---------------------------------- */
function updateFx(dt){
  for(let i=fx.length-1;i>=0;i--){
    const f=fx[i];
    f.life-=dt;
    const k=clamp(f.life/f.max,0,1);

    if(f.type==='expand'){
      f.m.scale.setScalar(f.r0+(1-k)*(f.r1-f.r0));
      f.m.material.opacity=k*0.9;
    } else if(f.type==='flash'){
      f.m.scale.setScalar(1+(1-k)*2.0);
      f.m.material.opacity=k*0.85;
    } else if(f.type==='shard'){
      f.vy-=26*dt;
      f.m.position.x+=f.vx*dt;
      f.m.position.y+=f.vy*dt;
      f.m.position.z+=f.vz*dt;
      f.m.rotation.x+=f.rx*dt;
      f.m.rotation.z+=f.rz*dt;
      if(f.m.position.y<0.1){ f.m.position.y=0.1; f.vy*=-0.35; f.vx*=0.7; f.vz*=0.7; }
    } else if(f.type==='glass'){
      f.vy-=24*dt;
      f.m.position.x+=f.vx*dt;
      f.m.position.y+=f.vy*dt;
      f.m.position.z+=f.vz*dt;
      f.m.rotation.x+=f.rx*dt;
      f.m.rotation.z+=f.rz*dt;
      f.m.material.opacity=0.62*k;
      if(f.m.position.y<0.12){
        f.m.position.y=0.12; f.vy*=-0.28; f.vx*=0.6; f.vz*=0.6;
      }
    } else if(f.type==='chip'){
      f.m.position.y+=f.vy*dt;
      f.vy-=20*dt;
      f.m.material.opacity=k;
      f.m.material.transparent=true;
    }

    if(f.life<=0){
      scene.remove(f.m);
      if(f.m.geometry) f.m.geometry.dispose();
      fx.splice(i,1);
    }
  }
}

/* ------------------------------ visuals -------------------------------- */
function animatePlayer(dt){
  const m=chog;
  const spd=Math.hypot(P.vx,P.vz);
  P.animT+=dt*(3.2+spd*0.85);

  m.root.position.copy(P.pos);
  m.root.rotation.y=P.facing;

  if(P.landSquash>0){
    const p=clamp(P.landSquash/(0.16+(P.landSquashAmt||0.1)*1.2),0,1);
    const amt=(P.landSquashAmt||0.1)*Math.sin(p*Math.PI);
    m.root.scale.set(0.8*(1+amt*0.7),0.8*(1-amt),0.8*(1+amt*0.7));
  } else if(Math.abs(m.root.scale.x-0.8)>0.001){
    m.root.scale.setScalar(0.8);
  }

  const walkAmt=clamp(spd/9,0,1);
  const bob=P.onGround ? Math.abs(Math.sin(P.animT*2))*0.055*walkAmt : 0;
  m.bodyPivot.position.y=bob;
  const swing=Math.sin(P.animT*2)*0.72*walkAmt;

  if(P.onGround){
    m.legL.rotation.x=swing; m.legR.rotation.x=-swing;
    m.armL.rotation.x=-swing*0.65; m.armR.rotation.x=swing*0.65;
    m.armL.rotation.z=0.06; m.armR.rotation.z=-0.06;
  } else {
    const tuck=clamp(P.vy*0.035,-0.5,0.5);
    m.legL.rotation.x=damp(m.legL.rotation.x,-0.4+tuck,12,dt);
    m.legR.rotation.x=damp(m.legR.rotation.x,-0.15-tuck,12,dt);
    m.armL.rotation.x=damp(m.armL.rotation.x,-1.1,10,dt);
    m.armR.rotation.x=damp(m.armR.rotation.x,-1.1,10,dt);
    m.armL.rotation.z=0.35; m.armR.rotation.z=-0.35;
  }

  /* --- mount pose -----------------------------------------------------
     Without this the Chog kept its normal airborne tuck while glued to a
     cabinet, which reads as a bug rather than a move. */
  if(P.mountT>0){
    const el=(MOUNT.leap+MOUNT.slam+MOUNT.off)-P.mountT;
    if(el<MOUNT.leap){
      /* reaching for the frame */
      m.armL.rotation.x=damp(m.armL.rotation.x,-2.3,16,dt);
      m.armR.rotation.x=damp(m.armR.rotation.x,-2.3,16,dt);
      m.armL.rotation.z=0.12; m.armR.rotation.z=-0.12;
      m.legL.rotation.x=damp(m.legL.rotation.x,0.55,14,dt);
      m.legR.rotation.x=damp(m.legR.rotation.x,0.25,14,dt);
    } else if(el<MOUNT.leap+MOUNT.slam){
      /* left hand grips the vent, right hand drives in */
      m.armL.rotation.x=damp(m.armL.rotation.x,-2.7,18,dt);
      m.armL.rotation.z=0.30;
      m.armR.rotation.x=damp(m.armR.rotation.x, P.mountHit? 1.15 : -2.5, 22, dt);
      m.armR.rotation.z=-0.10;
      m.legL.rotation.x=damp(m.legL.rotation.x,-1.0,16,dt);
      m.legR.rotation.x=damp(m.legR.rotation.x,0.75,16,dt);
      m.bodyPivot.rotation.x=damp(m.bodyPivot.rotation.x,0.28,12,dt);
    } else {
      m.bodyPivot.rotation.x=damp(m.bodyPivot.rotation.x,0,14,dt);
    }
    m.root.position.copy(P.pos);
    m.root.rotation.y=P.facing;
    return;
  } else if(Math.abs(m.bodyPivot.rotation.x)>0.001){
    m.bodyPivot.rotation.x=damp(m.bodyPivot.rotation.x,0,14,dt);
  }

  if(P.attackT>0 && P.attackType){
    const atk=ATTACKS[P.attackType];
    const total=atk.startup+atk.active+atk.recovery;
    const e=total-P.attackT;
    let p=0;
    if(e<atk.startup) p=e/atk.startup*0.35;
    else if(e<atk.startup+atk.active) p=0.35+((e-atk.startup)/atk.active)*0.65;
    else p=1-((e-atk.startup-atk.active)/atk.recovery);
    p=clamp(p,0,1);
    const amt=(P.attackType==='heavy')?1.25:0.95;
    m.armR.rotation.x=-p*2.3*amt; m.armR.rotation.z=-p*0.45;
    m.armL.rotation.x=-p*0.5;
    m.head.rotation.y=p*0.28; m.bodyPivot.rotation.y=-p*0.35;
  } else {
    m.head.rotation.y=damp(m.head.rotation.y,0,9,dt);
    m.bodyPivot.rotation.y=damp(m.bodyPivot.rotation.y,0,9,dt);
  }

  if(P.hitstun>0) m.bodyPivot.rotation.x=damp(m.bodyPivot.rotation.x,-0.45,18,dt);
  else m.bodyPivot.rotation.x=damp(m.bodyPivot.rotation.x,clamp(P.vy*0.012,-0.22,0.22),7,dt);

  if(P.flash>0){ for(const mt of m.mats) if(mt.emissive) mt.emissive.setHex(0xff3b30); }
  else { for(const mt of m.mats) if(mt.emissive) mt.emissive.setHex(mt.userData.baseEmissive||0); }

  if(P.hurtInvuln>0 && !P.dead) m.root.visible=(Math.floor(G.t*22)%2===0);
  else m.root.visible=true;

  playerLight.position.set(P.pos.x, P.pos.y+2.6, P.pos.z+1.2);
}

/* --------------------------- wind-up bodies -----------------------------
   Every attack used to share ONE pose (lean back 0.19, sink 0.13, lift the
   feet 0.13), and phase 1 skipped it entirely because its hover branch never
   reached the wind-up code. Captured side by side, lunge / dispense / shards
   were byte-identical images - so the only warning was the sound.

   Each attack now moves on a different axis, so you can read the answer
   without hearing anything:
     tilt      rocks back on its rear edge      -> get out of the disc
     lunge     crouches, nose DOWN              -> dash sideways
     dispense  stands still and buzzes          -> cans arc, jump them
     coins     traverses like a turret          -> it is aiming
     shards    rattles side to side             -> dash or eat it
   ---------------------------------------------------------------------- */
const WINDUP = {
  tilt:     k => ({ rotX:0,        shellY:-0.02*k, fl:0.26*k, fr:0.26*k, yaw:0 }),
  lunge:    k => ({ rotX:0.30*k,   shellY:-0.22*k, fl:0,      fr:0,      yaw:0 }),
  dispense: (k,t) => ({ rotX:0.02*k, shellY:0.02*k, fl:0.06*k, fr:0.06*k, yaw:0,
                        jY:0.032*Math.sin(t*100)*k, jR:0.020*Math.sin(t*82)*k }),
  coins:    k => ({ rotX:-0.18*k,  shellY:0.05*k,  fl:0.14*k, fr:0.14*k,
                    yaw:0.30*Math.sin(k*Math.PI) }),
  shards:   (k,t) => ({ rotX:-0.15*k, shellY:0.05*k, fl:0.15*k, fr:0.15*k, yaw:0,
                        jR:0.090*Math.sin(t*70)*k }),
};

function animateMachine(dt){
  if(!boss) return;
  const b=boss;
  b.group.position.set(b.pos.x,0,b.pos.z);

  let shellY=0, rotX=0, rotZ=0, fl=0, fr=0, jY=0, jR=0, yaw=0;

  if(b.phase===1){
    /* hover: rides above the ground, feet hang, banks into lateral travel */
    /* a skim, not flight. At 0.19 the cabinet floated a visible hand's width
       off the road and read as a bug; at 0.06 it scrapes along the asphalt
       while the whole frame buzzes, which is what a heavy machine on castors
       would actually do. */
    shellY=0.065+Math.sin(G.t*2.2)*0.018 + Math.sin(G.t*41)*0.005;
    fl=0.05; fr=0.05;
    const rx=Math.cos(b.heading), rz=-Math.sin(b.heading);
    const lat=b.velX*rx+b.velZ*rz;
    rotZ=-lat*0.030;
    rotX=-0.045;
  } else {
    if(b.action==='lunge' && b.phaseState==='active'){
      rotX=0.22; shellY=0.05; fl=0.16; fr=0.16;
    } else if(b.phaseState!=='windup'){
      b.stride+=Math.abs(b.speed)*dt*1.30;
      const s=Math.sin(b.stride*Math.PI);
      fl=Math.max(0,s)*0.26;
      fr=Math.max(0,-s)*0.26;
      shellY=Math.abs(s)*0.08;
      rotX=clamp(b.speed*0.012,-0.08,0.08);
    }
  }

  /* applied after the phase branch so it overrides the idle pose in EVERY
     phase - phase 1 used to ignore wind-ups completely */
  if(b.phaseState==='windup' && b.action && WINDUP[b.action]){
    const k=clamp(b.stateT/Math.max(0.001,b.windup),0,1);
    const w=WINDUP[b.action](k,b.stateT);
    /* fall back to the base pose for anything the table does not set -
       assigning an absent key gave rotZ=undefined, which turned the shell's
       rotation matrix into NaN and made the cabinet vanish. */
    const pick=(v,d)=> v===undefined ? d : v;
    rotX=pick(w.rotX,rotX); rotZ=pick(w.rotZ,rotZ); shellY=pick(w.shellY,shellY);
    fl=pick(w.fl,fl); fr=pick(w.fr,fr);
    jY=w.jY||0; jR=w.jR||0; yaw=w.yaw||0;
  }
  b.group.rotation.y=b.heading+yaw;

  /* the damped base and the jitter have to stay separate: damping a value
     that already contains the jitter feeds it back and multiplies it ~8x */
  b._sy=damp(b._sy===undefined?shellY:b._sy,shellY,8,dt);
  b._sz=damp(b._sz===undefined?rotZ:b._sz,rotZ,8,dt);
  b.shell.position.y=b._sy+jY;
  if(b.contact){
    const lift=clamp(b.shell.position.y,0,1.2);
    b.contact.material.opacity=0.62-lift*0.30;
    b.contact.scale.set(1.25+lift*0.35,1.0+lift*0.35,1);
  }
  /* TILT is a pose, not a flash: rock back onto the rear edge during the
     wind-up, then fall onto the face. During the fall the rig lifts by
     1.5*sin(angle) so it reads as pivoting on the FRONT edge instead of
     sinking through the road. */
  if(b.action==='tilt') rotX=0;
  let rockX=0;
  if(b.action==='tilt'){
    if(b.phaseState==='windup'){
      rockX=-0.26*clamp(b.stateT/Math.max(0.001,b.windup),0,1);
    } else if(b.phaseState==='active'){
      rockX=0.38*clamp(b.stateT/0.06,0,1);
    } else if(b.phaseState==='recover'){
      /* hold the forward pose for the first third of recovery. At 0.14s the
         slam was over inside two frames and read as a glitch rather than a
         hit; holding it is what makes it land. */
      const k=clamp(b.stateT/Math.max(0.001,b.recoverT),0,1);
      rockX=0.38*(1-clamp((k-0.35)/0.65,0,1));
    }
  }
  if(b.rock){
    if(b.dead) rockX=1.0;
    const fast=b.dead?3:((b.action==='tilt'&&b.phaseState==='active')?34:14);
    b.rock.rotation.x=damp(b.rock.rotation.x,rockX,fast,dt);
    b.rock.position.y=Math.max(0,1.5*Math.sin(b.rock.rotation.x));
  }

  b.shell.rotation.x=damp(b.shell.rotation.x,rotX,8,dt);
  b.shell.rotation.z=b._sz+jR;
  b.footL.position.y=damp(b.footL.position.y,fl,12,dt);
  b.footR.position.y=damp(b.footR.position.y,fr,12,dt);
  /* the condenser fan keeps turning once the cabinet is open */
  if(b.fan && b.inside.visible) b.fan.rotation.z += dt*7.5;
  /* and the tube in there is dying: a fast shimmer with an occasional dropout,
     which is what makes an opened machine feel live rather than a diorama */
  if(b.phase>=2 && b.interiorLight && !b.dead){
    const shim=Math.sin(G.t*41)*Math.sin(G.t*11.3);
    const drop=Math.sin(G.t*2.7)>0.93 ? -0.75 : 0;
    b.interiorLight.intensity=1.35+shim*0.28+drop;
  }

  /* stomp sound on the downbeat, only when actually walking */
  if(b.phase===2 && b.phaseState==='idle' && b.speed>1){
    const s=Math.sin(b.stride*Math.PI);
    if(b.lastStride!==undefined && b.lastStride>0 && s<=0) SFX.step();
    b.lastStride=s;
  }

  const flash=b.hitFlash>0;
  for(const m of b.mats) m.emissive.setHex(flash?0x3C1C2C:(m.userData.base||0));

  /* --- the new tells, drawn in-world and driven by the same clock --- */

  /* the delivery flap bangs open while it is loading a can volley */
  if(b.flap){
    /* open for a can volley, hanging open while it restocks, and stuck open
       when the arm jams — the flap is the machine's face, so it carries all
       three states without a single line of UI */
    const open=(b.action==='dispense'&&b.phaseState==='windup')
      || b.phaseState==='restock' || b.phaseState==='stagger';
    b.flap.rotation.x=damp(b.flap.rotation.x,-1.25*(open?1:0),16,dt);
  }
  /* the price display flashes gold while the coin mech runs */
  if(b.ledMat){
    if(b.phaseState==='stagger'){
      /* a jammed mech reads red at a glance */
      b.ledMat.color.setRGB(1,0.22+0.10*Math.abs(Math.sin(G.t*14)),0.16);
    } else if(b.action==='coins'&&b.phaseState==='windup'){
      const k=0.55+0.45*Math.abs(Math.sin(G.t*26));
      b.ledMat.color.setRGB(1,0.72+0.28*k,0.18);
    } else {
      b.ledMat.color.setRGB(1,1,1);
    }
  }
  /* the vents glow when it is running hot */
  if(b.ventMat){
    const hk=clamp(b.heat/2.5,0,1);
    b.ventMat.emissive.setRGB(hk*1.10,hk*0.18,0);
  }
  /* the header light swings to point down the charge line */
  if(b.headerLight){
    const sweep=(b.action==='lunge'&&b.phaseState==='windup')?1:0;
    b.headerLight.position.x=damp(b.headerLight.position.x, sweep*(P.pos.x-b.pos.x)*0.12, 7, dt);
    b.headerLight.position.z=damp(b.headerLight.position.z, 2.1+sweep*0.9, 7, dt);
  }

  /* the ground disc: grows to the true damage radius BEFORE the slam lands */
  if(b.tiltDisc){
    /* dead was not checked, so a boss killed mid-slam left the disc on the
       floor for good - that is the red spot that never went away. */
    const show=!b.dead && G.mode==='fight' && b.action==='tilt'
      && (b.phaseState==='windup'||b.phaseState==='active');
    b.tiltDisc.visible=show;
    if(show){
      const k=b.phaseState==='windup'
        ? clamp(b.stateT/Math.max(0.001,b.windup),0,1) : 1;
      const pulse=0.82+0.18*Math.sin(G.t*28);
      const sc=0.22+0.78*k;
      b.tiltDisc.position.set(b.pos.x,0.045,b.pos.z);
      b.tiltDisc.scale.setScalar(sc);
      b.tiltDisc.material.opacity=(0.12+0.24*k)*pulse;
      if(b.tiltRim){
        b.tiltRim.visible=true;
        b.tiltRim.position.set(b.pos.x,0.05,b.pos.z);
        b.tiltRim.scale.setScalar(sc);
        b.tiltRim.material.opacity=(0.30+0.55*k)*pulse;
      }
    } else if(b.tiltRim){
      b.tiltRim.visible=false;
    }
  }
}

/* ------------------------------- camera -------------------------------- */
const camPos=new THREE.Vector3(0,10,26);
const camLook=new THREE.Vector3(0,2.8,0);
const _wantP=new THREE.Vector3();
const _wantL=new THREE.Vector3();

let CAM_OVERRIDE=null;
/* a debug hold: freezes simulation time so a still can be taken of a pose that
   only exists for a tenth of a second. Never set during play. */
let PAUSED=false;
function updateCamera(dt){
  if(CAM_OVERRIDE){
    camera.position.copy(CAM_OVERRIDE.p);
    camera.lookAt(CAM_OVERRIDE.l);
    return;
  }
  const px=P.pos.x, py=P.pos.y, pz=P.pos.z;

  if(G.mode==='menu'){
    camPos.lerp(_wantP.set(0,11,27),1-Math.exp(-2*dt));
    camLook.lerp(_wantL.set(0,3,-2),1-Math.exp(-2*dt));
    camera.position.copy(camPos); camera.lookAt(camLook); return;
  }

  const bx=boss?boss.pos.x:0, bz=boss?boss.pos.z:0;

  /* NO AUTO-YAW. The previous version chased a target angle derived from
     atan2(px,pz) — the angle from the ARENA CENTRE to the player. Near the
     middle both components approach zero and the value jitters, and because
     it was also blended toward the boss, a roaming boss swung the whole world
     90 degrees every couple of seconds. That is the headache.
     Yaw is now player-controlled only. */

  /* Gentle recentre assist. It does NOT chase the machine: it engages only
     when the machine is nearly out of frame (35deg off centre) and stops once
     it is back inside (28deg). Between those it does nothing, so ordinary
     fighting produces zero camera motion. Any manual input suspends it for
     1.6s. This is the safety net that makes a manual camera usable. */
  G.assistHold=Math.max(0,G.assistHold-dt);
  if(boss && !boss.dead && G.assistHold<=0){
    const wantYaw=Math.atan2(px-bx, pz-bz);
    const err=angDiff(G.camYaw, wantYaw);
    const a=Math.abs(err);
    G.assistOn = G.assistOn ? (a>0.49) : (a>0.62);
    if(G.assistOn) G.camYaw += Math.sign(err)*Math.min(a, 0.80*dt);
  } else if(!boss || boss.dead){
    G.assistOn=false;
  }

  const sep=boss?dist2D(px,pz,bx,bz):10;
  const dist=clamp(13+sep*0.28,13,20);

  let cx=px+Math.sin(G.camYaw)*dist;
  let cz=pz+Math.cos(G.camYaw)*dist;
  let cy=clamp(py*0.55+9.5, 7, 17);

  /* keep the lens out of the shop wall and inside the block */
  cx=clamp(cx,-22,22);
  cz=clamp(cz,-13.2,24);

  /* if clamping brought the camera too close, lift it instead of crowding */
  const horiz=Math.hypot(cx-px, cz-pz);
  if(horiz<13) cy+=(13-horiz)*0.9;

  camPos.lerp(_wantP.set(cx,cy,cz),1-Math.exp(-9*dt));

  /* look a few units AHEAD of the player rather than at a midpoint, so the
     avatar sits in the lower third and the space in front of them is centred */
  const lx=px-Math.sin(G.camYaw)*4.0;
  const lz=pz-Math.cos(G.camYaw)*4.0;
  camLook.lerp(_wantL.set(lx, 2.8+py*0.35, lz),1-Math.exp(-9*dt));

  camera.position.copy(camPos);
  if(G.shake>0){
    G.shake=Math.max(0,G.shake-dt*2.4);
    const s=G.shake*G.shake*0.55;
    camera.position.x+=rand(-s,s);
    camera.position.y+=rand(-s,s);
    camera.position.z+=rand(-s,s);
  }
  camera.lookAt(camLook);
}

/* ---------------------------- off-screen marker ------------------------- */
const _markEl=document.getElementById('bossMark');
let _markOn=false;

function updateBossMark(){
  if(!boss || G.mode!=='fight' || boss.dead){
    if(_markOn){ _markEl.classList.remove('on'); _markOn=false; }
    return;
  }
  camera.updateMatrixWorld();
  camera.matrixWorldInverse.copy(camera.matrixWorld).invert();

  const local=new THREE.Vector3(boss.pos.x, 3.0, boss.pos.z).applyMatrix4(camera.matrixWorldInverse);
  const ahead=-local.z;                          /* >0 = in front of the lens  */
  const ang=Math.atan2(local.x, ahead);          /* 0 = dead ahead, +-PI = behind */
  const halfFovX=Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect);

  if(ahead>0 && Math.abs(ang)<halfFovX*0.82){
    if(_markOn){ _markEl.classList.remove('on'); _markOn=false; }
    return;
  }
  const r=Math.min(innerWidth,innerHeight)*0.36;
  _markEl.style.left=(innerWidth/2 + Math.sin(ang)*r)+'px';
  _markEl.style.top =(innerHeight/2 - Math.cos(ang)*r*0.55)+'px';
  _markEl.style.transform='rotate('+ang+'rad)';
  if(!_markOn){ _markEl.classList.add('on'); _markOn=true; }
}

/* -------------------------------- loop --------------------------------- */
let last=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  let raw=(now-last)/1000; last=now;
  if(raw>0.1) raw=0.1;

  /* while the tutorial is up it draws its own stage on its own renderer */
  if(document.getElementById('scrHow').classList.contains('on')){
    tutTick(Math.min(raw,0.05));
    return;
  }

  let dt=raw;
  if(PAUSED || G.rotLocked) dt=0;
  if(G.hitstop>0){ G.hitstop=Math.max(0,G.hitstop-raw); dt=0; }

  G.t+=dt;

  if(G.mode==='fight'){
    updatePlayer(dt);
    updateBoss(dt);
    updateCans(dt);
    updateCoins(dt);
  }
  G.fovPunch=Math.max(0,G.fovPunch-raw*2.4);
  camera.fov=BASE_FOV-(G.fovPunch||0)*9;
  camera.updateProjectionMatrix();
  updateFx(dt);
  animatePlayer(dt);
  animateMachine(dt);
  if(CINE.kind) updateCine(raw);
  updateCamera(raw);
  updateBossMark();
  if(TOUCH.on) touchUI();
  renderer.render(scene,camera);
}

function resize(){
  const w=innerWidth,h=innerHeight;
  renderer.setSize(w,h,false);
  camera.aspect=w/h; camera.updateProjectionMatrix();
}
addEventListener('resize',resize);


/* --------------------------- the tutorial stage --------------------------
   The cards are not pictures. This is a second, private copy of the fight:
   the real buildMachine() and the real buildChog(), lit for a close-up, on
   their own renderer so the panel can animate them without disturbing the
   fight paused behind it. Every slide is a small scripted performance.
   ---------------------------------------------------------------------- */
const TUT={ ready:false, renderer:null, scene:null, cam:null, boss:null, chog:null,
            t:0, idx:0, fx:[], cans:[], coins:[], shards:[], cycle:-1 };

/* the tutorial must never share a material with the live fight, or lighting
   its vents up would light the real machine's vents up too */
function ownMaterials(root){
  /* clone once per material, and hand back the original -> clone map so the
     named handles (ventMat, ledMat) can be re-pointed at the copies. Without
     this, lighting the tutorial's vents up also lit the real fight's vents. */
  const map=new Map();
  root.traverse(o=>{
    if(o.isMesh && o.material && !Array.isArray(o.material)){
      if(!map.has(o.material)) map.set(o.material, o.material.clone());
      o.material=map.get(o.material);
    }
  });
  return map;
}

function tutInit(){
  if(TUT.ready) return;
  const cv=document.getElementById('tutCanvas');
  const r=new THREE.WebGLRenderer({canvas:cv, antialias:true});
  r.setPixelRatio(Math.min(devicePixelRatio,2));
  r.setSize(cv.clientWidth||640, cv.clientHeight||420, false);
  TUT.renderer=r;

  const sc=new THREE.Scene();
  sc.background=new THREE.Color(0x08060F);
  sc.fog=new THREE.Fog(0x08060F, 28, 52);
  TUT.scene=sc;
  TUT.cam=new THREE.PerspectiveCamera(36, 1.5, 0.1, 140);

  sc.add(new THREE.AmbientLight(0x5A4C90, 0.70));
  sc.add(new THREE.HemisphereLight(0x7E6CC0, 0x0D0917, 0.82));
  const key=new THREE.DirectionalLight(0xFFD2BC, 0.92); key.position.set(7,14,9); sc.add(key);
  const rim=new THREE.DirectionalLight(0x9B7BFF, 1.40); rim.position.set(-9,7,-7); sc.add(rim);
  const fill=new THREE.PointLight(0xFF7AC6, 0.40, 26, 2); fill.position.set(-5,4,9); sc.add(fill);
  /* the Chog is small next to a 7 m cabinet and was reading as a purple blob.
     A lamp that follows it keeps its face and hands legible in every shot. */
  TUT.chogLight=new THREE.PointLight(0xFFE2CC, 1.15, 11, 2);
  sc.add(TUT.chogLight);

  const fcv=document.createElement('canvas'); fcv.width=fcv.height=256;
  const fc=fcv.getContext('2d');
  const fg=fc.createRadialGradient(128,128,6,128,128,126);
  fg.addColorStop(0.00,'#1C1630');
  fg.addColorStop(0.45,'#120D20');
  fg.addColorStop(0.78,'#0A0713');
  fg.addColorStop(1.00,'#08060F');
  fc.fillStyle=fg; fc.fillRect(0,0,256,256);
  const fl=new THREE.Mesh(new THREE.PlaneGeometry(52,52),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(fcv)}));
  fl.rotation.x=-Math.PI/2; sc.add(fl);

  /* a soft shadow that follows the Chog, so it stops floating */
  const sh=new THREE.Mesh(new THREE.CircleGeometry(1.05,26),
    new THREE.MeshBasicMaterial({color:0x000000, transparent:true, opacity:0.42, depthWrite:false}));
  sh.rotation.x=-Math.PI/2; sh.position.y=0.02; sc.add(sh);
  TUT.chogShadow=sh;

  /* a few slow motes, just to stop the air looking empty */
  {
    const pts=[];
    for(let i=0;i<70;i++){
      const a=Math.random()*Math.PI*2, r=2+Math.random()*11;
      pts.push(Math.cos(a)*r, Math.random()*7.5, Math.sin(a)*r);
    }
    const pg2=new THREE.BufferGeometry();
    pg2.setAttribute('position',new THREE.Float32BufferAttribute(pts,3));
    TUT.dust=new THREE.Points(pg2,new THREE.PointsMaterial({
      color:0xB9A8FF, size:2.0, sizeAttenuation:false,
      transparent:true, opacity:0.28, depthWrite:false, fog:false}));
    sc.add(TUT.dust);
  }

  const b=buildMachine();
  sc.add(b.group); sc.add(b.tiltDisc); sc.add(b.tiltRim);
  const matMap=ownMaterials(b.group);
  ownMaterials(b.tiltDisc); ownMaterials(b.tiltRim);
  if(matMap.has(b.ventMat)) b.ventMat=matMap.get(b.ventMat);
  if(matMap.has(b.ledMat))  b.ledMat=matMap.get(b.ledMat);
  b.group.position.set(0,0,0);
  TUT.boss=b;

  const c=buildChog();
  sc.add(c.root); ownMaterials(c.root);
  c.root.position.set(0,0,4.9);
  c.root.rotation.y=Math.PI;
  TUT.chog=c;

  const canM=new THREE.MeshLambertMaterial({color:0xC9D6E8});
  const coinM=new THREE.MeshLambertMaterial({color:0xFFC93C, emissive:0x5A3C00});
  const shardM=new THREE.MeshLambertMaterial({color:0xBFEFFF, emissive:0x16404F});
  for(let i=0;i<8;i++){
    const a=new THREE.Mesh(new THREE.CylinderGeometry(0.30,0.30,0.78,10), canM);
    a.visible=false; sc.add(a); TUT.cans.push(a);
    const b2=new THREE.Mesh(new THREE.BoxGeometry(0.88,0.88,0.12), coinM);
    b2.visible=false; sc.add(b2); TUT.coins.push(b2);
    const c2=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.22,1.10), shardM);
    c2.visible=false; sc.add(c2); TUT.shards.push(c2);
  }
  TUT.ready=true;
}

function T_cam(o){
  const a=o.a||0, d=(o.d===undefined?13.5:o.d), h=(o.h===undefined?5.2:o.h);
  const x=o.x||0, z=o.z||0, y=(o.y===undefined?3.0:o.y);
  TUT.cam.position.set(x+Math.sin(a)*d, h, z+Math.cos(a)*d);
  TUT.cam.lookAt(x,y,z);
}

function T_reset(){
  const b=TUT.boss, c=TUT.chog;
  b.group.position.set(0,0,0); b.group.rotation.y=0;
  b.shell.rotation.set(0,0,0); b.shell.position.y=0;
  b.rock.rotation.set(0,0,0); b.rock.position.y=0;
  b.tiltDisc.visible=false; b.tiltRim.visible=false;
  b.glass.visible=true; b.glare.visible=true; b.crack.visible=false;
  b.inside.visible=false;
  if(b.ventMat) b.ventMat.emissive.setRGB(0,0,0);
  if(b.ledMat) b.ledMat.color.setRGB(1,1,1);
  if(b.flap) b.flap.rotation.x=0;
  b.stockCans.forEach(m=>{ m.visible=true; });
  c.root.position.set(0,0,4.9); c.root.rotation.set(0,0,0); c.root.rotation.y=Math.PI;
  c.bodyPivot.rotation.set(0,0,0); c.bodyPivot.position.set(0,0,0);
  c.armL.rotation.set(0,0,0); c.armR.rotation.set(0,0,0);
  c.legL.rotation.set(0,0,0); c.legR.rotation.set(0,0,0);
  c.root.visible=true;
  TUT.cans.forEach(m=>m.visible=false);
  TUT.coins.forEach(m=>m.visible=false);
  TUT.shards.forEach(m=>m.visible=false);
  TUT.fx.forEach(f=>{ TUT.scene.remove(f.m); });
  TUT.fx.length=0;
}

function tutBurst(x,y,z,n,color,spd,size,life){
  for(let i=0;i<n;i++){
    const m=new THREE.Mesh(new THREE.BoxGeometry(size,size,size),
      new THREE.MeshBasicMaterial({color, transparent:true}));
    m.position.set(x,y,z);
    TUT.scene.add(m);
    const a=Math.random()*Math.PI*2, e=0.35+Math.random()*0.75;
    TUT.fx.push({m, life:(life||0.6)*(0.7+Math.random()*0.6), max:life||0.6,
      vx:Math.cos(a)*spd*e, vy:1.2+Math.random()*spd*0.8, vz:Math.sin(a)*spd*e});
  }
}
function tutFxUpdate(dt){
  for(let i=TUT.fx.length-1;i>=0;i--){
    const f=TUT.fx[i];
    f.life-=dt; f.vy-=15*dt;
    f.m.position.x+=f.vx*dt; f.m.position.y+=f.vy*dt; f.m.position.z+=f.vz*dt;
    f.m.rotation.x+=dt*9; f.m.rotation.z+=dt*7;
    f.m.material.opacity=Math.max(0,f.life/f.max);
    if(f.life<=0){ TUT.scene.remove(f.m); f.m.geometry.dispose(); f.m.material.dispose(); TUT.fx.splice(i,1); }
  }
}

/* ------------------------------- the cards ------------------------------- */
const HOW=[
{ n:'01', t:'Move', cap:'WASD · drag to look', dur:7.0,
  body:'<b>W A S D</b> to move, <b>drag the mouse</b> to look. Let go and the camera drifts back '
      +'behind you, so you never have to steer it. It watches you the whole time — that is the '
      +'point. Keep moving.',
  keys:[['W A S D','move'],['DRAG','look'],['ESC','pause']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    const k=t/d, a=-0.60+1.20*k;
    c.root.position.set(Math.sin(a)*4.7, 0, Math.cos(a)*4.7);
    c.root.rotation.y=a+Math.PI;
    const w=t*7.5;
    c.legL.rotation.x=Math.sin(w)*0.80; c.legR.rotation.x=-Math.sin(w)*0.80;
    c.armL.rotation.x=-Math.sin(w)*0.50; c.armR.rotation.x=Math.sin(w)*0.50;
    c.bodyPivot.position.y=Math.abs(Math.sin(w))*0.07;
    b.group.rotation.y=Math.atan2(c.root.position.x, c.root.position.z);
    b.shell.position.y=0.05+Math.sin(t*2.4)*0.03;
    T_cam({a:0.50-0.26*k, d:17.4, h:6.7, y:3.2, z:0.5});
  }},

{ n:'02', t:'Jump and dash', cap:'SHIFT makes you untouchable', dur:5.6,
  body:'<b>SPACE</b> jumps. <b>SHIFT</b> dashes — and while you are dashing you <b>cannot be hit</b>. '
      +'That is your only real defence. Dash <b>through</b> what it throws, not away from it.',
  keys:[['SPACE','jump'],['SHIFT','dash = dodge']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    b.group.position.set(5.4,0,0); b.group.rotation.y=-Math.PI/2+0.45;
    let x=-3.6;
    const dash=(t>1.5&&t<2.4);
    if(dash) x=-3.6+7.0*((t-1.5)/0.9);
    else if(t>=2.4) x=3.4;
    c.root.position.set(x,0,0);
    c.root.rotation.y=Math.PI/2;
    c.bodyPivot.rotation.x=dash?0.34:0;
    c.legL.rotation.x=dash?-1.0:0; c.legR.rotation.x=dash?0.55:0;
    c.armL.rotation.x=dash?-1.2:0; c.armR.rotation.x=dash?-0.6:0;
    const co=TUT.coins[0];
    if(t>0.45&&t<3.0){
      const k=(t-0.45)/2.55;
      co.visible=true;
      co.position.set(4.4-9.2*k, 1.55+Math.sin(k*Math.PI)*0.30, 0);
      co.rotation.set(0,t*11,0);
    } else co.visible=false;
    if(dash && Math.random()<0.55) tutBurst(x-0.5,1.3,0,1,0x9B59FF,1.0,0.15,0.34);
    T_cam({a:0, d:16.8, h:5.3, y:2.7, x:0.9});
  }},

{ n:'03', t:'Attack', cap:'J quick · K heavy', dur:4.2,
  body:'<b>J</b> is quick, <b>K</b> is heavy — heavier hits harder but locks you in place longer. '
      +'Getting hit <b>cancels your swing</b>, so a swing you did not earn is a swing you lose.',
  keys:[['J','quick'],['K','heavy'],['CLICK','attack']],
  onCycle(){ TUT.boss.hitFlash=0; },
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    b.group.position.set(0,0,0); b.group.rotation.y=0;
    c.root.position.set(0.7,0,3.5); c.root.rotation.y=Math.PI-0.2;
    let swing=0;
    if(t>1.0&&t<1.5) swing=Math.sin((t-1.0)/0.5*Math.PI);
    c.armR.rotation.x=-2.4+swing*3.6;
    c.armR.rotation.z=-swing*0.5;
    c.bodyPivot.rotation.y=swing*0.42;
    c.bodyPivot.rotation.x=swing*0.16;
    if(t>1.22&&t<1.26) tutBurst(0.5,3.3,2.0,12,0xFFE9C9,5.5,0.10,0.42);
    T_cam({a:0.52, d:15.6, h:5.3, y:3.3, z:0.9});
  }},

{ n:'04', t:'Hit it where it hurts', cap:'behind x1.6 · hot x1.75 · both x2.2', dur:8.0,
  body:'From <b>behind</b> it cannot answer you: <b>x1.6</b>. While its vents are <b>glowing</b> the '
      +'compressor is exposed: <b>x1.75</b>. Both at once is <b>x2.2</b> — the ceiling. '
      +'The whole damage game is finding that angle.',
  keys:[['BEHIND','x1.6'],['OVERHEATED','x1.75'],['BOTH','x2.2']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    const hot=Math.max(0,Math.sin(t*1.6))*0.9;
    b.ventMat.emissive.setRGB(hot*1.15,hot*0.18,0);
    b.ledMat.color.setRGB(1,0.72+0.28*Math.abs(Math.sin(t*6)),0.18);
    /* walk the whole way round to its back, then hit it from there */
    const k=Math.min(1,t/4.4);
    const a=0.35+Math.PI*0.86*k;
    c.root.position.set(Math.sin(a)*4.3, 0, Math.cos(a)*4.3);
    c.root.rotation.y=a+Math.PI;
    const w=t*7;
    c.legL.rotation.x=Math.sin(w)*0.65; c.legR.rotation.x=-Math.sin(w)*0.65;
    c.armL.rotation.x=-Math.sin(w)*0.4; c.armR.rotation.x=Math.sin(w)*0.4;
    let swing=0;
    if(t>4.8&&t<5.2) swing=Math.sin((t-4.8)/0.4*Math.PI);
    c.armR.rotation.x=-2.2+swing*3.4;
    if(t>4.98&&t<5.02) tutBurst(0,3.6,-2.0,16,0xFFB35C,6.0,0.12,0.5);
    T_cam({a:1.45, d:16.4, h:5.6, y:3.2});
  }},

{ n:'05', t:'Mount it', cap:'F when the vents glow', dur:7.0,
  body:'When the vents glow orange, get close on <b>that side</b> and press <b>F</b>. You climb it and '
      +'drive a fist into the compressor: <b>55 damage</b> and it is stunned. One per cooldown — '
      +'pick the moment.',
  keys:[['F','climb the vents'],['10s','cooldown']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    const hot=Math.max(0,Math.sin(t*2.2))*0.95;
    b.ventMat.emissive.setRGB(hot*1.2,hot*0.2,0);
    // leap up the vent face (local -X side) at t=2.2, punch at 3.4
    const ventX=-3.05, ventY=2.85;
    if(t<2.0){
      c.root.position.set(-5.6,0,1.6); c.root.rotation.y=Math.PI*0.5;
    } else if(t<3.4){
      const k=(t-2.0)/1.4, e=k*k*(3-2*k);
      c.root.position.set(-5.6+(ventX+5.6)*e, ventY*Math.min(1,k*1.5), 1.6-1.6*e);
      c.root.rotation.y=Math.PI*0.5;
      c.armL.rotation.x=-2.6; c.armR.rotation.x=-2.6;
      c.legL.rotation.x=-0.9; c.legR.rotation.x=0.6;
    } else if(t<4.6){
      c.root.position.set(ventX,ventY,0); c.root.rotation.y=Math.PI*0.5;
      const punch=Math.max(0,Math.sin((t-3.4)/0.5*Math.PI));
      c.armR.rotation.x=-2.5+punch*3.6;
      c.armL.rotation.x=-2.7;
      if(t>3.62&&t<3.66){ tutBurst(ventX,ventY+1.2,0,16,0xFFB35C,6.5,0.11,0.55); G.shake=0; }
      b.shell.position.y=Math.sin((t-3.6)*40)*0.05*Math.max(0,1-(t-3.6)*2);
    } else {
      const k=(t-4.6)/1.4;
      c.root.position.set(ventX-3.0*k, ventY*(1-k), 0);
      c.root.rotation.y=Math.PI*0.5;
    }
    T_cam({a:-0.92, d:13.6, h:5.0, y:3.5, x:-0.9});
  }},

{ n:'06', t:'Its stock is its health', cap:'no bar — watch the glass', dur:8.0,
  body:'There is no health bar. The cans behind the glass <b>are</b> its health — watch them empty. '
      +'At half stock the glass breaks. At zero it has nothing left to throw, and it gets meaner.',
  keys:[['WINDOW','the cans are HP'],['0','sold out']],
  run(t,d){
    const b=TUT.boss;
    const gone=Math.min(b.stockCans.length, Math.floor(t/0.62));
    b.stockCans.forEach((m,i)=>{ m.visible = i>=gone; });
    if(t>4.6){ b.glass.visible=false; b.glare.visible=false; b.crack.visible=false; }
    else if(t>4.1){ b.glass.visible=true; b.crack.visible=true; }
    else { b.glass.visible=true; b.crack.visible=false; }
    b.inside.visible=t>4.6;
    b.shell.position.y=0.03+Math.sin(t*1.8)*0.02;
    const z=6.0-2.6*Math.min(1,t/3.2);
    T_cam({a:0.26, d:z+6.6, h:3.5, y:3.5});
  }},

{ n:'07', t:'TILT', cap:'the red disc is where it lands', dur:6.4,
  body:'It rocks back onto its rear edge and a <b>red disc</b> appears on the floor. That disc is '
      +'exactly where the slam lands. <b>Walk or dash out of it</b> — there is no other answer.',
  keys:[['RED DISC','the reach'],['RUN','out of it']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    const k=Math.min(1,t/2.2);
    b.rock.rotation.x=-0.30*k;
    b.rock.position.y=Math.max(0,1.5*Math.sin(b.rock.rotation.x));
    const show=t<3.0;
    b.tiltDisc.visible=show; b.tiltRim.visible=show;
    if(show){
      const g=0.25+0.75*Math.min(1,t/2.2);
      b.tiltDisc.position.set(0,0.045,0); b.tiltDisc.scale.setScalar(g);
      b.tiltRim.position.set(0,0.05,0);  b.tiltRim.scale.setScalar(g);
      b.tiltDisc.material.opacity=(0.12+0.24*Math.min(1,t/2.2))*(0.82+0.18*Math.sin(t*26));
      b.tiltRim.material.opacity=(0.30+0.55*Math.min(1,t/2.2))*(0.82+0.18*Math.sin(t*26));
    }
    if(t<1.5){ c.root.position.set(1.6,0,3.4); }
    else if(t<2.7){ const e=(t-1.5)/1.2; c.root.position.set(1.6+3.8*e,0,3.4+1.8*e); }
    else { c.root.position.set(5.4,0,5.2); }
    c.root.rotation.y=Math.PI*0.35;
    if(t>0.4&&t<2.7){ const w=t*13; c.legL.rotation.x=Math.sin(w)*0.95; c.legR.rotation.x=-Math.sin(w)*0.95;
                       c.armL.rotation.x=-Math.sin(w)*0.7; c.armR.rotation.x=Math.sin(w)*0.7; }
    if(t>2.9&&t<3.05){
      b.rock.rotation.x=0.38;
      b.rock.position.y=0.57;
      tutBurst(0,0.4,0,22,0xCFC8DC,7.5,0.13,0.6);
    }
    if(t>3.4){ b.rock.rotation.x=0; b.rock.position.y=0; }
    T_cam({a:0.62, d:17.0, h:6.5, y:2.8});
  }},

{ n:'08', t:'LUNGE', cap:'dash sideways, not back', dur:5.0,
  body:'It crouches with its <b>nose down</b>, then throws itself at you in a straight line. Do not '
      +'back away — <b>dash sideways</b>. In the second phase it turns slowly, so get behind it.',
  keys:[['DASH','sideways'],['BEHIND','it cannot turn fast']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    let bx=0;
    if(t>1.6&&t<2.3){ const k=(t-1.6)/0.7; bx=-11.0*k; }
    else if(t>=2.3) bx=-11.0;
    b.group.position.set(bx,0,0);
    const crouch=Math.min(1,t/1.5);
    b.shell.rotation.x=(t<1.6? 0.30*crouch : 0.22);
    b.shell.position.y=(t<1.6? -0.22*crouch : 0.05);
    if(t<1.6){ c.root.position.set(0,0,3.4); c.root.rotation.y=Math.PI; }
    else if(t<2.3){
      const k=(t-1.6)/0.7;
      c.root.position.set(-2.6*k, 0, 3.4);
      c.root.rotation.y=Math.PI*0.5;
      c.bodyPivot.rotation.x=0.3;
      if(Math.random()<0.5) tutBurst(-2.6*k,1.3,3.4,1,0x9B59FF,1.0,0.15,0.3);
    } else {
      c.root.position.set(-2.6,0,3.4); c.root.rotation.y=Math.PI*0.5;
      c.bodyPivot.rotation.x=0;
    }
    T_cam({a:0.95, d:17.6, h:5.7, y:2.8, x:-2.6});
  }},

{ n:'09', t:'DISPENSE', cap:'jump the cans', dur:5.0,
  body:'The delivery flap bangs open and <b>cans arc out</b> at you. They are slow and they land '
      +'where you were standing — <b>jump</b> them, or just keep moving.',
  keys:[['JUMP','over the cans']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    b.group.position.set(4.8,0,0); b.group.rotation.y=-Math.PI/2+0.45;
    b.flap.rotation.x=-1.25*Math.min(1,Math.max(0,(t-0.3)/0.25));
    const fly=t>0.7&&t<4.2;
    for(let i=0;i<4;i++){
      const m=TUT.cans[i];
      if(!fly){ m.visible=false; continue; }
      const k=((t-0.7)/3.5)-i*0.10;
      if(k<0||k>1){ m.visible=false; continue; }
      m.visible=true;
      m.position.set(3.0-7.6*k, 1.2+Math.sin(Math.max(0,k)*Math.PI)*2.4, 0.5*k);
      m.rotation.set(t*6+i, 0, t*4);
    }
    const jump=t>1.9&&t<2.6 ? Math.sin((t-1.9)/0.7*Math.PI) : 0;
    c.root.position.set(-2.4, jump*1.5, 0);
    c.root.rotation.y=Math.PI/2;
    c.legL.rotation.x=-jump*1.1; c.legR.rotation.x=-jump*0.7;
    c.bodyPivot.rotation.x=jump*0.2;
    T_cam({a:0, d:16.8, h:5.3, y:2.7, x:0.9});
  }},

{ n:'10', t:'COINS', cap:'straight and fast — jump them', dur:5.0,
  body:'A row of coins fires <b>straight and fast</b>. They never curve, so one well-timed jump clears '
      +'the whole volley — or dash through them, because the dash makes you untouchable.',
  keys:[['JUMP','over them'],['DASH','through them']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    b.group.position.set(4.8,0,0); b.group.rotation.y=-Math.PI/2+0.45;
    const fly=t>0.6&&t<3.6;
    for(let i=0;i<5;i++){
      const m=TUT.coins[i];
      if(!fly){ m.visible=false; continue; }
      const k=((t-0.6)/3.0)-i*0.05;
      if(k<0||k>1){ m.visible=false; continue; }
      m.visible=true;
      m.position.set(3.0-8.0*k, 1.15, -0.6+i*0.30);
      m.rotation.set(0, t*14, 0);
    }
    const jump=t>1.7&&t<2.4 ? Math.sin((t-1.7)/0.7*Math.PI) : 0;
    c.root.position.set(-2.6, jump*1.6, 0);
    c.root.rotation.y=Math.PI/2;
    c.legL.rotation.x=-jump*1.2; c.legR.rotation.x=-jump*0.8;
    T_cam({a:0, d:16.8, h:5.3, y:2.7, x:0.9});
  }},

{ n:'11', t:'SHARDS', cap:'no gap — dash through the middle', dur:5.0,
  body:'Once the glass is gone it throws <b>glass</b> — a wide fan, faster than coins. There is no gap '
      +'to jump. <b>Dash through the middle</b> of the fan.',
  keys:[['DASH','through the fan']],
  run(t,d){
    const c=TUT.chog, b=TUT.boss;
    b.group.position.set(4.8,0,0); b.group.rotation.y=-Math.PI/2+0.45;
    b.glass.visible=false; b.glare.visible=false; b.inside.visible=true;
    const fly=t>0.6&&t<3.4;
    for(let i=0;i<6;i++){
      const m=TUT.shards[i];
      if(!fly){ m.visible=false; continue; }
      const k=((t-0.6)/2.8)-Math.abs(i-2.5)*0.04;
      if(k<0||k>1){ m.visible=false; continue; }
      m.visible=true;
      const sp=(i-2.5)*0.34;
      m.position.set(3.0-7.2*k, 1.6+sp*0.4, sp*2.4);
      m.rotation.set(0, sp, 0);
    }
    const dash=t>1.6&&t<2.4 ? ((t-1.6)/0.8) : (t>=2.4?1:0);
    c.root.position.set(-3.0+3.6*dash, 0, 0);
    c.root.rotation.y=Math.PI/2;
    c.bodyPivot.rotation.x=dash>0&&dash<1?0.3:0;
    if(t>1.6&&t<2.4 && Math.random()<0.5) tutBurst(c.root.position.x-0.5,1.3,0,1,0x9B59FF,1.0,0.15,0.3);
    T_cam({a:0, d:16.8, h:5.3, y:2.7, x:0.9});
  }},

{ n:'12', t:'Three phases', cap:'glass on → lunges → sold out', dur:9.0,
  body:'<b>Phase 1</b> it glides and keeps its distance. <b>Phase 2</b> the glass breaks and it starts '
      +'lunging. <b>Phase 3</b> it is sold out — no cans, no coins, just the cabinet coming at you. '
      +'It turns a little faster every phase.',
  keys:[['100%','it glides'],['50%','glass breaks'],['0%','sold out']],
  run(t,d){
    const b=TUT.boss;
    const stage=t<3.0?0:(t<6.0?1:2);
    if(stage===0){
      b.stockCans.forEach(m=>m.visible=true);
      b.glass.visible=true; b.glare.visible=true; b.inside.visible=false;
      b.shell.position.y=0.06+Math.sin(t*2.2)*0.03;
      b.group.rotation.y=Math.sin(t*0.7)*0.5;
    } else if(stage===1){
      const gone=Math.min(b.stockCans.length,Math.floor((t-3.0)/0.42));
      b.stockCans.forEach((m,i)=>{ m.visible=i>=gone; });
      b.glass.visible=false; b.glare.visible=false; b.inside.visible=true;
      b.shell.rotation.x=-0.10;
      b.group.rotation.y=Math.sin(t*0.9)*0.7;
    } else {
      b.stockCans.forEach(m=>{ m.visible=false; });
      b.glass.visible=false; b.glare.visible=false; b.inside.visible=true;
      b.shell.rotation.x=0.14;
      b.shell.position.y=-0.05;
      b.group.rotation.y=Math.sin(t*1.4)*0.9;
      b.ventMat.emissive.setRGB(0.5,0.06,0);
    }
    T_cam({a:0.4+Math.sin(t*0.35)*0.35, d:16.0, h:5.9, y:3.2});
  }}
];

let howIdx=0, howFrom='menu';

function tutResize(){
  if(!TUT.ready) return;
  const cv=TUT.renderer.domElement;
  const w=cv.clientWidth, h=cv.clientHeight;
  if(w<8||h<8) return;
  TUT.renderer.setSize(w,h,false);
  TUT.cam.aspect=w/h; TUT.cam.updateProjectionMatrix();
}

function tutTick(dt){
  if(!TUT.ready) return;
  const sl=HOW[TUT.idx];
  TUT.t+=dt;
  const dur=sl.dur||6;
  const cyc=Math.floor(TUT.t/dur);
  if(cyc!==TUT.cycle){ TUT.cycle=cyc; T_reset(); if(sl.onCycle) sl.onCycle(); }
  sl.run(TUT.t%dur, dur);
  const cp=TUT.chog.root.position;
  TUT.chogLight.position.set(cp.x+1.1, cp.y+2.9, cp.z+1.9);
  TUT.chogShadow.position.set(cp.x, 0.02, cp.z);
  TUT.chogShadow.scale.setScalar(1-Math.min(0.55, cp.y*0.22));
  TUT.chogShadow.material.opacity=0.42*(1-Math.min(0.7, cp.y*0.25));
  TUT.dust.rotation.y+=dt*0.035;
  tutFxUpdate(dt);
  tutResize();
  TUT.renderer.render(TUT.scene, TUT.cam);
}

function renderHow(){
  const d=HOW[TUT.idx];
  document.getElementById('howNum').textContent=d.n+' / '+String(HOW.length).padStart(2,'0');
  document.getElementById('howTitle').textContent=d.t;
  document.getElementById('howBody').innerHTML=d.body;
  document.getElementById('howCaption').textContent=d.cap||'';
  document.getElementById('howKeys').innerHTML=d.keys
    .map(k=>'<span><b>'+k[0]+'</b> '+k[1]+'</span>').join('');
  document.getElementById('howCount').textContent=(TUT.idx+1)+' / '+HOW.length;
  document.getElementById('howDots').innerHTML=HOW.map((_,i)=>'<i class="'+(i===TUT.idx?'on':'')+'"></i>').join('');
  document.getElementById('btnHowPrev').disabled=(TUT.idx===0);
  document.getElementById('btnHowNext').textContent=(TUT.idx===HOW.length-1)?'Done':'Next';
  TUT.t=0; TUT.cycle=-1;
}
function howStep(d){
  const n=TUT.idx+d;
  if(n<0) return;
  if(n>=HOW.length){ closeHow(); return; }
  TUT.idx=n; renderHow();
}
function openHow(from){
  howFrom=from||'menu';
  /* pause FIRST: setPaused() puts the pause card back on screen, so removing
     it afterwards is what keeps it from sitting on top of the tutorial and
     eating every click on Next */
  if(G.mode==='fight' && !PAUSED) setPaused(true);
  document.getElementById('scrHow').classList.add('on');
  document.getElementById('scrStart').classList.remove('on');
  document.getElementById('scrPause').classList.remove('on');
  tutInit();
  TUT.idx=0; renderHow();
  requestAnimationFrame(()=>{ tutResize(); });
}
function closeHow(){
  document.getElementById('scrHow').classList.remove('on');
  if(howFrom==='pause') document.getElementById('scrPause').classList.add('on');
  else if(howFrom==='menu') document.getElementById('scrStart').classList.add('on');
  if(TUT.ready) T_reset();
}
document.getElementById('btnHowPrev').addEventListener('click',()=>howStep(-1));
document.getElementById('btnHowNext').addEventListener('click',()=>howStep(1));
document.getElementById('btnHowClose').addEventListener('click',()=>closeHow());
document.getElementById('btnHowStart').addEventListener('click',()=>openHow('menu'));
document.getElementById('btnHowPause').addEventListener('click',()=>openHow('pause'));

/* ------------------------------ cinematics -------------------------------
   Three short films: the machine waking up, the machine dying, and the
   machine winning. They are driven from the same clock and the same camera
   override the rest of the game uses, so nothing here is a video file.
   ---------------------------------------------------------------------- */
const CINE={ t:0, kind:null, base:null };
const INTRO_LEN=5.9, WIN_LEN=9.6, LOSE_LEN=7.0;

function fadeTo(v,ms){
  const e=document.getElementById('fade');
  e.style.transition='opacity '+(ms||0)+'ms linear';
  e.style.opacity=v;
}
/* smoothstep */
function ss(a,b,x){ const k=Math.min(1,Math.max(0,(x-a)/(b-a))); return k*k*(3-2*k); }

function startCine(kind){
  CINE.t=0; CINE.kind=kind;
  /* a rematch must not inherit last match's props */
  if(CINE.payout){ try{ scene.remove(CINE.payout.mesh); }catch(e){} }
  if(CINE.shelf){ try{ scene.remove(CINE.shelf.mesh); }catch(e){} }
  CINE.payout=null; CINE.shelf=null; CINE.err=null;
  const b=boss;
  if(!b) return;
  if(kind==='intro'){
    /* remember the machine's own lighting so the wake-up can restore it */
    CINE.base={ hdr:b.headerLight?b.headerLight.intensity:0,
                inte:b.interiorLight?b.interiorLight.intensity:0,
                rim:b.rimLight?b.rimLight.intensity:0 };
    if(b.headerLight) b.headerLight.intensity=0;
    if(b.interiorLight) b.interiorLight.intensity=0;
    if(b.rimLight) b.rimLight.intensity=0;
    if(b.ledMat) b.ledMat.color.setRGB(0.05,0.05,0.07);
    b.heading=Math.PI*0.72;
    b.group.rotation.y=b.heading;
    /* the boss is frozen by G.mode during the film, not by this timer. Putting
       a huge value here meant the timer survived the hand-over and the machine
       stood there for 99 s with no attacks at all. */
    b.phaseState='idle'; b.stateT=0; b.idleT=0.9;
    document.getElementById('hud').classList.remove('on');
    fadeTo(1,0);
    setTimeout(()=>fadeTo(0,800),30);
  }
  G.mode=kind;
}

function endCine(){
  const kind=CINE.kind;
  CINE.kind=null;
  const b=boss;
  if(kind==='intro'){
    if(b){
      if(b.headerLight) b.headerLight.intensity=CINE.base.hdr;
      if(b.interiorLight) b.interiorLight.intensity=CINE.base.inte;
      if(b.rimLight) b.rimLight.intensity=CINE.base.rim;
      if(b.ledMat) b.ledMat.color.setRGB(1,1,1);
      if(b.flap) b.flap.rotation.x=0;
      /* hand the machine back to the fight in a known state: idle, aimed at
         the player, with a short beat before the first attack */
      b.phaseState='idle'; b.stateT=0; b.action=null;
      b.wave1=false; b.wave2=false; b.lungeHit=false;
      b.idleT=0.9;
    }
    CAM_OVERRIDE=null;
    G.mode='fight'; G.t=0;
    document.getElementById('hud').classList.add('on');
    updateHUD();
    toast('THE MACHINE', 1500);
    fadeTo(0,600);
  } else {
    fadeTo(1,420);
    setTimeout(()=>{ fadeTo(0,10); showResults(kind==='win'); }, 440);
  }
}

function updateCine(dt){
  const t=(CINE.t+=dt), b=boss;
  if(!b) return;

  if(CINE.kind==='intro'){
    /* camera: down at the plinth, then a slow crane back to the player's eye */
    if(t<3.1){
      const k=t/3.1;
      CAM_OVERRIDE={ p:new THREE.Vector3(1.5-0.9*k, 0.75+0.45*k, 9.0-0.5*k),
                     l:new THREE.Vector3(0, 4.5-0.3*k, -3.2) };
    } else {
      const k=ss(3.1,5.5,t);
      CAM_OVERRIDE={ p:new THREE.Vector3(0.6-0.6*k, 1.2+4.8*k, 8.5+9.5*k),
                     l:new THREE.Vector3(0, 4.2-0.7*k, -3.2+1.1*k) };
    }
    /* it was facing the wall. it turns to look at you. */
    const te=ss(1.3,3.0,t);
    b.heading=Math.PI*0.72*(1-te);
    b.group.rotation.y=b.heading;
    /* power-on, one circuit at a time */
    if(b.ledMat){
      const v=0.05+0.95*ss(0.8,1.4,t);
      b.ledMat.color.setRGB(v,v,v*1.04);
    }
    if(b.headerLight) b.headerLight.intensity=(CINE.base.hdr)*ss(1.1,1.6,t);
    if(b.interiorLight) b.interiorLight.intensity=(CINE.base.inte)*ss(1.7,2.4,t);
    if(b.rimLight) b.rimLight.intensity=(CINE.base.rim)*ss(2.2,3.2,t);
    /* the delivery flap bangs open and shuts again */
    if(b.flap) b.flap.rotation.x=-1.25*ss(2.5,2.7,t)*(1-ss(3.2,3.5,t));
    /* and it lifts off the ground as the camera pulls away */
    b.shell.position.y=0.065*ss(3.4,4.6,t);
    if(t>=INTRO_LEN) endCine();
    return;
  }

  if(CINE.kind==='win'){
    const k=ss(0,WIN_LEN,t);
    /* orbit the CABINET, not the arena centre */
    const bx=b.pos.x, bz=b.pos.z, a=-0.55+1.70*k;
    CAM_OVERRIDE={ p:new THREE.Vector3(bx+Math.sin(a)*16.5, 6.2+2.4*k, bz+Math.cos(a)*16.5),
                   l:new THREE.Vector3(bx, 2.8-0.9*k, bz) };
    /* the cabinet goes dark, circuit by circuit */
    if(b.ledMat) b.ledMat.color.setRGB(1-ss(0.2,0.9,t), 1-ss(0.2,0.9,t), 1-ss(0.2,0.9,t));
    if(b.headerLight) b.headerLight.intensity=(CINE.base?CINE.base.hdr:2.2)*(1-ss(0.5,1.4,t));
    if(b.interiorLight) b.interiorLight.intensity=(CINE.base?CINE.base.inte:0.9)*(1-ss(0.9,1.8,t));
    if(b.rimLight) b.rimLight.intensity=(CINE.base?CINE.base.rim:1.4)*(1-ss(1.4,2.6,t));

    /* --- THE PAYOUT -----------------------------------------------------
       It dies, the flap drops, and one can rolls out and stops. Then the
       camera gives up on the machine and goes to look at the can. */
    if(b.flap) b.flap.rotation.x = -1.32*ss(1.0,1.45,t);
    if(t>=1.5 && !CINE.payout){
      try{
        const ci=(Math.random()*canCols.length)|0;
        const built=makeCanMesh(canCols[ci], canFlavours[ci]);
        built.group.scale.setScalar(1.15);
        const fwd=new THREE.Vector3(Math.sin(b.heading),0,Math.cos(b.heading));
        const origin=new THREE.Vector3(bx,0,bz).add(fwd.clone().multiplyScalar(0.9));
        origin.y=1.45;
        built.group.position.copy(origin);
        scene.add(built.group);
        CINE.payout={ mesh:built.group, origin:origin, fwd:fwd, born:t };
      }catch(e){ CINE.payout=null; CINE.err='payout: '+e.message; console.error(CINE.err); }
    }
    if(CINE.payout){
      const p0=CINE.payout, age=t-p0.born;
      const roll=clamp(age/1.9,0,1);
      const dist=0.9+2.6*roll;
      const px=p0.origin.x+p0.fwd.x*dist, pz=p0.origin.z+p0.fwd.z*dist;
      /* drop from the flap, bounce once, settle */
      let py;
      if(age<0.55){ py=1.45-(1.45-0.42)*ss(0,0.55,age); }
      else if(age<1.05){ py=0.42+Math.abs(Math.sin((age-0.55)/0.5*Math.PI))*0.34*(1-ss(0.55,1.05,age)); }
      else { py=0.42; }
      p0.mesh.position.set(px,py,pz);
      /* wobble as it comes to rest, then stop dead */
      const wob=(age>1.0&&age<2.4)?Math.sin((age-1.0)*26)*(1-ss(1.0,2.4,age))*0.05:0;
      p0.mesh.rotation.z=wob;
      p0.mesh.rotation.x=-Math.PI*0.5*(1-clamp(age/0.55,0,1))*0.0;
    }
    /* the camera turns from the dead cabinet to the can on the floor */
    const look=ss(3.4,5.2,t);
    if(CINE.payout && look>0){
      const p0=CINE.payout.mesh.position;
      const cx=bx+Math.sin(a)*16.5, cz=bz+Math.cos(a)*16.5;
      CAM_OVERRIDE={
        p:new THREE.Vector3(cx+(p0.x-cx)*0.55*look, (6.2+2.4*k)*(1-look)+1.55*look, cz+(p0.z-cz)*0.55*look),
        l:new THREE.Vector3(bx+(p0.x-bx)*look, (2.8-0.9*k)*(1-look)+0.55*look, bz+(p0.z-bz)*look)
      };
    }
    if(t>2.2&&t<2.25) toast('THANK YOU', 1800);
    if(t>=WIN_LEN) endCine();
    return;
  }

  if(CINE.kind==='lose'){
    const k=ss(0,LOSE_LEN,t);
    /* --- THE SHELF ------------------------------------------------------
       It does not kill you. It shelves you. The camera pushes in through the
       glass and finds one more can where the stock should be. */
    const push=ss(0.6,4.2,t);
    /* anchor on the MACHINE, not the world origin - it roams, and a camera
       aimed at (0,0,0) filmed the wall whenever it wandered off centre */
    const bf=new THREE.Vector3(Math.sin(b.heading),0,Math.cos(b.heading));
    const bd=7.2-4.9*push;
    CAM_OVERRIDE={ p:new THREE.Vector3(b.pos.x+bf.x*bd, 0.9+2.1*push, b.pos.z+bf.z*bd),
                   l:new THREE.Vector3(b.pos.x, 4.6-1.3*push, b.pos.z) };
    if(b.ledMat){ const v=1-0.85*ss(0.2,1.6,t); b.ledMat.color.setRGB(v, v*0.35, v*0.3); }
    if(b.headerLight) b.headerLight.intensity=(CINE.base?CINE.base.hdr:2.2)*(1-0.8*ss(0.4,2.0,t));
    if(b.rimLight) b.rimLight.intensity=(CINE.base?CINE.base.rim:1.4)*(1-0.7*ss(0.8,2.4,t));
    /* the interior comes up, dim, to show the shelf */
    if(b.interiorLight) b.interiorLight.intensity=(CINE.base?CINE.base.inte:0.9)*(0.25+0.55*ss(1.2,2.6,t));

    if(t>=1.4 && !CINE.shelf){
      try{
        const ci=Math.floor(Math.random()*canCols.length);
        const built=makeCanMesh(canCols[ci], canFlavours[ci]);
        built.group.scale.setScalar(0.92);
        const fwd=new THREE.Vector3(Math.sin(b.heading),0,Math.cos(b.heading));
        /* sit it in FRONT of the shelf plane, so it reads as newly placed
           rather than as one more unit of stock */
        const p0=new THREE.Vector3(b.pos.x,1.30,b.pos.z).add(fwd.clone().multiplyScalar(0.72));
        built.group.position.copy(p0);
        scene.add(built.group);
        CINE.shelf={ mesh:built.group, y:1.30 };
      }catch(e){ CINE.shelf=null; CINE.err='shelf: '+e.message; console.error(CINE.err); }
    }
    if(CINE.shelf){
      /* it settles onto the shelf and stops moving. that is the whole joke. */
      const s0=CINE.shelf, age=t-1.4;
      s0.mesh.position.y=s0.y+0.14*(1-ss(0,0.5,age));
      s0.mesh.rotation.z=0.04*(1-ss(0,0.6,age));
    }
    if(t>3.0&&t<3.05) toast('RESTOCKED', 1800);
    if(t>=LOSE_LEN) endCine();
    return;
  }
}

function skipCine(){
  if(CINE.kind==='intro'){ CINE.t=INTRO_LEN; }
}

/* -------------------------------- boot --------------------------------- */
console.log('%cCHOG TRIALS · BUILD 25.10.25 · cinematics v2 + receipt','color:#DFF902;background:#0B1220;padding:4px 8px;font-weight:700');
document.getElementById('btnStart').addEventListener('click',()=>{
  unlockAudio();
  startFight();
});
/* ------------------------------ pause ---------------------------------
   Escape freezes the fight. Without it the only way out of a run was to win
   or die - which is what made the build feel like a test rather than a game.
   The loop already honours PAUSED (dt=0), so this only has to own the state.
   -------------------------------------------------------------------- */
let paused=false;
function setPaused(v){
  if(G.mode!=='fight' && v) return;
  paused=!!v; PAUSED=paused;
  document.getElementById('scrPause').classList.toggle('on',paused);
  document.getElementById('hud').classList.toggle('on',!paused);
}
document.getElementById('btnResume').addEventListener('click',()=>setPaused(false));
document.getElementById('btnQuit').addEventListener('click',()=>{
  setPaused(false);
  document.getElementById('scrEnd').classList.remove('on');
  document.getElementById('scrStart').classList.add('on');
  /* setPaused(false) turns the HUD back on; on the menu it would sit behind
     the title card, so hide it here */
  document.getElementById('hud').classList.remove('on');
  disposeBoss();
  G.mode='menu'; G.over=false;
  if(boss){ scene.remove(boss.group); boss=null; }
  cans.forEach(removeCan); cans.length=0;
  coins.forEach(c=>scene.remove(c.mesh)); coins.length=0;
  fx.forEach(f=>scene.remove(f.m)); fx.length=0;
});

document.getElementById('btnAgain').addEventListener('click',()=>{
  document.getElementById('scrEnd').classList.remove('on');
  document.getElementById('scrStart').classList.add('on');
  G.mode='menu';
  disposeBoss();
  cans.forEach(removeCan); cans.length=0;
  coins.forEach(c=>scene.remove(c.mesh)); coins.length=0;
  fx.forEach(f=>scene.remove(f.m)); fx.length=0;
});

/* debug hooks for headless verification */
window.__receipt=(w)=>showResults(!!w);
window.__cineAt=(t)=>{ CINE.t=t; };
window.__cine=(k)=>startCine(k);
window.__cineInfo=()=>({kind:CINE.kind,t:+CINE.t.toFixed(2),mode:G.mode,can:!!CINE.payout,shelf:!!CINE.shelf});
window.__receiptCanvas=()=>receiptCanvas(window.__lastReceipt||receiptData(true));
window.__M=()=>({
  mode:G.mode,
  boss: boss ? {
    x:+boss.pos.x.toFixed(2), z:+boss.pos.z.toFixed(2),
    hp:Math.round(boss.hp), phase:boss.phase,
    state:boss.phaseState, action:boss.action,
    speed:+boss.speed.toFixed(2), heading:+boss.heading.toFixed(2),
    roam:boss.roamDest?[+boss.roamDest[0].toFixed(1),+boss.roamDest[1].toFixed(1)]:null,
    roamT:+boss.roamT.toFixed(2)
  } : null,
  player:{ x:+P.pos.x.toFixed(2), y:+P.pos.y.toFixed(2), z:+P.pos.z.toFixed(2),
           hp:Math.round(P.hp), onGround:P.onGround },
  cans:cans.length, coins:coins.length, fx:fx.length, camYaw:+G.camYaw.toFixed(3),
  atk:P.attackT>0, assist:!!G.assistOn, spd:+Math.hypot(P.vx,P.vz).toFixed(2),
  moveMode:ATTACK_MOVE.modes[ATTACK_MOVE.mode].name
});
window.__cans=()=>cans.map(c=>({y:+c.pos.y.toFixed(2), x:+c.pos.x.toFixed(2), z:+c.pos.z.toFixed(2),
  fuse:+c.fuse.toFixed(2), landed:c.landed}));
window.__coins=()=>coins.map(c=>({y:+c.pos.y.toFixed(2), x:+c.pos.x.toFixed(2), z:+c.pos.z.toFixed(2),
  life:+c.life.toFixed(2), kind:c.kind}));
window.__heal=(n)=>{
  P.hp=n||P.max; P.dead=false; P.invuln=0;
  if(G.mode==='end'){
    G.mode='fight'; G.over=false;
    document.getElementById('scrEnd').classList.remove('on');
    document.getElementById('hud').classList.add('on');
  }
  updateHUD();
};
window.__teleportPlayer=(x,z)=>{ P.pos.set(x,0,z); P.vx=0; P.vz=0; P.vy=0; };
window.__god=(v)=>{ GOD=!!v; };
window.__setYaw=(v)=>{ G.camYaw=v; };
window.__cam=(x,y,z,tx,ty,tz)=>{ CAM_OVERRIDE={p:new THREE.Vector3(x,y,z),l:new THREE.Vector3(tx,ty,tz)}; };
window.__camOff=()=>{ CAM_OVERRIDE=null; };
window.__pause=(v)=>{ PAUSED=!!v; };
window.__setBoss=(x,z)=>{ if(boss){ boss.pos.x=x; boss.pos.z=z; boss.roamDest=null; boss.roamT=6; } };
window.__pose=()=>boss?({ t:+G.t.toFixed(2), mode:G.mode, hs:+G.hitstop.toFixed(2),
  hasRock:!!boss.rock, hasDisc:!!boss.tiltDisc,
  rock:+boss.rock.rotation.x.toFixed(3), rockY:+boss.rock.position.y.toFixed(3),
  disc:boss.tiltDisc.visible, op:+boss.tiltDisc.material.opacity.toFixed(3),
  dscale:+boss.tiltDisc.scale.x.toFixed(2),
  action:boss.action, st:boss.phaseState, stT:+boss.stateT.toFixed(2)
}):null;
window.__bossInfo=()=>boss?({
  hp:Math.round(boss.hp), max:boss.max, phase:boss.phase,
  stock:boss.stockCans.filter(c=>c.alive).length,
  glassBroken:boss.glassBroken, crackT:+boss.crackT.toFixed(2),
  crackVisible:boss.crack.visible, glassVisible:boss.glass.visible,
  heat:+boss.heat.toFixed(2), st:boss.phaseState,
  lightbox:boss.lightbox?boss.lightbox.visible:null,
  rockX:+boss.rock.rotation.x.toFixed(2)
}):null;
window.__hitFrom=(x,z,n)=>hurtBoss(n,{fromX:x,fromZ:z});
window.__setHeading=(h)=>{ if(boss) boss.heading=h; };
window.__setHeat=(v)=>{ if(boss) boss.heat=v; };
window.__forceRestock=()=>{ if(boss){ boss.hp=boss.max*0.64; boss.restockQueue=[0.65]; boss.phaseState='idle'; boss.idleT=0.01; } };
window.__setHp=(v)=>{ if(boss){ boss.hp=v; syncStock(); } };
window.__hurtBoss=(n)=>hurtBoss(n);
window.__setPlayerY=(y)=>{ P.pos.y=y; P.vy=0; };
window.__forceAction=(a)=>{
  if(!boss) return;
  boss.action=a; const A=ACT[a];
  boss.windup=A.wind; boss.activeT=A.active; boss.recoverT=A.rec;
  boss.phaseState='windup'; boss.stateT=0;
  boss.wave1=false; boss.wave2=false;
};

resize();

/* Warm the audio graph before the player clicks. The context starts
   suspended - that is fine, decodeAudioData still works - so by the time
   anyone presses ENTER THE BLOCK all 27 samples are resident and no
   early sound is lost to the decode window. */
try{ SFX.init(); }catch(e){}

/* ============================ touch controls ============================
   The pad writes the SAME held flags the keyboard writes - Input.q, Input.h,
   Input.dash, Input.jumpHeld - so the fight itself is untouched. Only the
   source of the input changes, which is what keeps the feel identical.
   ===================================================================== */
const TOUCH={sx:0,sz:0,on:false};
const TOUCH_ON=(function(){
  const has=(navigator.maxTouchPoints>0)||('ontouchstart' in window);
  const coarse=window.matchMedia?window.matchMedia('(pointer:coarse)').matches:false;
  /* only a genuinely phone-sized display qualifies: an iPad reports coarse
     anyway, and a 768px desktop window must NOT get the pad */
  const small=Math.min(screen.width||9999,screen.height||9999)<500;
  return has&&(coarse||small);
})();

function syncOrient(){
  if(!TOUCH_ON) return;
  const portrait=innerHeight>innerWidth;
  document.body.classList.toggle('rotlock',portrait);
  G.rotLocked=portrait;
}
function goFull(){
  if(!TOUCH_ON) return;
  try{
    const el=document.documentElement;
    if(!document.fullscreenElement && el.requestFullscreen) el.requestFullscreen().catch(()=>{});
    if(screen.orientation && screen.orientation.lock) screen.orientation.lock('landscape').catch(()=>{});
  }catch(e){}
}
let _tpVis=null,_tmDim=null;
function touchUI(){
  const vis=(G.mode==='fight' && !paused);
  if(vis!==_tpVis){ _tpVis=vis; document.getElementById('tpause').style.display=vis?'grid':'none'; }
  const dim=!mountReady();
  if(dim!==_tmDim){ _tmDim=dim; document.getElementById('tbMount').classList.toggle('dim',dim); }
}

(function setupTouch(){
  if(!TOUCH_ON) return;
  TOUCH.on=true;
  document.body.classList.add('touch');

  const stick=document.getElementById('tstick'), knob=document.getElementById('tknob');
  let sid=null;
  function stickTo(e){
    const r=stick.getBoundingClientRect();
    const cx=r.left+r.width/2, cy=r.top+r.height/2;
    let dx=e.clientX-cx, dy=e.clientY-cy;
    const max=r.width*0.34, d=Math.hypot(dx,dy);
    if(d>max){ dx=dx/d*max; dy=dy/d*max; }
    knob.style.transform='translate('+dx.toFixed(1)+'px,'+dy.toFixed(1)+'px)';
    TOUCH.sx=dx/max; TOUCH.sz=-dy/max;
  }
  stick.addEventListener('pointerdown',function(e){
    e.preventDefault(); sid=e.pointerId;
    try{ stick.setPointerCapture(e.pointerId); }catch(err){}
    stickTo(e);
  });
  stick.addEventListener('pointermove',function(e){ if(e.pointerId===sid) stickTo(e); });
  function stickEnd(e){
    if(e.pointerId!==sid) return;
    sid=null; TOUCH.sx=0; TOUCH.sz=0; knob.style.transform='';
  }
  stick.addEventListener('pointerup',stickEnd);
  stick.addEventListener('pointercancel',stickEnd);

  function hold(id,down,up){
    const el=document.getElementById(id);
    if(!el) return;
    el.addEventListener('pointerdown',function(e){
      e.preventDefault();
      try{ el.setPointerCapture(e.pointerId); }catch(err){}
      el.classList.add('on'); down();
    });
    function end(){ el.classList.remove('on'); if(up) up(); }
    el.addEventListener('pointerup',end);
    el.addEventListener('pointercancel',end);
  }
  hold('tbHit',  function(){ Input.q=true; },  function(){ Input.q=false; });
  hold('tbHeavy',function(){ Input.h=true; },  function(){ Input.h=false; });
  hold('tbJump', function(){ Input.jumpPressed=true; Input.jumpHeld=true; },
                 function(){ Input.jumpHeld=false; });
  hold('tbDash', function(){ Input.dash=true; }, function(){ Input.dash=false; });
  hold('tbMount',function(){ tryMount(); }, null);

  /* camera: one finger drags the view, and the tap-to-attack is suppressed so a
     small drag never reads as a swing */
  let cid=null, cx=0;
  canvas.addEventListener('touchstart',function(e){ e.preventDefault(); },{passive:false});
  canvas.addEventListener('pointerdown',function(e){
    if(e.pointerType==='mouse') return;
    cid=e.pointerId; cx=e.clientX;
    try{ canvas.setPointerCapture(e.pointerId); }catch(err){}
  });
  canvas.addEventListener('pointermove',function(e){
    if(e.pointerId!==cid) return;
    G.camYaw-=(e.clientX-cx)*0.0055; cx=e.clientX; G.assistHold=1.6;
  });
  function camEnd(e){ if(e.pointerId===cid) cid=null; }
  canvas.addEventListener('pointerup',camEnd);
  canvas.addEventListener('pointercancel',camEnd);

  document.getElementById('tpause').addEventListener('click',function(e){
    e.preventDefault(); setPaused(true);
  });

  syncOrient();
  addEventListener('resize',syncOrient);
  addEventListener('orientationchange',function(){ setTimeout(syncOrient,120); });
  const sb=document.getElementById('btnStart');
  if(sb) sb.addEventListener('click',goFull);
  const rb=document.getElementById('btnResume');
  if(rb) rb.addEventListener('click',goFull);
})();

requestAnimationFrame(loop);
</script>
<script src="acct.js"></script>
<script src="picker.js"></script>
<script src="lb.js"></script>
<script>
(function(){
  window.__acctChipEdit = false;
  function boot(){ if(window.Acct) Acct.ensure(); }
  if(document.readyState==='complete') setTimeout(boot,500); else window.addEventListener('load',function(){ setTimeout(boot,500); });
  function wire(id,fn){ var b=document.getElementById(id); if(b) b.addEventListener('click',fn); }
  wire('btnBoard', function(e){ e.preventDefault(); if(window.LB) LB.open(); });
  wire('btnBoardEnd', function(e){ e.preventDefault(); if(window.LB) LB.open(); });
  /* ---------------------------------------------------------------- runs
     The server owns the clock. It issues a ticket when the run starts and
     refuses any time it could not have taken, so nothing here is trusted. */
  var runTicket = null, runStart = 0, runSent = false;

  /* the game's own toast element, so a refusal reads like part of the game */
  function say(msg) {
    var el = document.getElementById('toast');
    if (!el) return;
    el.textContent = msg;
    el.classList.add('on');
    setTimeout(function () { el.classList.remove('on'); }, 3200);
  }

  function startRun() {
    runTicket = null; runSent = false; runStart = Date.now();
    fetch('/api/run/start', { method: 'POST', credentials: 'same-origin' })
      .then(function (r) { return r.json().then(function (d) { return { s: r.status, d: d }; }); })
      .then(function (o) {
        if (o.d && o.d.ok) { runTicket = o.d.ticket; return; }
        /* no ticket means this run will not count - say so, do not let them
           fight for nothing */
        if (o.d && o.d.reason === 'not_holder') say('No Chog in this wallet — this run will not be recorded');
        else if (o.d && o.d.reason === 'no_player') say('Sign in with a wallet to record this run');
      })
      .catch(function () {});
  }

  function finishRun() {
    if (runSent || !runTicket) return;
    runSent = true;
    var ms = Date.now() - runStart;
    fetch('/api/run/finish', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ticket: runTicket, ms: ms })
    }).then(function (r) { return r.json().then(function (d) { return { s: r.status, d: d }; }); }).then(function (o) {
      var d = o.d;
      if (d && d.ok) {
        var el = document.getElementById('endSub');
        if (el) el.textContent = 'Cleared in ' + window.LB.fmt(ms) + ' — you are #' + d.rank + ' on the board.';
      } else if (d && d.reason === 'no_longer_holder') {
        say('That Chog left this wallet during the run — time not recorded');
      }
    }).catch(function () {});
  }

  var startBtn = document.getElementById('btnStart');
  if (startBtn) startBtn.addEventListener('click', startRun);

  setInterval(function () {
    var scr = document.getElementById('scrEnd');
    if (!scr || !scr.classList.contains('on')) return;
    var kicker = (document.getElementById('endKicker') || {}).textContent || '';
    if (kicker.indexOf('CLEARED') !== -1) finishRun();
  }, 500);

  /* the chip belongs to the menus, not the fight */
  (function(){
    var last = null;
    setInterval(function(){
      var c = document.getElementById('acChip');
      if (!c) return;
      var onMenu = !!document.querySelector('.screen.on');
      if (onMenu === last) return;
      last = onMenu;
      c.style.opacity = onMenu ? '1' : '0';
      c.style.pointerEvents = onMenu ? 'auto' : 'none';
      c.style.transform = onMenu ? 'translateY(0)' : 'translateY(-6px)';
    }, 150);
  })();
})();
</script>
</body>
</html>
